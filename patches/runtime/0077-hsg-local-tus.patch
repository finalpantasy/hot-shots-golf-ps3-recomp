  * -----------------------------------------------------------------------*/
 
 
+/* ==== HSG local TUS (Hot Shots Golf JP 1.27 capsule machine, patch 0077) ====
+ * Off until the port calls hsg_tus_local_enable() (port/hsg_jp127_capsule.cpp, grind
+ * preset). Then async TUS is answered from an in-memory table so the game's own TUS code
+ * (the capsule machine) completes offline: transaction contexts always succeed, Get/Set/
+ * TryAndSet work on the table at once (PollAsync reports done). The port seeds the table
+ * from its store with hsg_tus_local_poke() and reads it back after writes (hsg_tus_local_
+ * peek(), hsg_tus_local_writes() counts every write). The table is not saved here.
+ * HSG_TUS_LOCAL_LOG=1 logs every slot access. SceNpTusVariable (120 bytes): ownerId SceNpId
+ * @0 (36), hasData s32 @0x24, lastChangedDate @0x28, lastChangedAuthorId @0x34, variable
+ * s64 @0x58, oldVariable s64 @0x60. */
+#define HSG_TUSL_SLOTS 1024
+static int s_tusl_on;
+static unsigned s_tusl_writes;
+static struct { int valid; s64 value; u64 stamp; } s_tusl[HSG_TUSL_SLOTS];
+static u64 s_tusl_clock = 1;
+int hsg_tus_local_on(void) { return s_tusl_on; }
+void hsg_tus_local_enable(void) { s_tusl_on = 1; }
+unsigned hsg_tus_local_writes(void) { return s_tusl_writes; }
+void hsg_tus_local_poke(int slot, long long value)
+{
+    if (slot < 0 || slot >= HSG_TUSL_SLOTS) return;
+    s_tusl[slot].valid = 1; s_tusl[slot].value = (s64)value; s_tusl[slot].stamp = s_tusl_clock++;
+}
+int hsg_tus_local_peek(int slot, long long* value)
+{
+    if (slot < 0 || slot >= HSG_TUSL_SLOTS || !s_tusl[slot].valid) return 0;
+    if (value) *value = (long long)s_tusl[slot].value;
+    return 1;
+}
+static int hsg_tusl_log(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("HSG_TUS_LOCAL_LOG"); on = (e && *e && *e != '0') ? 1 : 0; }
+    return on;
+}
+static void hsg_tusl_write(u32 ea, s32 slot, s64 oldv)
+{
+    for (u32 i = 0; i < TUS_VARIABLE_SIZE; i++) vm_write8(ea + i, 0);
+    const char* who = "PS3Player";
+    for (u32 i = 0; who[i]; i++) { vm_write8(ea + i, (u8)who[i]); vm_write8(ea + 0x34 + i, (u8)who[i]); }
+    const int ok = slot >= 0 && slot < HSG_TUSL_SLOTS && s_tusl[slot].valid;
+    vm_write32(ea + 0x24, ok ? 1u : 0u);
+    vm_write64(ea + 0x28, ok ? s_tusl[slot].stamp : 0);
+    vm_write64(ea + 0x58, ok ? (u64)s_tusl[slot].value : 0);
+    vm_write64(ea + 0x60, (u64)oldv);
+}
+static s32 hsg_tusl_set_multi(const u32* slotIds, const s64* variables, s32 count)
+{
+    for (s32 i = 0; i < count; i++) {
+        const s32 sl = (s32)vm_read32(GUEST_EA(slotIds) + (u32)i * 4);
+        const s64 v = (s64)vm_read64(GUEST_EA(variables) + (u32)i * 8);
+        if (hsg_tusl_log()) printf("[tus-local] set slot %d = %lld (0x%llx)\n", sl, (long long)v, (unsigned long long)v);
+        if (sl >= 0 && sl < HSG_TUSL_SLOTS) { s_tusl[sl].valid = 1; s_tusl[sl].value = v; s_tusl[sl].stamp = s_tusl_clock++; }
+    }
+    s_tusl_writes++;
+    return CELL_OK;
+}
+static s32 hsg_tusl_get_multi(const u32* slotIds, void* variables, s32 count)
+{
+    for (s32 i = 0; i < count; i++) {
+        const s32 sl = (s32)vm_read32(GUEST_EA(slotIds) + (u32)i * 4);
+        hsg_tusl_write(GUEST_EA(variables) + (u32)i * TUS_VARIABLE_SIZE, sl, 0);
+        if (hsg_tusl_log())
+            printf("[tus-local] get slot %d -> %s %lld\n", sl,
+                   (sl >= 0 && sl < HSG_TUSL_SLOTS && s_tusl[sl].valid) ? "has" : "none",
+                   (sl >= 0 && sl < HSG_TUSL_SLOTS) ? (long long)s_tusl[sl].value : 0LL);
+    }
+    return CELL_OK;
+}
+static s32 hsg_tusl_try_set(s32 slotId, s32 op, s64 value, void* variable)
+{
+    /* opeType 0 = overwrite here; others compare value against the current one
+     * (1 eq, 2 ne, 3 gt, 4 ge, 5 lt, 6 le: set when current <op> value holds). */
+    const int have = slotId >= 0 && slotId < HSG_TUSL_SLOTS && s_tusl[slotId].valid;
+    const s64 cur = have ? s_tusl[slotId].value : 0;
+    int doit = 1;
+    switch (op) { case 1: doit = cur == value; break; case 2: doit = cur != value; break;
+                  case 3: doit = cur > value; break; case 4: doit = cur >= value; break;
+                  case 5: doit = cur < value; break; case 6: doit = cur <= value; break; default: break; }
+    if (hsg_tusl_log())
+        printf("[tus-local] try-set slot %d op %d value %lld (cur %lld %s) -> %s\n", slotId, op,
+               (long long)value, (long long)cur, have ? "has" : "none", doit ? "set" : "kept");
+    if (doit && slotId >= 0 && slotId < HSG_TUSL_SLOTS) {
+        s_tusl[slotId].valid = 1; s_tusl[slotId].value = value; s_tusl[slotId].stamp = s_tusl_clock++;
+        s_tusl_writes++;
+    }
+    hsg_tusl_write(GUEST_EA(variable), slotId, cur);
+    return CELL_OK;
+}
+/* ==== END HSG local TUS block ==== */
 
