+/* Guest shader bytecode cache, keyed on the final HLSL text and target.
+ * D3DCompile runs on the FIFO walker's thread, so every compile stalls the
+ * guest: a scene change compiled for seconds (the drain thread sampled 70-90%
+ * inside D3DCOMPILER_47 for 10 s windows, the guest frozen behind it). Two
+ * levels:
+ *  - in memory: the pipeline cache is keyed on blend/cull/target format/VS as
+ *    well as the program, so one fragment program used under three blend modes
+ *    was decompiled and compiled three times for byte-identical HLSL;
+ *  - on disk (RSX_SHADER_CACHE=<dir>, default shader_cache_d3d12 next to the
+ *    exe; RSX_SHADER_CACHE=0 turns it off): a second run of the same scene
+ *    loads the bytecode instead of recompiling it.
+ * The key covers the whole HLSL text (two independent 64-bit hashes plus its
+ * length), so a decompiler change simply produces new keys. */
+#define RSX_SBC_MAX 2048
+typedef struct { u64 h1, h2; u32 len; ID3DBlob* blob; } RsxShaderBlob;
+static RsxShaderBlob s_sbc[RSX_SBC_MAX];
+static int s_sbc_n = 0;
+static const char* rsx_sbc_dir(void)
+{
+    static int init = 0; static char dir[MAX_PATH];
+    if (!init) {
+        init = 1;
+        const char* e = getenv("RSX_SHADER_CACHE");
+        if (e && e[0] == '0' && !e[1]) dir[0] = 0;
+        else if (e && *e) snprintf(dir, sizeof dir, "%s", e);
+        else {
+            char exe[MAX_PATH]; DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+            char* sl = (n && n < MAX_PATH) ? strrchr(exe, '\\') : NULL;
+            if (sl) { *sl = 0; snprintf(dir, sizeof dir, "%s\\shader_cache_d3d12", exe); }
+        }
+        if (dir[0]) CreateDirectoryA(dir, NULL);
+    }
+    return dir[0] ? dir : NULL;
+}
+static HRESULT rsx_compile_cached(const char* src, size_t len, const char* name,
+                                  const char* target, ID3DBlob** out)
+{
+    *out = NULL;
+    u64 h1 = 14695981039346656037ull, h2 = 0x9E3779B97F4A7C15ull;
+    for (size_t i = 0; i < len; i++) {
+        h1 = (h1 ^ (u8)src[i]) * 1099511628211ull;
+        h2 = (h2 + (u8)src[i]) * 0xFF51AFD7ED558CCDull; h2 ^= h2 >> 29;
+    }
+    for (const char* t = target; *t; t++) { h1 = (h1 ^ (u8)*t) * 1099511628211ull; h2 ^= (u8)*t; h2 *= 0xC4CEB9FE1A85EC53ull; }
+    for (int i = 0; i < s_sbc_n; i++)
+        if (s_sbc[i].h1 == h1 && s_sbc[i].h2 == h2 && s_sbc[i].len == (u32)len) {
+            s_sbc[i].blob->lpVtbl->AddRef(s_sbc[i].blob);
+            *out = s_sbc[i].blob; s_prof_nmemhit++;
+            return S_OK;
+        }
+    ID3DBlob* blob = NULL;
+    const char* dir = rsx_sbc_dir();
+    char path[MAX_PATH + 64]; path[0] = 0;
+    if (dir) {
+        snprintf(path, sizeof path, "%s\\%016llx%016llx_%u_%s.dxbc", dir,
+                 (unsigned long long)h1, (unsigned long long)h2, (unsigned)len, target);
+        FILE* f = fopen(path, "rb");
+        if (f) {
+            fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
+            /* A DXBC container starts "DXBC" and carries its own size at +24. */
+            if (sz > 32 && sz < (16 << 20) && SUCCEEDED(D3DCreateBlob((SIZE_T)sz, &blob))) {
+                u8* p = (u8*)blob->lpVtbl->GetBufferPointer(blob);
+                u32 csz = 0;
+                if (fread(p, 1, (size_t)sz, f) != (size_t)sz || memcmp(p, "DXBC", 4) != 0 ||
+                    (memcpy(&csz, p + 24, 4), csz != (u32)sz)) {
+                    blob->lpVtbl->Release(blob); blob = NULL;
+                } else s_prof_ndiskhit++;
+            }
+            fclose(f);
+        }
+    }
+    if (!blob) {
+        double t0 = perf_now();
+        ID3DBlob* err = NULL;
+        HRESULT hr = D3DCompile(src, len, name, NULL, NULL, "main", target, 0, 0, &blob, &err);
+        s_prof_compile += perf_now() - t0; s_prof_ncompile++;
+        if (FAILED(hr) || !blob) {
+            static int _e = 0; if (PS3_LOG_FIRST(_e, 16))
+                printf("[D3D12] %s compile FAIL: %s\n", name,
+                       err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+            if (err) err->lpVtbl->Release(err);
+            if (blob) blob->lpVtbl->Release(blob);
+            return FAILED(hr) ? hr : E_FAIL;
+        }
+        if (err) err->lpVtbl->Release(err);
+        if (path[0]) {
+            char tmp[MAX_PATH + 80];
+            snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+            FILE* f = fopen(tmp, "wb");
+            if (f) {
+                size_t bs = blob->lpVtbl->GetBufferSize(blob);
+                int ok = fwrite(blob->lpVtbl->GetBufferPointer(blob), 1, bs, f) == bs;
+                ok = (fclose(f) == 0) && ok;
+                if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+            }
+        }
+    }
+    if (s_sbc_n < RSX_SBC_MAX) {
+        blob->lpVtbl->AddRef(blob);
+        s_sbc[s_sbc_n].h1 = h1; s_sbc[s_sbc_n].h2 = h2; s_sbc[s_sbc_n].len = (u32)len;
+        s_sbc[s_sbc_n].blob = blob; s_sbc_n++;
+    }
+    *out = blob;
+    return S_OK;
+}
