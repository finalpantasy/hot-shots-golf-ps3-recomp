+/* Per-draw fetch plan (rsx_vertex_fetch.h). Same rules as rsx_fetch_attrib,
+ * per attribute: a disabled (or RSX_STRIDE0_CONST stride-0) array is its
+ * constant register, copied from the template; an enabled one is decoded by
+ * fetch_decode from the element rsx_fetch_attrib would pick. */
+static int stride0_const_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("RSX_STRIDE0_CONST") ? 1 : 0;
+    return v;
+}
+static int nofreq_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("VP_NOFREQ") ? 1 : 0;
+    return v;
+}
+void rsx_fetch_plan_build(const rsx_state* st, rsx_fetch_plan* pl)
+{
+    pl->n = 0;
+    for (int i = 0; i < 16; i++) {
+        pl->tmpl[i][0] = st->vertex_data4f[i][0];
+        pl->tmpl[i][1] = st->vertex_data4f[i][1];
+        pl->tmpl[i][2] = st->vertex_data4f[i][2];
+        pl->tmpl[i][3] = st->vertex_data4f[i][3];
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || !vm_base || (a->stride == 0 && stride0_const_on())) continue;
+        rsx_fetch_plan_attr* e = &pl->a[pl->n++];
+        e->idx = i;
+        e->attr = *a;
+        e->mode = 0;
+        if (!rsx_vertex_freq_plain(a->frequency, (st->frequency_divider_op >> i) & 1u) &&
+            !nofreq_on())
+            e->mode = (st->frequency_divider_op & (1u << i)) ? 1 : 2;
+        e->main = (a->offset & 0x80000000u) ? 1 : 0;
+        e->base = a->offset & 0x7FFFFFFFu;
+        e->local0 = e->main ? 0u : cellGcmResolveLocated(1, 0);
+    }
+}
+void rsx_fetch_vertex16(const rsx_fetch_plan* pl, u32 vi, float out[16][4])
+{
+    memcpy(out, pl->tmpl, sizeof pl->tmpl);
+    for (int j = 0; j < pl->n; j++) {
+        const rsx_fetch_plan_attr* e = &pl->a[j];
+        const u32 ei = e->mode == 0 ? vi
+                     : e->mode == 1 ? (vi % e->attr.frequency) : (vi / e->attr.frequency);
