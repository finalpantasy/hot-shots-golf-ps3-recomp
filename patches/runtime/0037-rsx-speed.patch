+        /* LOCAL is localAddress + offset (cellGcmResolveLocated(1, x)), the same
+         * u32 sum; MAIN goes through the IO table per element. */
+        const u8* p = vm_base + (e->main ? cellGcmResolveLocated(0, off) : (u32)(e->local0 + off));
+        fetch_decode(&e->attr, e->idx, p, out[e->idx]);
+    }
+}
