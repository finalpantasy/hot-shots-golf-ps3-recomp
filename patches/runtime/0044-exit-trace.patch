+static void ps3_xt_write(const char* s, DWORD n)
+{
+    DWORD w;
+    HANDLE h = GetStdHandle(STD_ERROR_HANDLE);
+    if (h && h != INVALID_HANDLE_VALUE) WriteFile(h, s, n, &w, NULL);
+    if (s_xt_file != INVALID_HANDLE_VALUE) WriteFile(s_xt_file, s, n, &w, NULL);
+}
+
+void ps3_exit_trace(const char* fmt, ...)
+{
+    if (!ps3_exit_trace_enabled()) return;
+    char line[1400];
+    SYSTEMTIME st;
+    GetLocalTime(&st);
+    char tn[48] = "";
+    {
+        typedef HRESULT (WINAPI *get_desc_fn)(HANDLE, PWSTR*);
+        static get_desc_fn get_desc;
+        static int looked_up;
+        if (!looked_up) {
+            get_desc = (get_desc_fn)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"),
+                                                          "GetThreadDescription");
+            looked_up = 1;
+        }
+        PWSTR w = NULL;
+        if (get_desc && SUCCEEDED(get_desc(GetCurrentThread(), &w)) && w) {
+            int i = 0;
+            for (; w[i] && i < (int)sizeof tn - 1; i++) tn[i] = (w[i] < 128) ? (char)w[i] : '?';
+            tn[i] = 0;
+            LocalFree(w);
+        }
+    }
+    int p = snprintf(line, sizeof line, "\n[exit-trace] %02u:%02u:%02u.%03u +%llums tid=%lu(%s) ",
+                     st.wHour, st.wMinute, st.wSecond, st.wMilliseconds,
+                     (unsigned long long)(GetTickCount64() - s_xt_t0),
+                     (unsigned long)GetCurrentThreadId(), tn[0] ? tn : "-");
+    if (p < 0) return;
+    va_list ap;
+    va_start(ap, fmt);
+    int q = vsnprintf(line + p, sizeof line - (size_t)p - 2, fmt, ap);
+    va_end(ap);
+    if (q < 0) q = 0;
+    p += q;
+    if (p > (int)sizeof line - 2) p = (int)sizeof line - 2;
+    line[p++] = '\n';
+    ps3_xt_write(line, (DWORD)p);
+}
