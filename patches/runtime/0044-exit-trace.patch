+static void ps3_exit_trace_init(void)
+{
+    s_xt_t0 = GetTickCount64();
+    if (!ps3_exit_trace_enabled()) return;
+    const char* f = getenv("RT_EXIT_TRACE_FILE");
+    if (f && *f)
