+/* Host return addresses as RVAs of the exe (resolve with the map or llvm-symbolizer). */
+static void ps3_exit_trace_bt(const char* tag)
+{
+    if (!ps3_exit_trace_enabled()) return;
+    void* bt[24];
+    USHORT n = RtlCaptureStackBackTrace(1, 24, bt, NULL);
+    uintptr_t mb = (uintptr_t)GetModuleHandleA(NULL);
+    char b[24 * 20 + 16];
+    int p = 0;
+    for (USHORT i = 0; i < n && p < (int)sizeof b - 20; i++) {
+        uintptr_t a = (uintptr_t)bt[i];
+        if (a >= mb && a - mb < 0x40000000u)
+            p += snprintf(b + p, sizeof b - (size_t)p, " %llX", (unsigned long long)(a - mb));
+        else
+            p += snprintf(b + p, sizeof b - (size_t)p, " x%llX", (unsigned long long)a);
+    }
+    b[p] = 0;
+    ps3_exit_trace("%s host-bt rva:%s", tag, b);
+}
+
+static void ps3_exit_trace_atexit(void)
+{
+    ps3_exit_trace("exit() called: atexit handlers running");
+    ps3_exit_trace_bt("exit()");
+}
+
+static LONG WINAPI ps3_exit_trace_veh(EXCEPTION_POINTERS* ep)
+{
+    DWORD code = ep->ExceptionRecord->ExceptionCode;
+    /* Only error-severity codes nothing ahead of this handler resolved; C++
+     * throws (0xE06D7363) are normal control flow and skipped. A later frame
+     * handler may still catch it, so this is "seen", not "fatal". */
+    if ((code & 0xC0000000u) == 0xC0000000u && code != 0xE06D7363u &&
+        __atomic_add_fetch(&s_xt_veh_lines, 1, __ATOMIC_ACQ_REL) <= 16) {
+        uintptr_t mb = (uintptr_t)GetModuleHandleA(NULL);
+        uintptr_t a = (uintptr_t)ep->ExceptionRecord->ExceptionAddress;
+        ULONG_PTR i0 = ep->ExceptionRecord->NumberParameters > 0 ? ep->ExceptionRecord->ExceptionInformation[0] : 0;
+        ULONG_PTR i1 = ep->ExceptionRecord->NumberParameters > 1 ? ep->ExceptionRecord->ExceptionInformation[1] : 0;
+        ps3_exit_trace("unresolved exception code=0x%08lX addr=0x%llX (rva 0x%llX) info=%llX,%llX",
+                       (unsigned long)code, (unsigned long long)a, (unsigned long long)(a - mb),
+                       (unsigned long long)i0, (unsigned long long)i1);
+        ps3_exit_trace_bt("exception");
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+/* ExitProcess (and so exit, _exit, abort's _exit, quick_exit) runs the exe's
+ * TLS callbacks with DLL_PROCESS_DETACH. TerminateProcess and __fastfail do not. */
+static void NTAPI ps3_exit_trace_tls(PVOID h, DWORD reason, PVOID reserved)
+{
+    (void)h; (void)reserved;
+    if (reason != DLL_PROCESS_DETACH || s_xt_on != 1) return;
+    DWORD code = 0;
+    GetExitCodeProcess(GetCurrentProcess(), &code);
+    ps3_exit_trace("process detach (ExitProcess path) exit code=%lu (0x%lX)",
+                   (unsigned long)code, (unsigned long)code);
+}
+#if defined(__GNUC__) || defined(__clang__)
+extern const IMAGE_TLS_DIRECTORY _tls_used;          /* the CRT's TLS directory: keep it linked */
+__attribute__((used)) static const void* s_xt_tls_ref = &_tls_used;
+__attribute__((used, section(".CRT$XLY"))) PIMAGE_TLS_CALLBACK ps3_exit_trace_tls_cb = ps3_exit_trace_tls;
+#elif defined(_MSC_VER)
+#pragma comment(linker, "/INCLUDE:_tls_used")
+#pragma comment(linker, "/INCLUDE:ps3_exit_trace_tls_cb")
+#pragma section(".CRT$XLY", long, read)
+__declspec(allocate(".CRT$XLY")) const PIMAGE_TLS_CALLBACK ps3_exit_trace_tls_cb = ps3_exit_trace_tls;
+#endif
