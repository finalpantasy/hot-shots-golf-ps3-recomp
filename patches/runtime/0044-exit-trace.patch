+    atexit(ps3_exit_trace_atexit);
+    AddVectoredExceptionHandler(0, ps3_exit_trace_veh);   /* last: after every resolver */
+    ps3_exit_trace("on (pid %lu); RT_EXIT_TRACE=0 turns it off", (unsigned long)GetCurrentProcessId());
+}
+#else
+void ps3_exit_trace(const char* fmt, ...) { (void)fmt; }
+static void ps3_exit_trace_bt(const char* tag) { (void)tag; }
+static void ps3_exit_trace_init(void) {}
+#endif
