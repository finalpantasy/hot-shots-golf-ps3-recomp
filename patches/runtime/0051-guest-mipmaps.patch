+static int trp_fit_levels(TrpImage* im, u32 gw, u32 gh, u32 glevels)
+{
+    static int mode = -1;
+    if (mode < 0) { const char* e = getenv("TEX_REPLACE_MIPS"); mode = e ? atoi(e) : 1; }
+    u32 full = 1; for (u32 a = im->w > im->h ? im->w : im->h; a > 1; a >>= 1) full++;
