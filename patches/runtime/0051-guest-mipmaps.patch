+            free(im->lv[l]); im->lv[l] = NULL;
+        }
+        im->nlv = want;
+    } else if (im->nlv == 1 && want > 1 && !im->blk) {
+        if (!trp_mips_rgba(im, want, mode != 2)) return 0;
+    }
