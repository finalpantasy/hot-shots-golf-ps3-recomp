diff --git a/libs/system/hsg_program.c b/libs/system/hsg_program.c
new file mode 100644
index 0000000..848e779
--- /dev/null
+++ b/libs/system/hsg_program.c
@@ -0,0 +1,37 @@
+/*
+ * ps3recomp - which Hot Shots Golf program is loaded
+ *
+ * The HSG runtime patches (hsg_fps.c, hsg_widecull.c, hsg_tweaks.c,
+ * hsg_dlc_earn.c) hold game addresses and file names of the US 1.03 EBOOT
+ * (NPUA80864). The same runtime also runs the JP 1.27 EBOOT (Minna no Golf 6,
+ * BCJS30089), where those addresses are other code and data. ppu_load_elf
+ * hands the ELF file to hsg_program_identify() before any guest code runs; it
+ * is recognised by the FNV-1a-64 of the whole file. On the JP program each
+ * US-address patch stands down (hsg_program_is_jp127() != 0). Any other file,
+ * the US 1.03 and fixed 1.02 EBOOTs included, leaves everything as it was.
+ */
+#include <stdio.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define HSG_JP127_SIZE  14406392u
+#define HSG_JP127_FNV   0xA5E6D63E17879474ull   /* SHA-256 d981eb70...bcab5960 */
+
+static int s_jp127;
+
+void hsg_program_identify(const uint8_t* elf, size_t size)
+{
+    s_jp127 = 0;
+    if (!elf || size != HSG_JP127_SIZE) return;
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < size; i++) h = (h ^ elf[i]) * 1099511628211ull;
+    if (h == HSG_JP127_FNV) {
+        s_jp127 = 1;
+        fprintf(stderr, "[hsg] program: JP 1.27 (BCJS30089); US 1.03 address patches off\n");
+    }
+}
+
+int hsg_program_is_jp127(void)
+{
+    return s_jp127;
+}
