+/* TEX_REPLACE_RAM_MB=<n> (default 768, 0 off): decoded replacements (after
+ * trp_fit_levels) are kept in memory, least recently used dropped first, so a
+ * texture the guest uploads again (every camera cut re-uploads 40-70 of them)
+ * is copied to the GPU without reading and parsing the file again. */
+typedef struct { TrpEntry* e; u32 w, h, gl; u64 last; TrpImage im; } TrpRam;
+static TrpRam* s_trpram; static u32 s_trpram_n, s_trpram_cap; static u64 s_trpram_bytes, s_trpram_tick;
+static u32 s_trpram_hit, s_trpram_miss;
+static u64 trp_ram_budget(void)
+{
+    static long long v = -1;
+    if (v < 0) { const char* e = getenv("TEX_REPLACE_RAM_MB"); v = e ? atoll(e) : 768; if (v < 0) v = 0; }
+    return (u64)v << 20;
+}
+static TrpRam* trp_ram_find(TrpEntry* e, u32 w, u32 h, u32 gl)
+{
+    for (u32 i = 0; i < s_trpram_n; i++)
+        if (s_trpram[i].e == e && s_trpram[i].w == w && s_trpram[i].h == h && s_trpram[i].gl == gl) {
+            s_trpram[i].last = ++s_trpram_tick; return &s_trpram[i];
+        }
+    return NULL;
+}
+/* Takes ownership of *im when it returns 1. */
+static int trp_ram_put(TrpEntry* e, u32 w, u32 h, u32 gl, const TrpImage* im)
+{
+    const u64 cap = trp_ram_budget();
+    if (!cap || im->bytes > cap / 4) return 0;
+    while (s_trpram_n && s_trpram_bytes + im->bytes > cap) {
+        u32 o = 0;
+        for (u32 i = 1; i < s_trpram_n; i++) if (s_trpram[i].last < s_trpram[o].last) o = i;
+        s_trpram_bytes -= s_trpram[o].im.bytes; trp_img_free(&s_trpram[o].im);
+        s_trpram[o] = s_trpram[--s_trpram_n];
+    }
+    if (s_trpram_n == s_trpram_cap) {
+        u32 nc = s_trpram_cap ? s_trpram_cap * 2 : 256;
+        TrpRam* n = (TrpRam*)realloc(s_trpram, sizeof(TrpRam) * nc);
+        if (!n) return 0;
+        s_trpram = n; s_trpram_cap = nc;
+    }
+    TrpRam* r = &s_trpram[s_trpram_n++];
+    r->e = e; r->w = w; r->h = h; r->gl = gl; r->last = ++s_trpram_tick; r->im = *im;
+    s_trpram_bytes += im->bytes;
+    return 1;
+}
