+ * compiled with D3DCOMPILE_SKIP_OPTIMIZATION and that bytecode is what the disk
+ * cache keeps. fxc spent 1-2.3 s on each branching guest vertex program at the
+ * default level (0.9 s without optimization), all of it on the FIFO walker
+ * thread: a course load froze for 10-30 s on a cold cache. The driver optimizes
+ * the DXBC again when it builds the pipeline. Compiling the optimized version
+ * in the background instead was tried: the next run then fed the driver new
+ * bytecode and paid 100-600 ms per pipeline a second time. */
+static int rsx_shader_fast(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_SHADER_FAST"); v = e ? atoi(e) : 1; }
+    return v;
