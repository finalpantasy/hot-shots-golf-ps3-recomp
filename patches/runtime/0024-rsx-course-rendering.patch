+/* Texture alpha kill (TEXTURE_CONTROL0 bit 2): the RSX drops the fragment when
+ * a fetch from that unit returns alpha 0 (RPCS3 RSXFragmentTextureOps.glsl
+ * _process_texel: ALPHAKILL, rgba.a < 0.000001 -> _kill()). Cut-out foliage
+ * relies on it with DXT1's 1-bit alpha. Every fetch from units 0-3 is wrapped
+ * in _rsx_akill(unit, sample); the per-draw flag is rsx_texscale[unit].z, so
+ * the pipeline key does not change. NO_ALPHAKILL=1 zeroes the flag. */
+static int fp_apply_alpha_kill(char* hlsl, size_t cap)
+{
+    char* at_main = strstr(hlsl, " main(PSInput input)");
+    if (!at_main) return -1;
+    int wrapped = 0;
+    for (u32 u = 0; u < 4; u++) {
+        char needle[2][24];
+        snprintf(needle[0], sizeof needle[0], "rsx_tex[%u].Sample", u);
+        snprintf(needle[1], sizeof needle[1], "rsx_tex%u.Sample", u);
+        for (int v = 0; v < 2; v++) {
+            char* p = strstr(at_main, needle[v]);
+            while (p) {
+                char* open = strchr(p + strlen(needle[v]), '(');
+                if (!open) return -1;
+                int depth = 0; char* q = open;
+                for (; *q; q++) {
+                    if (*q == '(') depth++;
+                    else if (*q == ')' && --depth == 0) break;
+                }
+                if (!*q) return -1;
+                char pre[24];
+                const int pn = snprintf(pre, sizeof pre, "_rsx_akill(%uu, ", u);
+                const size_t len = strlen(hlsl);
+                if (len + (size_t)pn + 2 > cap) return -1;
+                /* Close after the call, then open before it. */
+                memmove(q + 2, q + 1, strlen(q + 1) + 1);
+                q[1] = ')';
+                memmove(p + pn, p, strlen(p) + 1);
+                memcpy(p, pre, (size_t)pn);
+                wrapped++;
+                p = strstr(q + 2 + pn, needle[v]);
+            }
+        }
+    }
+    if (!wrapped) return 0;
+    /* The helper goes in front of main's line (after the cbuffer it reads). */
+    char* line = at_main;
+    while (line > hlsl && line[-1] != '\n') line--;
+    static const char helper[] =
+        "float4 _rsx_akill(uint u, float4 v) {\n"
+        "    if (rsx_texscale[u].z != 0.0 && v.a < 0.000001) discard;\n"
+        "    return v;\n}\n";
+    const size_t hn = sizeof helper - 1, len = strlen(hlsl);
+    if (len + hn + 1 > cap) return -1;
+    memmove(line + hn, line, strlen(line) + 1);
+    memcpy(line, helper, hn);
+    return wrapped;
+}
