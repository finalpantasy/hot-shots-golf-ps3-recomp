+/* Debug: make colour 0 of a program `expr` (after its alpha test, so only
+ * fragments that survive are painted). For FP_SHOW / FP_IDCOLOR, whose old
+ * "_po.c0 = " anchor the current decompiler no longer emits. */
+static int fp_override_output(char* hlsl, size_t cap, const char* expr)
+{
+    char* marker = NULL;
+    for (char* p = strstr(hlsl, "    return "); p; p = strstr(p + 1, "    return "))
+        marker = p;
+    if (!marker) return -1;
+    const char* var = strstr(hlsl, "PSOutput _rsx_out") ? "_rsx_out.t0"
+                    : strstr(hlsl, "float4 _rsx_out") ? "_rsx_out"
+                    : strstr(hlsl, "PSOutput _out;") ? "_out.t0" : NULL;
+    if (!var) return -1;
+    char ins[320];
+    const int n = snprintf(ins, sizeof ins, "    %s = %s;\n", var, expr);
+    if (n <= 0 || (size_t)n >= sizeof ins || strlen(hlsl) + (size_t)n + 1 > cap) return -1;
+    memmove(marker + n, marker, strlen(marker) + 1);
+    memcpy(marker, ins, (size_t)n);
+    return 1;
+}
