+    if (prim == RSX_PRIMITIVE_QUAD_STRIP) {
+        u32 q0 = prev_end >= s + 4 ? (prev_end - s - 2) / 2 : 0;
+        u32 q1 = end >= s + 4 ? (end - s - 2) / 2 : 0;
+        for (u32 q = q0; q < q1 && o + 6 <= maxv; q++) {
+            u32 b = s + q * 2;
+            VPSlot v0[16], v1[16], v2[16], v3[16];
+            read_vp_vertex(state, SJ_IDX(b + 0), v0);
+            read_vp_vertex(state, SJ_IDX(b + 1), v1);
+            read_vp_vertex(state, SJ_IDX(b + 2), v2);
+            read_vp_vertex(state, SJ_IDX(b + 3), v3);
+            memcpy(&out[(o + 0)*16], v0, sizeof(v0));
+            memcpy(&out[(o + 1)*16], v1, sizeof(v1));
+            memcpy(&out[(o + 2)*16], v3, sizeof(v3));
+            memcpy(&out[(o + 3)*16], v0, sizeof(v0));
