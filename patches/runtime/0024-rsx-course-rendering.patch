+/* b1 per-draw slot layout (vp_record_cb): rsx_texscale[4], rsx_alphatest,
+ * then the program's inline constants. FP_K_SLOTS is what fits the stride. */
+#define FP_K_SLOTS ((int)(VP_FPCB_STRIDE / 16) - 5)
+
+static int fp_constbuf_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("FP_CONSTBUF"); on = (e && e[0] == '0') ? 0 : 1; }
+    return on;
+}
+
+/* Does the program's constant count fit fp_k[]? */
+static int fp_buffered_ok(const u8* ucode)
+{
+    float tmp[(FP_K_SLOTS + 1) * 4];
+    return rsx_fp_extract_consts(ucode, 4096, tmp, FP_K_SLOTS + 1) <= FP_K_SLOTS;
+}
+
+/* The buffered decompiler declares b1 as { fp_constants[n]; fp_alpha; }.
+ * This backend's b1 slot is { rsx_texscale[4]; rsx_alphatest; fp_k[] }, so
+ * rewrite the declaration to that layout. fp_alpha (the WPOS origin/centre
+ * terms) is not supplied here and stays zero, which is the host position the
+ * literal path always used. */
+static int fp_rebind_b1(char* hlsl, size_t cap, u32 nk)
+{
+    static const char head[] = "cbuffer PSConstants : register(b1) {\n";
+    char* a = strstr(hlsl, head);
+    if (!a) return -1;
+    char* b = strstr(a, "};\n");
+    if (!b) return -1;
+    b += 3;
+    char decl[256];
+    const int dn = snprintf(decl, sizeof decl,
+        "cbuffer PSConstants : register(b1) {\n"
+        "    float4 rsx_texscale[4];\n"
+        "    float4 rsx_alphatest;\n"
+        "    float4 fp_constants[%u];\n"
+        "};\n"
+        "static const float4 fp_alpha = float4(0, 0, 0, 0);\n", nk ? nk : 1u);
+    if (dn <= 0 || (size_t)dn >= sizeof decl) return -1;
+    const size_t len = strlen(hlsl), old = (size_t)(b - a);
+    if (len - old + (size_t)dn + 1 > cap) return -1;
+    memmove(a + dn, b, strlen(b) + 1);
+    memcpy(a, decl, (size_t)dn);
+    return 1;
+}
+
+/* Append the RSX alpha test to a program: colour 0's alpha against
+ * rsx_alphatest (x enable, y ref, z CELL_GCM func - 0x200), discard on fail.
+ * Same placement as rsx_fp_apply_alpha_test_buffered, but the function is a
+ * per-draw value rather than baked in, so the pipeline key does not grow. */
+static int fp_apply_dynamic_alpha_test(char* hlsl, size_t cap)
+{
+    char* marker = NULL;
+    for (char* p = strstr(hlsl, "    return "); p; p = strstr(p + 1, "    return "))
+        marker = p;
+    if (!marker) return -1;
+    char* expr = marker + strlen("    return ");
+    char* term = strstr(expr, ";\n}\n");
+    if (!term || term == expr || (size_t)(term - expr) >= 96) return -1;
+    char output[96];
+    memcpy(output, expr, (size_t)(term - expr));
+    output[term - expr] = '\0';
+    const int mrt = strstr(hlsl, "struct PSOutput") != NULL;
+    char suffix[768];
+    const int n = snprintf(suffix, sizeof suffix,
+        "    %s _rsx_out = %s;\n"
+        "    if (rsx_alphatest.x != 0.0) {\n"
+        "        const float _rsx_a = %s.a, _rsx_r = rsx_alphatest.y;\n"
+        "        const uint _rsx_f = (uint)rsx_alphatest.z;\n"
+        "        const bool _rsx_pass =\n"
+        "            _rsx_f == 1u ? _rsx_a <  _rsx_r : _rsx_f == 2u ? _rsx_a == _rsx_r :\n"
+        "            _rsx_f == 3u ? _rsx_a <= _rsx_r : _rsx_f == 4u ? _rsx_a >  _rsx_r :\n"
+        "            _rsx_f == 5u ? _rsx_a != _rsx_r : _rsx_f == 6u ? _rsx_a >= _rsx_r :\n"
+        "            _rsx_f == 7u;\n"
+        "        if (!_rsx_pass) discard;\n"
+        "    }\n"
+        "    return _rsx_out;\n}\n",
+        mrt ? "PSOutput" : "float4", output, mrt ? "_rsx_out.t0" : "_rsx_out");
+    if (n <= 0 || (size_t)n >= sizeof suffix) return -1;
+    if ((size_t)(marker - hlsl) + (size_t)n + 1 > cap) return -1;
+    memcpy(marker, suffix, (size_t)n + 1);
+    return 1;
+}
