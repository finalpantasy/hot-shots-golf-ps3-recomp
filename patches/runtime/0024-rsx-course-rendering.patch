+/* Strip continuation across draw batches. One BEGIN/END may carry a strip,
+ * fan, polygon or quad strip split over several DRAW_ARRAYS / DRAW_INDEX_ARRAY
+ * entries (each at most 256 vertices). The RSX concatenates contiguous ranges
+ * into one primitive stream before assembly (RPCS3 draw_clause::append merges
+ * a range whose first equals the previous first + count), so the primitives
+ * that straddle a batch boundary exist on hardware. Expanding each batch as
+ * its own strip dropped those: two triangles of every 256-vertex strip batch,
+ * which showed as a diagonal line of holes in the title's sky dome.
+ * RSX_STRIP_JOIN=0 restores the per-batch expansion. */
+static struct { int valid, indexed; u32 epoch, prim, start, end, ixoff, ixdma; } s_strip;
+
+static int strip_join_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_STRIP_JOIN"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+static int strip_like(u32 prim)
+{
+    return prim == RSX_PRIMITIVE_TRIANGLE_STRIP || prim == RSX_PRIMITIVE_TRIANGLE_FAN ||
+           prim == RSX_PRIMITIVE_POLYGON || prim == RSX_PRIMITIVE_QUAD_STRIP;
+}
+
+/* Returns the strip's first vertex/index position when [first, first+count)
+ * continues the previous batch of the same strip, else first; then records
+ * this batch as the strip's latest. *prev_end gets the previous batch end. */
+static u32 strip_track(const rsx_state* st, u32 prim, int indexed, u32 first, u32 count,
+                       u32* prev_end)
+{
+    const u32 ep = st ? st->begin_epoch : 0;
+    const u32 ixo = (st && indexed) ? st->index_array_offset : 0;
+    const u32 ixd = (st && indexed) ? st->index_array_dma : 0;
+    u32 start = first;
+    *prev_end = first;
+    if (strip_join_on() && s_strip.valid && s_strip.epoch == ep && s_strip.prim == prim &&
+        s_strip.indexed == indexed && s_strip.end == first &&
+        s_strip.ixoff == ixo && s_strip.ixdma == ixd) {
+        start = s_strip.start;
+        *prev_end = s_strip.end;
+    }
+    s_strip.valid = 1; s_strip.indexed = indexed; s_strip.epoch = ep; s_strip.prim = prim;
+    s_strip.start = start; s_strip.end = first + count; s_strip.ixoff = ixo; s_strip.ixdma = ixd;
+    return start;
+}
