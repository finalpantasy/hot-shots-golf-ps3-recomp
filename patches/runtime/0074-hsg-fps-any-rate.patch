+/* HSG_FPS_SNAP: from logic step HSG_FPS_SNAP_AT on, for HSG_FPS_SNAP_N
+ * frames, write <dir>/f<i>.bin: the guest words that changed since the
+ * previous frame's poll (u32 address, old, new; big-endian words as stored),
+ * after a 16-byte header (frame index, S, logic flag, fraction * 1e6). The
+ * first frame only takes the copy. Committed pages of .data/.bss and of the
+ * sys_memory window, found once at the first frame. */
+#ifdef _WIN32
+typedef struct { u32 a, n; u8* copy; } snap_rg;
+static void snap_frame(void)
+{
+    static int on = -1, nrg, idx;
+    static u32 at, nfr, n2;
+    static const char* dir;
+    static snap_rg rg[8192];
+    if (on < 0) {
+        dir = getenv("HSG_FPS_SNAP");
+        const char* a = getenv("HSG_FPS_SNAP_AT"); const char* n = getenv("HSG_FPS_SNAP_N");
+        at = a ? (u32)strtoul(a, NULL, 0) : 0; nfr = n ? (u32)strtoul(n, NULL, 0) : 8;
+        const char* e2 = getenv("HSG_FPS_SNAP_N2");
+        n2 = e2 && s_pace_frames ? (u32)strtoul(e2, NULL, 0) : 0;
+        on = dir && *dir && at ? 1 : 0;
+        if (on) CreateDirectoryA(dir, NULL);
+    }
+    if (on != 1 || hsg_fps_logic_flips() < at) return;
+    /* HSG_FPS_SNAP_N2: frames mode switches between N and 2 frames per step
+     * on a logic frame (S = 0 decided; Main_Tick wraps S with the new D). */
+    if (n2 && s_prev_s == 0 && vm_read8(HSG_GAMEMAIN + 4) == 0) {
+        static int base_k;
+        if (!base_k) base_k = s_k;
+        const int want = ((u32)idx > n2 && (u32)idx <= nfr) ? 2 : base_k;
+        if (want != s_k) {
+            s_k = want;
+            vm_write_f32(HSG_FPS_KF_ADDR, (float)s_k);
+            vm_write32(HSG_FPS_K_ADDR, (u32)s_k);
+            vm_write32(HSG_DIV_ADDR, (u32)s_k);
+            vm_write32(HSG_GAMEMAIN + 8, (u32)(s_k - 1));   /* the tick still wraps to 0 */
+            fprintf(stderr, "[fps] snapshot %d: %d frames per step from here\n", idx, s_k);
+        }
+    }
+    if ((u32)idx > nfr) {
+        if (s_k == s_pace_frames) { on = 2; fprintf(stderr, "[fps] snapshots done\n"); }
+        return;
+    }
+    if (idx == 0) {
+        static const u32 span[][2] = { {0x00D20000u, 0x018F0000u}, {0x10000000u, 0x20000000u} };
+        for (int k = 0; k < 2; k++) {
+            u32 x = span[k][0];
+            while (x < span[k][1] && nrg < 8192) {
+                MEMORY_BASIC_INFORMATION mb;
+                if (!VirtualQuery(vm_base + x, &mb, sizeof mb)) break;
+                const u32 base = (u32)((u8*)mb.BaseAddress - vm_base);
+                u32 end = base + (u32)mb.RegionSize;
+                if (end > span[k][1] || end < base) end = span[k][1];
+                if (mb.State == MEM_COMMIT && !(mb.Protect & (PAGE_GUARD | PAGE_NOACCESS)) && end > x) {
+                    rg[nrg].a = x; rg[nrg].n = end - x;
+                    rg[nrg].copy = (u8*)malloc(rg[nrg].n);
+                    if (!rg[nrg].copy) break;
+                    memcpy(rg[nrg].copy, vm_base + x, rg[nrg].n);
+                    nrg++;
+                }
+                x = end;
+            }
+        }
+        unsigned long long tot = 0; for (int i = 0; i < nrg; i++) tot += rg[i].n;
+        fprintf(stderr, "[fps] snapshot: %d regions, %.1f MB\n", nrg, tot / 1048576.0);
+        idx = 1;
+        return;
+    }
+    char path[600]; snprintf(path, sizeof path, "%s/f%02d.bin", dir, idx);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+        const u32 hdr[4] = { (u32)idx, (u32)s_prev_s, (u32)(s_prev_s == 0), (u32)(s_last_a * 1e6) };
+        fwrite(hdr, 4, 4, f);
+    }
+    unsigned long long nch = 0;
+    for (int i = 0; i < nrg; i++) {
+        const u32* cur = (const u32*)(vm_base + rg[i].a);
+        u32* old = (u32*)rg[i].copy;
+        const u32 nw = rg[i].n / 4;
+        for (u32 w = 0; w < nw; w++) {
+            if (cur[w] != old[w]) {
+                if (f) { const u32 rec[3] = { rg[i].a + w * 4, old[w], cur[w] }; fwrite(rec, 4, 3, f); }
+                old[w] = cur[w]; nch++;
+            }
+        }
+    }
+    if (f) fclose(f);
+    fprintf(stderr, "[fps] snapshot %d: S=%d A=%.4f %llu words changed\n", idx, s_prev_s, s_last_a, nch);
+    idx++;
+}
+#endif
