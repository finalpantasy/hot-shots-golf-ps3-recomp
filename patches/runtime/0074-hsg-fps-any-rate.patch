+static void wait_until(double t)
+{
+    double left = t - now_ms();
+    if (left <= 0) return;
+#ifdef _WIN32
+    if (left > 0.8) {
+        static HANDLE tm; static int tried;
+        if (!tried) {
+            tried = 1;
+            tm = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                        TIMER_ALL_ACCESS);
+            if (!tm) tm = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+        }
+        LARGE_INTEGER due; due.QuadPart = -(LONGLONG)((left - 0.5) * 10000.0);   /* relative, 100 ns */
+        if (tm && SetWaitableTimer(tm, &due, 0, NULL, NULL, FALSE)) WaitForSingleObject(tm, (DWORD)left + 20);
+        else Sleep((DWORD)(left - 0.8));
+    }
+    while (now_ms() < t) SwitchToThread();
+#else
+    struct timespec ts = { (time_t)(left / 1000.0), (long)((left - (double)(long)(left / 1000.0) * 1000.0) * 1e6) };
+    nanosleep(&ts, NULL);
+#endif
+}
