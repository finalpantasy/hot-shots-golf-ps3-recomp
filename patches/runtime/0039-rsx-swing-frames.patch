+/* Backbuffer (RENDER_TARGET) <-> saved image of `surf`. save=1 stores the
+ * backbuffer, save=0 loads it back. Returns 1 when a copy was recorded. */
+static int keep_disp_copy(u32 fi, u32 surf, int save)
+{
