+        FAILED(D3DCompile(ps8, sizeof ps8 - 1, "dispz_ps8", NULL, NULL, "main", "ps_5_0", 0, 0, &pb, &err)) ||
+        FAILED(D3DCompile(psf, sizeof psf - 1, "dispz_psf", NULL, NULL, "main", "ps_5_0", 0, 0, &pf, &err))) {
