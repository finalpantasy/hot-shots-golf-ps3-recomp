+/* The copy of kind `k` at w x h (made, or remade when its size changes and no
+ * draw of this batch already points at it). Returns 0 when there is none. */
+static int dispz_copy_get(int k, u32 w, u32 h)
+{
+    if (!dispz_init()) return 0;
+    if (w < 1 || h < 1 || w > 4096 || h > 4096) return 0;
+    DispZCopy* c = &s_dispz[k];
+    if (c->res && ((c->w == w && c->h == h) || c->batch == s_dispz_batch)) { c->batch = s_dispz_batch; return 1; }
+    if (c->res) { wait_for_gpu(); c->res->lpVtbl->Release(c->res); c->res = NULL; }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = k ? DXGI_FORMAT_R32_FLOAT : DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL,
+            &IID_ID3D12Resource, (void**)&c->res))) { c->res = NULL; return 0; }
+    rdoc_name((ID3D12Object*)c->res, "display depth copy %d %ux%u", k, w, h);
+    c->w = w; c->h = h; c->dxgi = (u32)td.Format; c->conv_gen = 0; c->batch = s_dispz_batch;
+    s_dispz_nmake++;
+    c->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_dispz_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_dispz_rtv, &rh);
+    rh.ptr += (u64)k * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    s_d3d.device->lpVtbl->CreateRenderTargetView(s_d3d.device, c->res, NULL, rh);
+    { static int _n = 0; if (PS3_LOG_FIRST(_n, 4))
+        printf("[D3D12] display depth 0x%X read as a texture: %s copy %ux%u%c", s_dispz_off,
+               k ? "R32F" : "D24S8-bytes", w, h, 10); }
+    return 1;
+}
