+/* Texture units a fragment program samples (cached per program address). */
+static u32 fp_units_cached(u32 fp_addr)
+{
+    static u32 key[64], sig[64], val[64];
+    if (!fp_addr) return 0;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u32 off = cellGcmResolveLocated((fp_addr & 0x3u) == 1, fp_addr & ~0x3u);
+    if (!vm_base || off == 0xFFFFFFFFu) return 0xFFFFu;   /* unknown: every unit */
+    u32 w0, w1;   /* the first instruction word pair: a program replaced at the same address */
+    memcpy(&w0, vm_base + off, 4); memcpy(&w1, vm_base + off + 4, 4);
+    const u32 h = (fp_addr >> 4) & 63u;
+    if (key[h] == fp_addr && sig[h] == (w0 ^ (w1 * 2654435761u))) return val[h];
+    key[h] = fp_addr; sig[h] = w0 ^ (w1 * 2654435761u);
+    val[h] = rsx_fp_texture_units(vm_base + off, 4096);
+    return val[h];
+}
