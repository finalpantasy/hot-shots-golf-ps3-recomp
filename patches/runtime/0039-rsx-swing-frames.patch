+/* ---- The display depth read as a texture ---------------------------------
+ * Display draws use the one shared depth buffer, so a title's main depth
+ * surface exists only on the GPU. Hot Shots Golf saves it before a swing (a
+ * full-screen draw samples zeta 0x0 as A8R8G8B8 and writes it out as depth to
+ * 0x034C0000) and restores it in every swing frame; read from guest memory the
+ * save saw zeros, the restored depth failed every later draw, and the swing
+ * frames came out black. A unit the fragment program samples whose offset is
+ * the display's zeta gets a copy of the shared depth buffer instead, in the
+ * same encodings as ds_convert, at the texture's size (the backbuffer stands
+ * in for a display surface of the guest's size, so texels are scaled).
+ * RSX_DISP_DEPTH_TEX=0 turns this off. */
+#define DISPZ_SRV_BASE (DS_SRV_BASE + MAX_OFF_DS * 2)   /* depth + stencil SRVs of the shared buffer */
+static int dispz_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_DISP_DEPTH_TEX"); v = (e && e[0] == '0') ? 0 : 1; }
+    return v;
+}
+/* RSX_DISP_DEPTH_KEEP=0: clear the shared depth buffer on every switch back to
+ * a target without its own depth surface, as before. By default only a switch
+ * away from (or back from) an offscreen pass that borrowed it as scratch
+ * clears it: an offscreen pass with its own depth surface in the middle of the
+ * frame (a bloom downsample) used to wipe the display depth for the rest of
+ * the frame, and the depth the swing save reads with it. */
+static int dispz_keep_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_DISP_DEPTH_KEEP"); v = (e && e[0] == '0') ? 0 : 1; }
+    return v;
+}
+static u32 s_dispz_off = 0;            /* the display's zeta offset (0 is valid) */
+static int s_dispz_known = 0;
+static u32 s_dispz_sw = 0, s_dispz_sh = 0;   /* guest display surface size */
+static u32 s_dispz_gen = 1;            /* bumped whenever the shared depth may change */
+static int s_shared_scratch = 0;       /* the shared depth holds an offscreen pass's scratch depth */
+static u32 s_dispz_batch = 0;          /* render_frame sequence, for the copies' size guard */
+typedef struct { ID3D12Resource* res; u32 w, h, dxgi, conv_gen, batch; D3D12_RESOURCE_STATES st; } DispZCopy;
+static DispZCopy s_dispz[2];           /* [0] D24S8 bytes as RGBA8, [1] depth as R32F */
+static ID3D12RootSignature* s_dispz_rs;
+static ID3D12PipelineState* s_dispz_pso[2];
+static ID3D12DescriptorHeap* s_dispz_rtv;
+static u32 s_dispz_nconv, s_dispz_nmake, s_dispz_nbind;   /* RSX_DISPZ_DBG=1: per-second counts */
+static void dispz_stats(void)
+{
+    static int on = -1; static double t0 = 0;
+    if (on < 0) on = getenv("RSX_DISPZ_DBG") ? 1 : 0;
+    if (!on) return;
+    const double now = perf_now();
+    if (!t0) t0 = now;
+    if (now - t0 < 1.0) return;
+    printf("[DISPZ] per %.1fs: conversions=%u copies made=%u draws bound=%u frame=%llu%c", now - t0,
+           s_dispz_nconv, s_dispz_nmake, s_dispz_nbind, (unsigned long long)s_d3d.frame_count, 10);
+    s_dispz_nconv = s_dispz_nmake = s_dispz_nbind = 0; t0 = now;
+}
