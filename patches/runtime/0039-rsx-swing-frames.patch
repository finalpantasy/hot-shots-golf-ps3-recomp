+/* Refresh copy `k` from the shared depth buffer as it is now. Leaves the
+ * guest path's root signature, heaps and targets unbound. */
+static void dispz_convert(int k)
+{
+    DispZCopy* c = &s_dispz[k];
+    if (!c->res || !s_dispz_pso[k]) return;
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_dispz_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_dispz_rtv, &rh);
+    rh.ptr += (u64)k * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &rh, FALSE, NULL);
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource   = s_d3d.depth_buffer;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    b[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1] = b[0];
+    b[1].Transition.pResource   = c->res;
+    b[1].Transition.StateBefore = c->st;
+    b[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    cl->lpVtbl->ResourceBarrier(cl, c->st == D3D12_RESOURCE_STATE_RENDER_TARGET ? 1 : 2, b);
+    D3D12_VIEWPORT vp = {0, 0, (float)c->w, (float)c->h, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)c->w, (LONG)c->h};
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+    cl->lpVtbl->SetGraphicsRootSignature(cl, s_dispz_rs);
+    cl->lpVtbl->SetPipelineState(cl, s_dispz_pso[k]);
+    ID3D12DescriptorHeap* hp[] = { s_d3d.srv_heap };
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, hp);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+    gh.ptr += (u64)DISPZ_SRV_BASE * s_d3d.srv_inc;
+    cl->lpVtbl->SetGraphicsRootDescriptorTable(cl, 0, gh);
+    /* Guest texel -> backbuffer pixel: the display draws were scaled by
+     * backbuffer / guest surface (RSX_VP_SCALE). */
+    float kk[4] = {1.0f, 1.0f, (float)s_d3d.width - 1.0f, (float)s_d3d.height - 1.0f};
+    { static int vsc = -1;
+      if (vsc < 0) { const char* e = getenv("RSX_VP_SCALE"); vsc = (e && e[0] == '0') ? 0 : 1; }
+      if (vsc && s_dispz_sw >= 16 && s_dispz_sh >= 16) {
+          kk[0] = (float)s_d3d.width / (float)s_dispz_sw;
+          kk[1] = (float)s_d3d.height / (float)s_dispz_sh;
+      } }
+    cl->lpVtbl->SetGraphicsRoot32BitConstants(cl, 1, 4, kk, 0);
+    cl->lpVtbl->IASetPrimitiveTopology(cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl->lpVtbl->DrawInstanced(cl, 3, 1, 0, 0);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 2, b);
+    c->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    c->conv_gen = s_dispz_gen;
+    s_dispz_nconv++;
+    { static int _n = 0; if (PS3_LOG_FIRST(_n, 4))
+        printf("[D3D12] display depth copy %d refreshed (frame %llu, scale %.3f,%.3f)%c", k,
+               (unsigned long long)s_d3d.frame_count, kk[0], kk[1], 10); }
+}
