+/* RSX_TEX_MOREFMT (default on; =0 off): the packed 16-bit colours (A1R5G5B5,
+ * A4R4G4B4, R5G6B5, R5G5B5A1, X1R5G5B5), D8R8G8B8, the HILO pairs and
+ * W32Z32Y32X32_FLOAT are bound and uploaded too -- rsx_texture_layout decodes
+ * them. Left out of d3d12_bind_texture's list, the unit kept the previous
+ * draw's texture: Hot Shots Golf's HUD wind arrow (A4R4G4B4 32x64) sampled
+ * the tee-box grass of the ball-lie inset drawn just before it. Left out of
+ * the upload list, it would get no SRV and render black. */
+static int tex_fmt_more(u32 bf)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_TEX_MOREFMT"); v = (e && e[0] == '0') ? 0 : 1; }
+    return v && (bf == 0x82 || bf == 0x83 || bf == 0x84 || bf == 0x97 || bf == 0x9D ||
+                 bf == 0x9E || bf == 0x8C || bf == 0x8D || bf == 0x9B);
+}
+
