+/* HANG_WD=<s>: once guest flips have stopped for <s> seconds, dump every guest
+ * thread (guest lr, the lv2 syscall or HLE it is inside, with its object id)
+ * and every SPURS job chain walker, then again at 2x and 3x <s>. A load that
+ * never ends leaves the vblank ticker and audio running, so "no flip" is the
+ * one signal that names the stall. Started on the first flip. */
+#ifdef _WIN32
+extern void ppu_report_hang(void);   /* ppu_loader.cpp */
+extern void spurs_wd_dump(void);     /* cellSpurs.c */
+static DWORD WINAPI gcm_hang_wd(LPVOID p)
+{
+    const unsigned long long lim = (unsigned long long)(uintptr_t)p * 1000ull;
+    u32 last = s_flip_request_count;
+    unsigned long long since = GetTickCount64();
+    int dumps = 0;
+    for (;;) {
+        Sleep(500);
+        u32 c = s_flip_request_count;
+        unsigned long long now = GetTickCount64();
+        if (c != last) {
+            if (dumps) fprintf(stderr, "[WATCHDOG] flips resumed after %llums (flips=%u)\n",
+                               now - since, c);
+            last = c; since = now; dumps = 0; continue;
+        }
+        if (dumps < 3 && now - since >= lim * (unsigned long long)(dumps + 1)) {
+            dumps++;
+            fprintf(stderr, "[WATCHDOG] no guest flip for %llums (flips=%u), dump %d\n",
+                    now - since, c, dumps);
+            ppu_report_hang();
+            spurs_wd_dump();
+            fflush(stderr);
+        }
+    }
+    return 0;
+}
+static void gcm_hang_wd_start(void)
+{
+    static volatile long started = 0;
+    if (started || InterlockedCompareExchange(&started, 1, 0) != 0) return;
+    const char* e = getenv("HANG_WD");
+    int s = e ? atoi(e) : 0;
+    if (s <= 0) return;
+    fprintf(stderr, "[WATCHDOG] flip watchdog armed: %ds\n", s);
+    HANDLE h = CreateThread(NULL, 0, gcm_hang_wd, (LPVOID)(uintptr_t)s, 0, NULL);
+    if (h) CloseHandle(h);
+}
+#else
+static void gcm_hang_wd_start(void) {}
