+extern "C" volatile uint32_t g_sc_inflight_a3[PPU_SC_INFLIGHT_MAX] = {0};
+extern "C" volatile uint32_t g_sc_inflight_a4[PPU_SC_INFLIGHT_MAX] = {0};
+extern "C" volatile uint64_t g_sc_inflight_t0[PPU_SC_INFLIGHT_MAX] = {0};
+extern "C" const char* g_hle_inflight[];   /* ppu_hle.cpp; 64 entries */
+struct PpuScInflight {
+    unsigned t;
