+/* HANG_WD dump (called by the flip watchdog in cellGcmSys.c): every registered
+ * chain, whether a walker is on it, and where that walker is. */
+void spurs_wd_dump(void)
+{
+    static const char* st[] = { "walk", "PARKED", "GUARD", "barrier", "done" };
+    int used = 0;
+    for (int i = 0; i < MAX_JOBCHAINS; i++) {
+        if (!s_jobchains[i].jc_ea && !s_jobchains[i].walker_live) continue;
+        used++;
+        int g = s_jobchains[i].wd_state;
+        u32 aux = s_jobchains[i].wd_aux, pc = s_jobchains[i].wd_pc;
+        fprintf(stderr, "[WATCHDOG]   jc slot %3d ea=0x%08X spurs=0x%08X runs=%d running=%ld "
+                "live=%ld stop=%ld state=%s pc=0x%08X cmd=0x%016llX",
+                i, s_jobchains[i].jc_ea, s_jobchains[i].spurs_ea, s_jobchains[i].run_count,
+                (long)s_jobchains[i].running, (long)s_jobchains[i].walker_live,
+                (long)s_jobchains[i].stop, (g >= 0 && g <= 4) ? st[g] : "?", pc,
+                (unsigned long long)(pc ? vm_read64(pc) : 0));
+        if (g == 2) {
+            int k = jg_find(aux);
+            if (k >= 0)
+                fprintf(stderr, " guard=0x%08X count=%u pending=%u reset=%u",
+                        aux, s_jobguards[k].count, s_jobguards[k].pending, s_jobguards[k].reset);
+        }
+        fprintf(stderr, "\n");
+    }
+    fprintf(stderr, "[WATCHDOG]   job chains registered: %d, Create calls refused (registry full): %ld, "
+            "JC_RECLAIM=%d\n", used, (long)s_jc_full_count, jc_reclaim_on());
+}
