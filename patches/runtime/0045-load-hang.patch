+    case 92: return "semaphore_wait"; case 94: return "semaphore_post";
+    case 95: return "lwmutex_create"; case 97: return "_lwmutex_lock";
+    case 98: return "_lwmutex_unlock"; case 102: return "mutex_lock";
+    case 104: return "mutex_unlock"; case 107: return "cond_wait";
+    case 108: return "cond_signal"; case 109: return "cond_signal_all";
