+/* A depth surface read through an A8R8G8B8 unit (its D24S8 bytes: the colour
+ * copies ds_convert and dispz_convert make) goes through the unit's component
+ * remap like any texture. Hot Shots Golf saves the display depth before a
+ * swing and restores it in every swing frame through crossbar 0xAA93, which
+ * puts the high depth byte (A) in .r, the middle byte in .g and the low byte
+ * in .b, and the program rebuilds depth as r/256 + g/65536 + b/2^24. Read
+ * without the remap it took the middle byte as the high one: the saved depth
+ * was the low two bytes of the real one, near 0, every golfer draw in the
+ * swing failed its depth test, and pixels whose low byte was 0 stayed black
+ * under the restored background. Only the byte copy (R8G8B8A8) of an ARGB
+ * unit is remapped; a depth-format unit reads the R32F copy as before.
+ * RSX_DEPTH_REMAP=0 reads them unremapped, as before. */
+static UINT depth_bytes_mapping(u32 fmt, u32 ctrl1, u32 dxgi)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_DEPTH_REMAP"); v = (e && e[0] == '0') ? 0 : 1; }
+    if (!v || (fmt & 0x9Fu) != 0x85u || dxgi != (u32)DXGI_FORMAT_R8G8B8A8_UNORM)
+        return D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    { static u32 seen[8]; static int ns = 0; int k = 0;   /* each crossbar once */
+      for (; k < ns; k++) if (seen[k] == (ctrl1 & 0xFFFFu)) break;
+      if (k == ns && ns < 8) { seen[ns++] = ctrl1 & 0xFFFFu;
+          printf("[D3D12] depth bytes read through crossbar 0x%04X%c", ctrl1 & 0xFFFFu, 10); } }
+    return rsx_remap_to_d3d(ctrl1, 0x85u);
+}
