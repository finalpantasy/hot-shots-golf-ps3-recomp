diff --git a/libs/system/cellGame.c b/libs/system/cellGame.c
index 2d4a54d..6b8c080 100644
--- a/libs/system/cellGame.c
+++ b/libs/system/cellGame.c
@@ -303,18 +303,21 @@ static int sfo_read_string(const char* sfo_path, const char* key,
 }
 
 /* Read title/version fields from the game's PARAM.SFO at boot. Call once
- * from main.cpp before the guest runs. Falls back to the defaults if the SFO
- * can't be read (keeps the game working without it). */
-void cellGame_init_from_paramsfo(const char* sfo_path)
+ * from main.cpp before the guest runs. Returns 0 on success, -1 if the SFO
+ * is missing, unreadable or has no TITLE_ID. On failure the placeholder title
+ * id "BLES00000" is still in place; the caller must treat that as an error
+ * (there is deliberately no hardcoded real id to fall back to). */
+int cellGame_init_from_paramsfo(const char* sfo_path)
 {
     char tmp[256];
+    int rc = 0;
     if (sfo_read_string(sfo_path, "TITLE_ID", tmp, sizeof(tmp)) == 0 && tmp[0]) {
         strncpy(s_title_id, tmp, sizeof(s_title_id) - 1);
         s_title_id[sizeof(s_title_id) - 1] = '\0';
         printf("[cellGame] title id from PARAM.SFO ('%s'): '%s'\n", sfo_path, s_title_id);
     } else {
-        printf("[cellGame] PARAM.SFO not read ('%s'); keeping title id '%s'\n",
-               sfo_path, s_title_id);
+        fprintf(stderr, "[cellGame] ERROR: no TITLE_ID read from PARAM.SFO ('%s')\n", sfo_path);
+        rc = -1;
     }
     /* CATEGORY decides the type cellGameBootCheck reports: "DG" is a disc game, "HG" an HDD game (a PSN
      * download, booted from /dev_hdd0/game/<id>). Titles check it and give up on a type they do not expect.
@@ -338,6 +341,7 @@ void cellGame_init_from_paramsfo(const char* sfo_path)
     if (sfo_read_string(sfo_path, "APP_VER", tmp, sizeof(tmp)) == 0 && tmp[0]) {
         strncpy(s_app_ver, tmp, sizeof(s_app_ver) - 1); s_app_ver[sizeof(s_app_ver) - 1] = '\0';
     }
+    return rc;
 }
 
 /* Central title-id accessor so other modules (cellSysutil etc.) don't hardcode it. */
diff --git a/libs/system/cellGame.h b/libs/system/cellGame.h
index d3531fa..22c9b49 100644
--- a/libs/system/cellGame.h
+++ b/libs/system/cellGame.h
@@ -127,8 +127,9 @@ typedef struct CellGameSetInitParams {
 void cellGame_set_title_id(const char* title_id);
 
 /* Read title/version fields from the game's PARAM.SFO at boot (robust title id
- * for all path building). Falls back to defaults if the SFO can't be read. */
-void cellGame_init_from_paramsfo(const char* sfo_path);
+ * for all path building). Returns 0 on success, -1 if the SFO can't be read
+ * (the placeholder title id stays; callers should report an error). */
+int cellGame_init_from_paramsfo(const char* sfo_path);
 
 /* Central title-id accessor (so other modules don't hardcode placeholders). */
 const char* cellGame_get_title_id(void);
