+/* JC_NAP_US=<us> (default 250; 0 = the old Sleep(1)): how long a job chain
+ * walker naps between polls of a parked slot or a closed guard.
+ *
+ * Both waits used Sleep(1), which is 1-2 ms with a 1 ms system timer and a
+ * whole 15.6 ms tick when Windows ignores the process's timer request (a
+ * hidden, occluded or muted window on Windows 11). Hot Shots Golf's main
+ * thread appends jobs to a parked chain several times a frame and then waits
+ * for their done counter, so each nap was paid in frame time. A high
+ * resolution waitable timer keeps the CPU cost of a sleep and wakes on time,
+ * and jc_kick ends a nap at once: cellSpursJobGuardNotify calls it, and so
+ * does sys_timer_usleep when a PPU thread starts a new poll episode. */
+#ifdef _WIN32
+/* One auto-reset event per walker slot, set by jc_kick while that walker naps. */
+static HANDLE s_jc_nap_ev[MAX_JOBCHAINS];
+static volatile LONG s_jc_napping[MAX_JOBCHAINS];
+static volatile LONG s_jc_nappers;
+static int jc_nap_us(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("JC_NAP_US");
+        v = e ? atoi(e) : 250;
+        if (v < 0) v = 0;
+        if (v > 1000) v = 1000;
+    }
+    return v;
+}
+/* Wake every napping walker: a guard was notified, or a PPU thread started
+ * waiting (sys_timer_usleep's poll episode), which is when it has just
+ * appended work to a parked chain and wants it run. */
+static void jc_kick(void)
+{
+    if (s_jc_nappers <= 0) return;
+    for (int i = 0; i < MAX_JOBCHAINS; i++)
+        if (s_jc_napping[i] && s_jc_nap_ev[i]) SetEvent(s_jc_nap_ev[i]);
+}
+static void jc_nap(void)
+{
+    const int us = jc_nap_us();
+    const int slot = t_jc_slot;
+#if defined(_MSC_VER)
+    static __declspec(thread) HANDLE tmr; static __declspec(thread) int tmr_failed;
+#else
+    static __thread HANDLE tmr; static __thread int tmr_failed;
+#endif
+    if (us && !tmr && !tmr_failed) {
+        tmr = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                     TIMER_ALL_ACCESS);
+        if (!tmr) tmr_failed = 1;
+        { extern void (*g_rt_usleep_kick)(void); g_rt_usleep_kick = jc_kick; }
+    }
+    if (us && tmr) {
+        HANDLE ev = NULL;
+        if (slot >= 0 && slot < MAX_JOBCHAINS) {
+            if (!s_jc_nap_ev[slot]) s_jc_nap_ev[slot] = CreateEventW(NULL, FALSE, FALSE, NULL);
+            ev = s_jc_nap_ev[slot];
+        }
+        LARGE_INTEGER due; due.QuadPart = -((LONGLONG)us * 10);
+        if (SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE)) {
+            HANDLE hs[2] = { tmr, ev };
+            if (ev) { s_jc_napping[slot] = 1; InterlockedIncrement(&s_jc_nappers); }
+            if (WaitForMultipleObjects(ev ? 2 : 1, hs, FALSE, 2) == WAIT_OBJECT_0 + 1)
+                CancelWaitableTimer(tmr);
+            if (ev) { InterlockedDecrement(&s_jc_nappers); s_jc_napping[slot] = 0; }
+            return;
+        }
+    }
+    Sleep(1);
+}
+#else
+static void jc_kick(void) {}
+static void jc_nap(void) { usleep(1000); }
+#endif
