+static s32 http_check_client(CellHttpClientId client)
+{
+    if (!s_http_initialized) return HTTP_CLIENT_NOT_INITIALIZED;
+    if (client >= CELL_HTTP_MAX_CLIENTS || !s_clients[client].in_use)
+        return HTTP_CLIENT_BAD_ID;
