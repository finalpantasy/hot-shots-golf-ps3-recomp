 #include "cellFontFT.h"
+#include "cellFont.h"
+#include "../../runtime/ppu/ppu_memory.h"
+#include "../../runtime/syscalls/sys_memory.h"
+
+extern uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t,
+                              uint64_t, uint64_t, uint64_t, uint64_t);
+
+typedef struct {
+    u32 address;
+    u32 free_opd;
+    u32 arg;
+    int occupied;
+} FontLibrarySlot;
+
+static FontLibrarySlot s_libraries[8];
+static atomic_flag s_library_lock = ATOMIC_FLAG_INIT;
+
+static void lock_libraries(void)
+{
+    while (atomic_flag_test_and_set_explicit(&s_library_lock, memory_order_acquire)) {}
+}
+
+static void unlock_libraries(void)
+{
+    atomic_flag_clear_explicit(&s_library_lock, memory_order_release);
+}
+
+s32 cellFontInitLibraryFreeTypeWithRevision(u64 revision, const void* config, void* libraryOut)
+{
+    const u32 out = (u32)(uintptr_t)libraryOut;
+    const u32 cfg = (u32)(uintptr_t)config;
+    if (!out) return (s32)CELL_FONT_ERROR_INVALID_PARAMETER;
+    vm_write32(out, 0);
+    if (!cfg) return (s32)CELL_FONT_ERROR_INVALID_PARAMETER;
+
+    const u32 arg = vm_read32(cfg + 4);
+    const u32 alloc_opd = vm_read32(cfg + 8);
+    const u32 free_opd = vm_read32(cfg + 12);
+    if (!!alloc_opd != !!free_opd) return (s32)CELL_FONT_ERROR_INVALID_PARAMETER;
+
+    FontLibrarySlot* slot = NULL;
+    lock_libraries();
+    for (u32 i = 0; i < sizeof(s_libraries) / sizeof(s_libraries[0]); ++i) {
+        if (!s_libraries[i].occupied) {
+            slot = &s_libraries[i];
+            slot->occupied = 1;
+            break;
+        }
+    }
+    unlock_libraries();
+    if (!slot) return (s32)CELL_FONT_ERROR_ALLOCATION_FAILED;
+
+    enum { LIBRARY_SIZE = 12 };
+    u32 address = 0;
+    if (alloc_opd) {
+        address = (u32)ppu_guest_call(alloc_opd, arg, LIBRARY_SIZE, 0, 0, 0, 0, 0, 0);
+    } else {
+        ppu_context allocate = {0};
+        allocate.gpr[3] = LIBRARY_SIZE;
+        allocate.gpr[4] = SYS_MEMORY_PAGE_SIZE_64K;
+        allocate.gpr[5] = out;
+        if (sys_memory_allocate(&allocate) == CELL_OK) address = vm_read32(out);
+    }
+    if (address) {
+        vm_write32(address, 0);
+        vm_write32(address + 4, (u32)revision);
+        vm_write32(address + 8, 0);
+    }
+    lock_libraries();
+    *slot = (FontLibrarySlot){address, free_opd, arg, address != 0};
+    unlock_libraries();
+    if (!address) return (s32)CELL_FONT_ERROR_ALLOCATION_FAILED;
+    vm_write32(out, address);
+    printf("[cellFontFT] InitLibraryFreeType: revision=0x%llX library=0x%08X\n",
+           (unsigned long long)revision, address);
+    return CELL_OK;
+}
+
+s32 cellFontFTReleaseLibrary(u32 address)
+{
+    if (!address) return (s32)CELL_FONT_ERROR_INVALID_PARAMETER;
+    FontLibrarySlot library = {0};
+    lock_libraries();
+    for (u32 i = 0; i < sizeof(s_libraries) / sizeof(s_libraries[0]); ++i) {
+        if (s_libraries[i].address == address) {
+            library = s_libraries[i];
+            s_libraries[i] = (FontLibrarySlot){0};
+            break;
+        }
+    }
+    unlock_libraries();
+    if (!library.address) return (s32)CELL_FONT_ERROR_INVALID_PARAMETER;
+    if (library.free_opd) {
+        ppu_guest_call(library.free_opd, library.arg, address, 0, 0, 0, 0, 0, 0);
+        return CELL_OK;
+    }
+    ppu_context release = {0};
+    release.gpr[3] = address;
+    return (s32)sys_memory_free(&release);
+}
