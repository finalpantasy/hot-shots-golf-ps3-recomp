+
+s32 cellHttpClientSetConnTimeout(CellHttpClientId clientId, s64 usec)
+{
+    s32 error = http_check_client(clientId);
+    if (error) return error;
+    if (usec < 0 || usec > UINT32_MAX) return HTTP_CLIENT_INVALID_VALUE;
+    s_clients[clientId].connect_timeout = (u32)usec;
+    return CELL_OK;
+}
+
+static s32 http_set_client_io_timeout(CellHttpClientId clientId, s64 usec, int send_timeout)
+{
+    s32 error = http_check_client(clientId);
+    if (error) return error;
+    if (usec < 0 || usec > UINT32_MAX) return HTTP_CLIENT_INVALID_VALUE;
+    HttpClientSlot* client = &s_clients[clientId];
+    if (send_timeout) client->send_timeout = (u32)usec;
+    else client->recv_timeout = (u32)usec;
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; ++i) {
+        HttpTransSlot* t = &s_transactions[i];
+        if (t->in_use && t->client == clientId)
+            http_apply_timeout(t->sock, send_timeout, (u32)usec);
+    }
+    return CELL_OK;
+}
+
+s32 cellHttpClientSetSendTimeout(CellHttpClientId clientId, s64 usec)
+{
+    return http_set_client_io_timeout(clientId, usec, 1);
+}
+
+s32 cellHttpClientSetRecvTimeout(CellHttpClientId clientId, s64 usec)
+{
+    return http_set_client_io_timeout(clientId, usec, 0);
+}
+
+s32 cellHttpClientSetUserAgent(CellHttpClientId clientId, const char* userAgent)
+{
+    s32 error = http_check_client(clientId);
+    if (error) return error;
+    if (!userAgent) return HTTP_CLIENT_NO_BUFFER;
+    const char* agent = GUEST_PTR(userAgent, const char*);
+    const size_t capacity = sizeof(s_clients[clientId].user_agent);
+    size_t length = 0;
+    while (length < capacity && agent[length]) {
+        if (agent[length] == '\r' || agent[length] == '\n') return HTTP_CLIENT_INVALID_VALUE;
+        ++length;
+    }
+    if (length == capacity) return HTTP_CLIENT_INVALID_VALUE;
+    memcpy(s_clients[clientId].user_agent, agent, length + 1);
+    return CELL_OK;
+}
+
+s32 cellHttpClientSetSslCallback(CellHttpClientId clientId, u32 callback, u32 userArg)
+{
+    s32 error = http_check_client(clientId);
