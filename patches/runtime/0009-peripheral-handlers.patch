+static int http_connect(http_socket_t sock, const struct addrinfo* address, u32 usec)
+{
+    if (!usec) return connect(sock, address->ai_addr, (int)address->ai_addrlen);
+
+#ifdef _WIN32
+    u_long nonblocking = 1;
+    if (ioctlsocket(sock, FIONBIO, &nonblocking) != 0) return -1;
+#else
+    int flags = fcntl(sock, F_GETFL, 0);
+    if (flags < 0 || fcntl(sock, F_SETFL, flags | O_NONBLOCK) != 0) return -1;
+#endif
+    int result = connect(sock, address->ai_addr, (int)address->ai_addrlen);
+#ifdef _WIN32
+    if (result != 0 && WSAGetLastError() == WSAEWOULDBLOCK) {
+#else
+    if (result != 0 && errno == EINPROGRESS && sock < FD_SETSIZE) {
+#endif
+        fd_set ready, failed;
+        FD_ZERO(&ready);
+        FD_ZERO(&failed);
+        FD_SET(sock, &ready);
+        FD_SET(sock, &failed);
+        struct timeval timeout = { usec / 1000000, usec % 1000000 };
+        int status = 0;
+        socklen_t status_size = sizeof(status);
+#ifdef _WIN32
+        int selected = select(0, NULL, &ready, &failed, &timeout);
+#else
+        int selected = select(sock + 1, NULL, &ready, &failed, &timeout);
+#endif
+        if (selected > 0 &&
+            getsockopt(sock, SOL_SOCKET, SO_ERROR, (char*)&status, &status_size) == 0 &&
+            status == 0)
+            result = 0;
+    }
+#ifdef _WIN32
+    nonblocking = 0;
+    if (ioctlsocket(sock, FIONBIO, &nonblocking) != 0) return -1;
+#else
+    if (fcntl(sock, F_SETFL, flags) != 0) return -1;
+#endif
+    return result;
+}
