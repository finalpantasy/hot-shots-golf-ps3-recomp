diff --git a/libs/system/sys_crashdump.c b/libs/system/sys_crashdump.c
new file mode 100644
--- /dev/null
+++ b/libs/system/sys_crashdump.c
@@ -0,0 +1,53 @@
+#include "ps3emu/ps3types.h"
+#include "ps3emu/error_codes.h"
+#include "../../runtime/ppu/ppu_memory.h"
+
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { LOG_AREAS = 128, LABEL_SIZE = 16 };
+
+typedef struct {
+    char label[LABEL_SIZE];
+    u32 address;
+    u32 size;
+} CrashLogArea;
+
+static CrashLogArea s_log_areas[LOG_AREAS];
+static atomic_flag s_log_lock = ATOMIC_FLAG_INIT;
+
+s32 sys_crash_dump_set_user_log_area(u8 index, const void* entry)
+{
+    u32 ea = (u32)(uintptr_t)entry;
+    if (index >= LOG_AREAS || !ea) return (s32)CELL_EINVAL;
+
+    CrashLogArea area;
+    memcpy(area.label, vm_translate(ea), LABEL_SIZE);
+    area.address = vm_read32(ea + LABEL_SIZE);
+    area.size = vm_read32(ea + LABEL_SIZE + 4);
+    if (!memchr(area.label, '\0', LABEL_SIZE) || (!area.address && area.size) ||
+        (u64)area.address + area.size > UINT64_C(0x100000000))
+        return (s32)CELL_EINVAL;
+
+    while (atomic_flag_test_and_set_explicit(&s_log_lock, memory_order_acquire)) {}
+    s_log_areas[index] = area;
+    atomic_flag_clear_explicit(&s_log_lock, memory_order_release);
+    printf("[sys_crashdump] user log area %u: ea=0x%08X size=%u\n",
+           (unsigned)index, area.address, area.size);
+    return CELL_OK;
+}
+
+s32 sys_crash_dump_get_user_log_area(u8 index, void* entry)
+{
+    u32 ea = (u32)(uintptr_t)entry;
+    if (index >= LOG_AREAS || !ea) return (s32)CELL_EINVAL;
+
+    while (atomic_flag_test_and_set_explicit(&s_log_lock, memory_order_acquire)) {}
+    CrashLogArea area = s_log_areas[index];
+    atomic_flag_clear_explicit(&s_log_lock, memory_order_release);
+    memcpy(vm_translate(ea), area.label, LABEL_SIZE);
+    vm_write32(ea + LABEL_SIZE, area.address);
+    vm_write32(ea + LABEL_SIZE + 4, area.size);
+    return CELL_OK;
+}
