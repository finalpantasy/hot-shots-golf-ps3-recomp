-/* Which of a draw's texture units use unnormalized coordinates, with dimensions. */
+/* A render target sampled through a texture smaller than the target.
+ *
+ * On the RSX a texture is a header over memory: width, height and pitch. A
+ * linear texture whose pitch is its surface's pitch but whose size is smaller
+ * reads only the top-left corner of that surface, and normalized coordinates
+ * 0..1 span that corner. Hot Shots Golf renders a reduced copy of the scene
+ * into a corner of the 1600x1080 surface 0x01900000 (viewport 400x270; its
+ * blur passes use 800x540) and its water program (fp 0x018CE701) samples it
+ * through a 400x270 header at 0x01900000 (close-ups show a half-screen
+ * rectangle, so an 800x540 one there), addressed by screen position, to
+ * draw the reflection. The backend bound the whole offscreen target, so 0..1
+ * spanned all 1600x1080: the reflection filled only the corner's share of the
+ * screen, a hard-edged upside-down rectangle in the lower left, and the rest
+ * of the water reflected the target's cleared texels (plain blue water).
+ *
+ * Units like that get their coordinate scaled by texture size / target size
+ * in the fragment program (bits 16..31 of the unnorm mask, the PSO key; dims
+ * hold texture w, h and target w << 16 | h). Only units the program samples,
+ * normalized 2D ones, and only when the texture pitch is the target's
+ * (padded) row size, or unknown. RSX_RT_SUBRECT=0 restores sampling the whole target;
+ * RSX_RT_SUBRECT=2 (a/b test) scales on even frames only, so neighbouring
+ * frames of one scene show both. */
+static int rt_subrect_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_RT_SUBRECT"); v = e ? atoi(e) : 1; }
+    if (v == 2) return (s_d3d.frame_count & 1u) == 0;
+    return v != 0;
+}
+static u32 fp_units_cached(u32 fp_addr);
+static u32 dr_subrect_units(const D3D12DrawRecord* dr, u32 dim[16][3])
+{
+    if (!rt_subrect_on() || dr->is_clear) return 0;
+    u32 mask = 0, used = 0xFFFFu; int used_known = 0;
+    for (int u = 0; u < 16; u++) {
+        const int rt = dr->tex_rt[u];
+        if (rt < 0 || rt >= MAX_OFF_RTS || !dr->tex[u].set || dr->tex[u].cube ||
+            (dr->tex[u].fmt & 0x40) || !s_d3d.off_rt[rt].res) continue;
+        const u32 tw = dr->tex[u].w, th = dr->tex[u].h;
+        const u32 rw = s_d3d.off_rt[rt].w, rh = s_d3d.off_rt[rt].h;
+        if (!tw || !th || !rw || !rh || tw > rw || th > rh || (tw == rw && th == rh)) continue;
+        if (rw > 0xFFFFu || rh > 0x7FFFu) continue;
+        { static int rdbg = -1, rn = 0;   /* RSX_RT_SUBRECT_DBG=-N: every candidate, before the checks */
+          if (rdbg == -1) { const char* e = getenv("RSX_RT_SUBRECT_DBG"); rdbg = (e && atoi(e) < 0) ? -atoi(e) : 0; }
+          static u32 seen[512]; int dup = 0;
+          const u32 key = dr->fp_addr ^ ((u32)u << 28) ^ (tw << 12) ^ th;
+          for (int i = 0; i < rn && i < 512; i++) if (seen[i] == key) dup = 1;
+          if (rdbg && !dup && rn < rdbg && rn < 512) { seen[rn++] = key;
+              fprintf(stderr, "[SUBRECT?] fp=0x%08X unit %d tex 0x%08X %ux%u pitch=%u fmt=0x%02X <- target %ux%u dxgi=%u used=0x%X%c",
+                      dr->fp_addr, u, dr->tex[u].raw, tw, th, dr->tex[u].pitch, dr->tex[u].fmt, rw, rh,
+                      s_d3d.off_rt[rt].dxgi, fp_units_cached(dr->fp_addr), 10); } }
+        /* The pitch must be the target's row: at least its width in bytes
+         * (bytes per texel from the target's format) and less than twice it,
+         * as the surface pitch is padded (1600 wide: 6656 bytes, not 6400).
+         * Any other pitch reinterprets the memory and is not a corner. */
+        if (dr->tex[u].pitch) {
+            const u32 bpp = (s_d3d.off_rt[rt].dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT) ? 8u
+                          : (s_d3d.off_rt[rt].dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT) ? 16u : 4u;
+            if (dr->tex[u].pitch < rw * bpp || dr->tex[u].pitch >= 2u * rw * bpp) continue;
+        }
+        if (!used_known) { used = fp_units_cached(dr->fp_addr); used_known = 1; }
+        if (!((used >> u) & 1u)) continue;
+        mask |= 1u << u;
+        dim[u][0] = tw; dim[u][1] = th; dim[u][2] = (rw << 16) | rh;
+        { static int dbg = -1, n = 0;
+          if (dbg < 0) { const char* e = getenv("RSX_RT_SUBRECT_DBG"); dbg = e ? atoi(e) : 0; }
+          if (dbg && n < dbg) { n++;
+              fprintf(stderr, "[SUBRECT] fp=0x%08X unit %d tex 0x%08X %ux%u pitch=%u <- target %ux%u (scale %.4f,%.4f)%c",
+                      dr->fp_addr, u, dr->tex[u].raw, tw, th, dr->tex[u].pitch, rw, rh,
+                      (double)tw / rw, (double)th / rh, 10); } }
+    }
+    return mask;
+}
