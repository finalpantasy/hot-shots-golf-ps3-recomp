+/* Insert " * float2(tw/rw, th/rh)" at the end of every 2D Sample() coordinate
+ * of the units in sub_mask (see dr_subrect_units). Returns call sites patched. */
+static int fp_apply_subrect_scale(char* hlsl, size_t cap, u32 sub_mask, const u32 dim[16][3])
+{
+    int patched = 0;
+    for (u32 u = 0; u < 16 && sub_mask; u++) {
+        if (!((sub_mask >> u) & 1u)) continue;
+        const u32 rw = dim[u][2] >> 16, rh = dim[u][2] & 0xFFFFu;
+        if (!rw || !rh) continue;
+        char scale[80];
+        snprintf(scale, sizeof scale, " * float2(%.9g, %.9g)",
+                 (double)dim[u][0] / (double)rw, (double)dim[u][1] / (double)rh);
+        const size_t slen = strlen(scale);
+        char needles[2][40];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].Sample(rsx_samp[%u],", u, u);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.Sample(rsx_samp[%u],", u, u);
+        for (int k = 0; k < 2; k++) {
+            char* from = hlsl;
+            for (;;) {
+                char* at = strstr(from, needles[k]);
+                if (!at) break;
+                char* open = strchr(at, '(');
+                int depth = 0; char* p = open;
+                for (; p && *p; p++) {
+                    if (*p == '(') depth++;
+                    else if (*p == ')') { depth--; if (!depth) break; }
+                }
+                if (!p || *p != ')') break;
+                from = p;
+                /* A 3-component coordinate (cube / volume form): leave it. */
+                { const char save = *p; *p = 0; const int v3 = strstr(at, ".xyz") != NULL; *p = save;
+                  if (v3) continue; }
+                const size_t used = strlen(hlsl);
+                if (used + slen + 1 > cap) return patched;
+                memmove(p + slen, p, used - (size_t)(p - hlsl) + 1);
+                memcpy(p, scale, slen);
+                from = p + slen;
+                patched++;
+            }
+        }
+    }
+    return patched;
+}
