+static HWND create_window(u32 width, u32 height, const char* title)
+{
+    if (!wnd_thread_on()) return create_window_here(width, height, title);
+    WndThreadArgs a = { width, height, title, NULL, CreateEventA(NULL, TRUE, FALSE, NULL) };
+    if (!a.ready) return create_window_here(width, height, title);
+    HANDLE th = CreateThread(NULL, 256u * 1024, wnd_thread_main, &a, 0, NULL);
+    if (!th) { CloseHandle(a.ready); s_wnd_thread_on = 0; return create_window_here(width, height, title); }
+    WaitForSingleObject(a.ready, INFINITE);
+    CloseHandle(a.ready);
+    CloseHandle(th);
+    if (!a.hwnd) { s_wnd_thread_on = 0; return create_window_here(width, height, title); }
