+typedef struct { u32 w, h; const char* title; HWND hwnd; HANDLE ready; } WndThreadArgs;
+static DWORD WINAPI wnd_thread_main(LPVOID p)
+{
+    WndThreadArgs* a = (WndThreadArgs*)p;
+    HWND hwnd = create_window_here(a->w, a->h, a->title);
+    a->hwnd = hwnd;
+    SetEvent(a->ready);              /* `a` lives on the creator's stack: not touched after this */
+    if (!hwnd) return 1;
+    MSG msg;
+    while (GetMessageA(&msg, NULL, 0, 0) > 0) {
+        TranslateMessage(&msg);
