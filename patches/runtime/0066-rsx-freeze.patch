+/* RSX_SHADER_PAR=<threads> (default 4; 0 off): build the guest fragment
+ * pipelines a batch is missing in parallel. On a cold shader cache a course
+ * load meets dozens of new fragment programs; each one was decompiled, run
+ * through D3DCompile and then CreateGraphicsPipelineState (the driver's own
+ * compiler, 0.1-2 s) one after another on the frame thread: 5-25 s stalls.
+ * render_frame now walks the batch first (pso_prefetch) and, for every draw
+ * whose pipeline is not cached, runs vp_get_fp_pso in prefetch mode: the same
+ * decompile and the same pipeline description, then a job instead of the
+ * compile. Worker threads compile the HLSL (shared bytecode cache) and create
+ * the pipeline; the real vp_get_fp_pso call for that draw finds the job by its
+ * full cache key, waits for it (or runs it itself if no worker has started
+ * it) and caches the result as before. Nothing is drawn differently: every
+ * draw still waits for its own pipeline. A job nobody claimed by the next
+ * batch is released. */
+typedef struct {
+    int vs_idx; u32 vs_hash, gen, fp_addr, blend; int nrt; u32 rtfmt, ctrl, uhash, cmask, cull,
+    cube_mask, unnorm_mask; u32 unnorm_dim[16][3]; u64 zs, shadow;
+} FpKey;
+typedef struct PsoJob {
+    FpKey k;
+    char* hlsl; size_t len;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; D3D12_INPUT_ELEMENT_DESC il[16];
+    ID3DBlob* vsb; ID3D12RootSignature* rs;
+    volatile LONG state;        /* 0 queued, 1 running, 2 done */
+    HANDLE done_ev;
+    ID3D12PipelineState* pso; HRESULT hr; double t_hlsl, t_pso; u64 batch;
+    struct PsoJob* qnext;
+} PsoJob;
+#define PSO_JOB_MAX 256
+static int s_pj_on = -1, s_pj_threads = 0;
+static PsoJob* s_pj[PSO_JOB_MAX]; static int s_pj_n;   /* frame thread only */
+static CRITICAL_SECTION s_pj_cs; static HANDLE s_pj_sem;
+static PsoJob *s_pj_qh, *s_pj_qt;                      /* under s_pj_cs */
+static int s_fp_prefetch = 0;                          /* vp_get_fp_pso: queue a job, build nothing */
+static u64 s_pj_batch = 0;
+static u32 s_pj_queued, s_pj_used, s_pj_inline, s_pj_dropped;
+static double s_pj_wait;
+static void pso_job_run(PsoJob* j)
+{
+    ID3DBlob* pb = NULL;
+    const double t0 = perf_now();
+    HRESULT hr = rsx_compile_cached_ex(j->hlsl, j->len, "guest_fp", "ps_5_0", &pb, 1);
+    const double t1 = perf_now();
+    ID3D12PipelineState* pso = NULL;
+    if (SUCCEEDED(hr) && pb) {
+        j->pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb);
+        j->pd.PS.BytecodeLength  = pb->lpVtbl->GetBufferSize(pb);
+        j->pd.InputLayout.pInputElementDescs = j->il;
+        hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &j->pd,
+                &IID_ID3D12PipelineState, (void**)&pso);
+        pb->lpVtbl->Release(pb);
+        if (FAILED(hr)) pso = NULL;
+    } else if (SUCCEEDED(hr)) hr = E_FAIL;
+    j->t_hlsl = t1 - t0; j->t_pso = perf_now() - t1;
+    j->pso = pso; j->hr = hr;
+    free(j->hlsl); j->hlsl = NULL;
+    j->vsb->lpVtbl->Release(j->vsb); j->vsb = NULL;
+    j->rs->lpVtbl->Release(j->rs); j->rs = NULL;
+    MemoryBarrier();
+    InterlockedExchange(&j->state, 2);
+    SetEvent(j->done_ev);
+}
+static DWORD WINAPI pso_job_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(s_pj_sem, INFINITE);
+        EnterCriticalSection(&s_pj_cs);
+        PsoJob* j = s_pj_qh;
+        if (j) { s_pj_qh = j->qnext; if (!s_pj_qh) s_pj_qt = NULL; InterlockedExchange(&j->state, 1); }
+        LeaveCriticalSection(&s_pj_cs);
+        if (j) pso_job_run(j);
+    }
+    return 0;
+}
+static int pso_par_on(void)
+{
+    if (s_pj_on < 0) {
+        const char* v = getenv("RSX_SHADER_PAR");
+        int nt = v ? atoi(v) : 4;
+        if (nt > 16) nt = 16;
+        s_pj_on = 0;
+        if (nt > 0) {
+            InitializeCriticalSection(&s_pj_cs);
+            s_pj_sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+            (void)rsx_sbc_dir(); (void)rsx_shader_fast();   /* their one-time init, before any worker */
+            int n = 0;
+            for (int i = 0; s_pj_sem && i < nt; i++) {
+                HANDLE th = CreateThread(NULL, 1024u * 1024, pso_job_worker, NULL, 0, NULL);
+                /* The frame thread's own priority: below it, a loaded PC starves
+                 * the workers while the frame thread waits for them. */
+                if (th) { SetThreadPriority(th, GetThreadPriority(GetCurrentThread())); CloseHandle(th); n++; }
+            }
+            s_pj_threads = n; s_pj_on = n > 0;
+            fprintf(stderr, "[shader] missing pipelines are built on %d worker thread(s) (RSX_SHADER_PAR=0: one at a time)%c", n, 10);
+        }
+    }
+    return s_pj_on;
+}
+static int fp_key_eq(const FpKey* a, const FpKey* b)
+{
+    return a->uhash == b->uhash && a->vs_idx == b->vs_idx && a->vs_hash == b->vs_hash && a->gen == b->gen &&
+           a->blend == b->blend && a->nrt == b->nrt && a->rtfmt == b->rtfmt && a->ctrl == b->ctrl &&
+           a->cmask == b->cmask && a->cull == b->cull && a->cube_mask == b->cube_mask && a->zs == b->zs &&
+           a->shadow == b->shadow && a->unnorm_mask == b->unnorm_mask &&
+           (!a->unnorm_mask || memcmp(a->unnorm_dim, b->unnorm_dim, sizeof a->unnorm_dim) == 0);
+}
+static int pso_job_find(const FpKey* k)
+{
+    for (int i = 0; i < s_pj_n; i++) if (fp_key_eq(&s_pj[i]->k, k)) return i;
+    return -1;
+}
+/* Frame thread: the job's pipeline (NULL on failure, *hr says why); the job is
+ * gone afterwards. A job no worker has started runs here instead of waiting. */
+static ID3D12PipelineState* pso_job_take(int i, HRESULT* hr, u32* fp_addr)
+{
+    PsoJob* j = s_pj[i];
+    s_pj[i] = s_pj[--s_pj_n];
+    const double t0 = perf_now();
+    int mine = 0;
+    EnterCriticalSection(&s_pj_cs);
+    if (j->state == 0) {   /* still queued: unlink it and build it here */
+        PsoJob** pp = &s_pj_qh; PsoJob* prev = NULL;
+        while (*pp && *pp != j) { prev = *pp; pp = &(*pp)->qnext; }
+        if (*pp) { *pp = j->qnext; if (s_pj_qt == j) s_pj_qt = prev; mine = 1; InterlockedExchange(&j->state, 1); }
+    }
+    LeaveCriticalSection(&s_pj_cs);
+    if (mine) { pso_job_run(j); s_pj_inline++; }
+    else {
+        /* Being built by a worker: build queued ones here meanwhile (they are
+         * this batch's too), so the frame thread never does less than the
+         * one-at-a-time path did. */
+        while (WaitForSingleObject(j->done_ev, 0) != WAIT_OBJECT_0) {
+            EnterCriticalSection(&s_pj_cs);
+            PsoJob* o = s_pj_qh;
+            if (o) { s_pj_qh = o->qnext; if (!s_pj_qh) s_pj_qt = NULL; InterlockedExchange(&o->state, 1); }
+            LeaveCriticalSection(&s_pj_cs);
+            if (!o) { WaitForSingleObject(j->done_ev, INFINITE); break; }
+            pso_job_run(o); s_pj_inline++;
+        }
+    }
+    MemoryBarrier();
+    const double dt = perf_now() - t0;
+    { static int _n = 0; if (PS3_LOG_FIRST(_n, 40))
+        fprintf(stderr, "[shader] pipeline fp=0x%08X: HLSL %.0f ms, driver %.0f ms on %s; frame thread waited %.0f ms%c",
+                j->k.fp_addr, j->t_hlsl * 1000.0, j->t_pso * 1000.0, mine ? "the frame thread" : "a worker",
+                dt * 1000.0, 10); }
+    s_pj_wait += dt;
+    s_hitch_pso += dt; s_hitch_npso++;   /* RSX_HITCH_MS: what the frame thread actually waited */
+    s_prof_psotime += dt; s_prof_npso++;
+    ID3D12PipelineState* pso = j->pso;
+    *hr = j->hr; *fp_addr = j->k.fp_addr;
+    CloseHandle(j->done_ev);
+    free(j);
+    s_pj_used++;
+    if (s_pj_used <= 4 || !(s_pj_used % 100))
+        fprintf(stderr, "[shader] parallel pipelines: %u queued, %u used (%u built on the frame thread),"
+                        " %u dropped, frame thread waited %.0f ms in all%c",
+                s_pj_queued, s_pj_used, s_pj_inline, s_pj_dropped, s_pj_wait * 1000.0, 10);
+    return pso;
+}
+/* Put a finished job's pipeline in the cache under its key, as vp_get_fp_pso
+ * does (oldest evicted when full). */
+static void fp_cache_insert_key(const FpKey* k, ID3D12PipelineState* pso)
+{
+    if (s_d3d.vp_fp_n >= VP_FP_CACHE) {
+        s_fp_evictions++;
+        if (s_d3d.vp_fp[0].pso) s_d3d.vp_fp[0].pso->lpVtbl->Release(s_d3d.vp_fp[0].pso);
+        memmove(&s_d3d.vp_fp[0], &s_d3d.vp_fp[1], sizeof(VPFPEntry) * (VP_FP_CACHE - 1));
+        s_d3d.vp_fp_n = VP_FP_CACHE - 1;
+    }
+    VPFPEntry* q = &s_d3d.vp_fp[s_d3d.vp_fp_n];
+    q->fp_addr = k->fp_addr; q->vs_idx = k->vs_idx; q->vs_hash = k->vs_hash; q->gen = s_d3d.vp_gen;
+    q->blend = k->blend; q->nrt = k->nrt; q->rtfmt = k->rtfmt; q->ctrl = k->ctrl; q->ucode_hash = k->uhash;
+    q->cmask = k->cmask; q->cull = k->cull; q->cube_mask = k->cube_mask; q->unnorm_mask = k->unnorm_mask;
+    memcpy(q->unnorm_dim, k->unnorm_dim, sizeof q->unnorm_dim);
+    q->zs = k->zs; q->shadow = k->shadow; q->pso = pso;
+    s_d3d.vp_fp_n++;
+}
+/* Before a batch's prefetch: a finished job from an older batch that no draw
+ * claimed (a draw the pass below skips) goes into the cache, so the next
+ * prefetch finds it instead of queueing it again; a failed one, or one built
+ * for an older vp_gen, is dropped. */
+static void pso_job_gc(void)
+{
+    int o = 0;
+    for (int i = 0; i < s_pj_n; i++) {
+        PsoJob* j = s_pj[i];
+        if (j->batch < s_pj_batch && j->state == 2) {
+            MemoryBarrier();
+            if (j->pso && j->k.gen == (u32)s_d3d.vp_gen) fp_cache_insert_key(&j->k, j->pso);
+            else { if (j->pso) j->pso->lpVtbl->Release(j->pso); s_pj_dropped++; }
+            CloseHandle(j->done_ev); free(j);
+            continue;
+        }
+        s_pj[o++] = j;
+    }
+    s_pj_n = o;
