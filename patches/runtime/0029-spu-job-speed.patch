+/* SPURS_JOB_PROF=1: per job binary, where a run's host time goes -- setup
+ * (descriptor, local store fill), the lifted run, and teardown -- with the
+ * run's trampoline steps, indirect branches and MFC commands. One line per
+ * binary every 2 s. Off: one cached load per job. */
+#ifdef _WIN32
+#include <windows.h>
+static uint64_t sjp_now_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+#else
+#include <time.h>
+static uint64_t sjp_now_ns(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+#endif
+extern SPURS_JOB_TLS uint64_t g_spu_prof_ib, g_spu_prof_dma_n, g_spu_prof_dma_bytes;
+typedef struct {
+    uint32_t bin; uint32_t n;
+    uint64_t setup, run, tear, steps, ib, dma, dmab;
+} SjpBin;
+static int sjp_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = ps3_env_once("SPURS_JOB_PROF") ? 1 : 0;
+    return v;
+}
+static void sjp_add(uint32_t bin, uint64_t setup, uint64_t run, uint64_t tear,
+                    uint64_t steps, uint64_t ib, uint64_t dma, uint64_t dmab)
+{
+#ifdef _WIN32
+    static SRWLOCK lk = SRWLOCK_INIT;
+    AcquireSRWLockExclusive(&lk);
+#endif
+    static SjpBin b[16]; static int nb; static uint64_t t_last;
+    int i = 0;
+    while (i < nb && b[i].bin != bin) i++;
+    if (i == nb && nb < 16) { b[nb].bin = bin; nb++; }
+    if (i < nb) {
+        SjpBin* s = &b[i];
+        s->n++; s->setup += setup; s->run += run; s->tear += tear;
+        s->steps += steps; s->ib += ib; s->dma += dma; s->dmab += dmab;
+    }
+    uint64_t now = sjp_now_ns();
+    if (!t_last) t_last = now;
+    if (now - t_last >= 2000000000ull) {
+        t_last = now;
+        for (int k = 0; k < nb; k++) {
+            SjpBin* s = &b[k];
+            if (!s->n) continue;
+            double n = (double)s->n;
+            fprintf(stderr, "[jobprof] bin 0x%08X: %u job(s) per job: setup %.0f us, run %.0f us,"
+                    " teardown %.0f us | steps %.0f, ib %.0f, dma %.0f (%.0f B)\n",
+                    s->bin, s->n, s->setup / n * 1e-3, s->run / n * 1e-3, s->tear / n * 1e-3,
+                    s->steps / n, s->ib / n, s->dma / n, s->dmab / n);
+            memset(&s->n, 0, sizeof *s - offsetof(SjpBin, n));
+        }
+    }
+#ifdef _WIN32
+    ReleaseSRWLockExclusive(&lk);
+#endif
+}
