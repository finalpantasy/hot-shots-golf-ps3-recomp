+/* RSX_SHOT=<dir> with RSX_SHOT_SECS=<s>[,<s>...]: write the presented
+ * backbuffer at its full size to <dir>/shot_<s>.bmp, from the first presented
+ * frame with draws once the process has run s seconds. A window capture on a
+ * hidden desktop is cut to that desktop's size, so a 4K frame cannot be judged
+ * from one. Each shot also logs the process's video memory use. Called after
+ * the frame is submitted and before Present (backbuffer in PRESENT). */
+static void rsx_shot(u32 fi)
+{
+    static int on = -1, n = 0, done = 0;
+    static double at[32];
+    static const char* dir = NULL;
+    if (on < 0) {
+        dir = getenv("RSX_SHOT");
+        const char* e = getenv("RSX_SHOT_SECS");
+        on = 0;
+        if (dir && *dir && e) {
+            while (*e && n < 32) {
+                char* end = NULL;
+                const double v = strtod(e, &end);
+                if (end == e) break;
+                at[n++] = v;
+                e = (*end == ',') ? end + 1 : end;
+            }
+            on = n > 0;
+            if (on) CreateDirectoryA(dir, NULL);
+        }
+    }
+    if (!on || done >= n) return;
+    FILETIME c, x, k, u, now;
+    GetProcessTimes(GetCurrentProcess(), &c, &x, &k, &u);
+    GetSystemTimeAsFileTime(&now);
+    const double up = (double)((((u64)now.dwHighDateTime << 32) | now.dwLowDateTime) -
+                               (((u64)c.dwHighDateTime << 32) | c.dwLowDateTime)) / 1e7;
+    if (up < at[done]) return;
+    char path[512];
+    snprintf(path, sizeof path, "%s/shot_%g.bmp", dir, at[done]);
+    while (done < n && up >= at[done]) done++;   /* one frame per due time; skip ones already passed */
+    cap_readback_write(s_d3d.render_targets[fi], s_d3d.width, s_d3d.height,
+                       DXGI_FORMAT_R8G8B8A8_UNORM, D3D12_RESOURCE_STATE_PRESENT, fi, path);
+    printf("[SHOT] %s %ux%u t=%.1fs frame=%llu draws=%u depth=%ux%u vram=%.0fMB\n", path,
+           s_d3d.width, s_d3d.height, up, (unsigned long long)s_d3d.frame_count,
+           s_dbg_last_draws, s_d3d.depth_w, s_d3d.depth_h, vram_used_mb());
+    fflush(stdout);
+}
