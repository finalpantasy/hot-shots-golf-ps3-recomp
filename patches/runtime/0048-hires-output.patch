+/* This process's local (dedicated) video memory in use, in MB; 0 if unknown. */
+static double vram_used_mb(void)
+{
+    if (!s_d3d.device) return 0.0;
+    LUID luid;
+    s_d3d.device->lpVtbl->GetAdapterLuid(s_d3d.device, &luid);
+    IDXGIFactory4* f = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f)) || !f) return 0.0;
+    IDXGIAdapter3* a = NULL;
+    double mb = 0.0;
+    if (SUCCEEDED(f->lpVtbl->EnumAdapterByLuid(f, luid, &IID_IDXGIAdapter3, (void**)&a)) && a) {
+        DXGI_QUERY_VIDEO_MEMORY_INFO mi;
+        if (SUCCEEDED(a->lpVtbl->QueryVideoMemoryInfo(a, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mi)))
+            mb = (double)mi.CurrentUsage / 1048576.0;
+        a->lpVtbl->Release(a);
+    }
+    f->lpVtbl->Release(f);
+    return mb;
+}
