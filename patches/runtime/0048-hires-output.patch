+/* Route every WPOS read through _rsx_wpos_s, which scales the host position
+ * by rsx_texscale[0].w / [1].w when they are set. Needs the cbuffer that
+ * fp_rebind_b1 declares; the helper goes right after it. */
+static int fp_apply_wpos_scale(char* hlsl, size_t cap)
+{
+    static const char from[] = "_rsx_wpos(input.position)";
+    static const char to[]   = "_rsx_wpos(_rsx_wpos_s(input.position))";
+    static const char anchor[] = "static const float4 fp_alpha = float4(0, 0, 0, 0);\n";
+    static const char helper[] =
+        "float4 _rsx_wpos_s(float4 p) {\n"
+        "    return rsx_texscale[0].w != 0.0\n"
+        "        ? float4(p.x * rsx_texscale[0].w, p.y * rsx_texscale[1].w, p.z, p.w) : p;\n"
+        "}\n";
+    if (strstr(hlsl, "_rsx_wpos_s(")) return -1;
+    char* at = strstr(hlsl, anchor);
+    if (!at) return -1;
+    size_t len = strlen(hlsl), n = 0;
+    for (const char* q = strstr(hlsl, from); q; q = strstr(q + 1, from)) n++;
+    const size_t grow = n * (sizeof to - sizeof from) + (sizeof helper - 1);
+    if (len + grow + 1 > cap) return -1;
+    /* helper after the anchor */
+    at += sizeof anchor - 1;
+    memmove(at + sizeof helper - 1, at, len - (size_t)(at - hlsl) + 1);
+    memcpy(at, helper, sizeof helper - 1);
+    len += sizeof helper - 1;
+    /* each read, back to front so earlier offsets stay valid */
+    for (char* q = strstr(at, from); q; q = strstr(q + (sizeof to - 1), from)) {
+        memmove(q + (sizeof to - 1), q + (sizeof from - 1), len - (size_t)(q - hlsl) - (sizeof from - 1) + 1);
+        memcpy(q, to, sizeof to - 1);
+        len += sizeof to - sizeof from;
+    }
+    return 1;
+}
