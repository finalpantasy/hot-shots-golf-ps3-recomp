+/* Grow the shared depth buffer to cover a w x h target. It is bound with the
+ * backbuffer and with every offscreen pass that has no depth surface of its
+ * own, and D3D12 clips rasterisation to the smallest attachment. Only called
+ * from render_frame's pre-pass: the GPU is idle (wait_for_gpu at its top) and
+ * nothing recorded so far this frame references the buffer. Never shrinks;
+ * the new buffer starts cleared. */
+static void depth_ensure(u32 w, u32 h)
+{
+    if (!s_d3d.depth_buffer || !s_d3d.device) return;
+    if (w <= s_d3d.depth_w && h <= s_d3d.depth_h) return;
+    if (w > 16384 || h > 16384) return;
+    const u32 nw = w > s_d3d.depth_w ? w : s_d3d.depth_w;
+    const u32 nh = h > s_d3d.depth_h ? h : s_d3d.depth_h;
+    D3D12_RESOURCE_DESC dd = {0};
+    s_d3d.depth_buffer->lpVtbl->GetDesc(s_d3d.depth_buffer, &dd);
+    dd.Width = nw; dd.Height = nh;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    cv.DepthStencil.Depth = 1.0f;
+    ID3D12Resource* nd = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &dd,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&nd)) || !nd) {
+        static int _n = 0; if (PS3_LOG_FIRST(_n, 2))
+            printf("[D3D12] depth buffer grow to %ux%u failed\n", nw, nh);
+        return;
+    }
+    wait_for_gpu();
+    s_d3d.depth_buffer->lpVtbl->Release(s_d3d.depth_buffer);
+    s_d3d.depth_buffer = nd;
+    s_d3d.depth_w = nw; s_d3d.depth_h = nh;
+    D3D12_DEPTH_STENCIL_VIEW_DESC dv = {0};
+    dv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    dv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    D3D12_CPU_DESCRIPTOR_HANDLE dh;
+    s_d3d.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.dsv_heap, &dh);
+    s_d3d.device->lpVtbl->CreateDepthStencilView(s_d3d.device, nd, &dv, dh);
+    if (s_dispz_pso[0]) dispz_srvs();
+    s_d3d.cmd_list->lpVtbl->ClearDepthStencilView(s_d3d.cmd_list, dh,
+        D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 1.0f, 0, 0, NULL);
+    s_dispz_gen++;
+    printf("[D3D12] depth buffer grown to %ux%u for a %ux%u target\n", nw, nh, w, h);
