 } D3D12DrawRecord;
+
+/* Does this record put visible pixels on the display? The frame-boundary
+ * gates (clear, flip, present) ask this to tell a finished frame from pass
+ * work still in progress. A depth-only pass (colour target NONE, or colour
+ * writes masked off) has rt_off 0 because it names no offscreen colour
+ * surface, yet draws nothing on screen: Hot Shots Golf renders its shadow
+ * cascades that way at the start of every gameplay frame, and counting them
+ * as display content presented the shadow pass alone as a frame (black) at
+ * the next display clear, splitting each frame in two and strobing black.
+ * RSX_DEPTH_DISPLAY=1 restores the old rule (any rt_off 0 draw counts). */
+static int dr_is_display_draw(const D3D12DrawRecord* dr)
+{
+    static int old = -1;
+    if (old < 0) old = getenv("RSX_DEPTH_DISPLAY") ? 1 : 0;
+    if (dr->is_clear || dr->rt_off != 0) return 0;
+    if (old || !dr->is_vp) return 1;   /* legacy records never fill cmask/no_color */
+    return !dr->no_color && dr->cmask != 0;
+}
 /* An indexed run (upload_tris_vp_ix) may take the next batch; cleared with the records. */
 static int s_ix_run_valid;
 
