+ * a course batch needs ~1.5M anyway, and stepping 2x at a time held three
+ * buffers at once and copied three times (a +640 MB private peak). This batch's
+ * vertices so far are copied into the new buffer's half for the current
+ * parity; the records hold offsets, not addresses, and the vertex buffer view
+ * is built from the live resource in render_frame. The old buffer may still
+ * be read by the frame the GPU is running (the other parity half), so it is
+ * released only after the next wait_for_gpu. A second grow before that point
+ * replaces a buffer no submitted frame has seen, which is released at once.
+ * On allocation failure the buffer stays as it is and batch_room splits the
+ * batch exactly as it did before. */
+static void vp_vb_release_old(void)
+{
+    if (s_vp_vb_old) { s_vp_vb_old->lpVtbl->Release(s_vp_vb_old); s_vp_vb_old = NULL; }
