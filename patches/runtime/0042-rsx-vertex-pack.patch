+/* ATTRn inputs the compiled vertex shader actually reads, from the DXBC input
+ * signature (ISGN: per element a name offset, semantic index, system value,
+ * component type, register, mask byte and read mask byte); 0xFFFFFFFF if the
+ * blob has no signature this parser understands. */
+static u32 dxbc_attr_mask(const void* blob, size_t size)
+{
+    const u8* p = (const u8*)blob;
+    if (!p || size < 32 || memcmp(p, "DXBC", 4) != 0) return 0xFFFFFFFFu;
+    u32 nchunks; memcpy(&nchunks, p + 28, 4);
+    if (32 + (size_t)nchunks * 4 > size) return 0xFFFFFFFFu;
+    for (u32 c = 0; c < nchunks; c++) {
+        u32 off; memcpy(&off, p + 32 + c * 4, 4);
+        if ((size_t)off + 8 > size) return 0xFFFFFFFFu;
+        if (memcmp(p + off, "ISGN", 4) != 0) continue;
+        u32 len; memcpy(&len, p + off + 4, 4);
+        const u8* d = p + off + 8;
+        if ((size_t)off + 8 + len > size || len < 8) return 0xFFFFFFFFu;
+        u32 n; memcpy(&n, d, 4);
+        if (8 + (size_t)n * 24 > len) return 0xFFFFFFFFu;
+        u32 mask = 0;
+        for (u32 i = 0; i < n; i++) {
+            const u8* el = d + 8 + i * 24;
+            u32 name, sem; memcpy(&name, el, 4); memcpy(&sem, el + 4, 4);
+            if ((size_t)name + 5 > len) return 0xFFFFFFFFu;
+            if (memcmp(d + name, "ATTR", 5) != 0 || sem > 15) return 0xFFFFFFFFu;
+            if (el[21]) mask |= 1u << sem;   /* read mask: components the shader uses */
+        }
+        return mask;
+    }
+    return 0xFFFFFFFFu;
+}
