+static int aspect_fit_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_ASPECT"); v = e && !strcmp(e, "fit"); }
+    return v;
+}
+
+static void display_rect(float* x, float* y, float* w, float* h)
+{
+    *x = 0.0f; *y = 0.0f;
+    *w = (float)s_d3d.width; *h = (float)s_d3d.height;
+    if (!aspect_fit_on() || !s_d3d.width || !s_d3d.height) return;
+    const float want = 16.0f / 9.0f;
+    const float have = (float)s_d3d.width / (float)s_d3d.height;
+    if (have > want) {
+        *w = (float)s_d3d.height * want;
+        *x = ((float)s_d3d.width - *w) * 0.5f;
+    } else if (have < want) {
+        *h = (float)s_d3d.width / want;
+        *y = ((float)s_d3d.height - *h) * 0.5f;
+    }
+}
