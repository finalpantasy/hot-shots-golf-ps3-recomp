+/*
+ * rsx_texrep.inc - texture dump and replacement (HD texture packs) for the
+ * D3D12 RSX backend. Included once by rsx_d3d12_backend.c, just above
+ * vp_upload_tex_slot; everything here is static and independent of the D3D12
+ * objects except the DXGI format constants the loader reports.
+ *
+ *   TEX_DUMP=<dir>      write each distinct guest texture (level 0, decoded to
+ *                       RGBA8) once as <hash16>_<w>x<h>_f<fmt>.png. Encoding
+ *                       and file I/O run on a worker thread.
+ *   TEX_REPLACE=<dir>   index <dir> (recursively) for files whose name starts
+ *                       with a 16-digit hex identity (.png gray/RGB/RGBA/palette,
+ *                       .dds BC1/BC3/BC7/RGBA8/BGRA8) and bind them in place of
+ *                       the guest data when that texture is uploaded.
+ *   TEX_REPLACE_MB=<n>  cap on GPU memory held by replacements (default 768).
+ *   TEX_DUMP_LOG=1      log one line per queued dump with its frame number.
+ *   TEX_DUMP_DELAY=<n>  frames a new texture must stay unchanged before it is
+ *                       dumped (default 30); a texture that changes four times
+ *                       in a row, each within 120 frames of the last, is dynamic
+ *                       (glyph atlas, video, read-back) and is never dumped.
+ *
+ * Identity: XXH64 of the full guest bytes of level 0 as the guest stores them,
+ * seeded with fmt/w/h. Computed only when a texture is (re)uploaded.
+ */
+
+/* ---- hashing --------------------------------------------------------- */
+#define TRP_P1 11400714785074694791ull
+#define TRP_P2 14029467366897019727ull
+#define TRP_P3 1609587929392839161ull
+#define TRP_P4 9650029242287828579ull
+#define TRP_P5 2870177450012600261ull
+static u64 trp_rotl(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+static u64 trp_rd64(const u8* p) { u64 v; memcpy(&v, p, 8); return v; }
+static u32 trp_rd32(const u8* p) { u32 v; memcpy(&v, p, 4); return v; }
+static u64 trp_xround(u64 acc, u64 in) { acc += in * TRP_P2; acc = trp_rotl(acc, 31); return acc * TRP_P1; }
+static u64 trp_xmerge(u64 acc, u64 v) { acc ^= trp_xround(0, v); return acc * TRP_P1 + TRP_P4; }
+static u64 trp_hash(const u8* p, size_t len, u64 seed)
+{
+    const u8* e = p + len;
+    u64 h;
+    if (len >= 32) {
+        u64 v1 = seed + TRP_P1 + TRP_P2, v2 = seed + TRP_P2, v3 = seed, v4 = seed - TRP_P1;
+        const u8* lim = e - 32;
+        do {
+            v1 = trp_xround(v1, trp_rd64(p)); v2 = trp_xround(v2, trp_rd64(p + 8));
+            v3 = trp_xround(v3, trp_rd64(p + 16)); v4 = trp_xround(v4, trp_rd64(p + 24));
+            p += 32;
+        } while (p <= lim);
+        h = trp_rotl(v1, 1) + trp_rotl(v2, 7) + trp_rotl(v3, 12) + trp_rotl(v4, 18);
+        h = trp_xmerge(h, v1); h = trp_xmerge(h, v2); h = trp_xmerge(h, v3); h = trp_xmerge(h, v4);
+    } else h = seed + TRP_P5;
+    h += (u64)len;
+    while (p + 8 <= e) { h ^= trp_xround(0, trp_rd64(p)); h = trp_rotl(h, 27) * TRP_P1 + TRP_P4; p += 8; }
+    if (p + 4 <= e) { h ^= (u64)trp_rd32(p) * TRP_P1; h = trp_rotl(h, 23) * TRP_P2 + TRP_P3; p += 4; }
+    while (p < e) { h ^= (u64)(*p++) * TRP_P5; h = trp_rotl(h, 11) * TRP_P1; }
+    h ^= h >> 33; h *= TRP_P2; h ^= h >> 29; h *= TRP_P3; h ^= h >> 32;
+    return h;
