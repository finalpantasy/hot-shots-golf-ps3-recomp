+/* ---- PNG write -------------------------------------------------------- */
+static void trp_be32(u8* p, u32 v) { p[0] = (u8)(v >> 24); p[1] = (u8)(v >> 16); p[2] = (u8)(v >> 8); p[3] = (u8)v; }
+static void trp_chunk(FILE* f, const char* type, const u8* d, size_t n)
+{
+    u8 hd[8]; trp_be32(hd, (u32)n); memcpy(hd + 4, type, 4); fwrite(hd, 1, 8, f);
+    u32 c = trp_crc(0, (const u8*)type, 4);
+    if (n) { fwrite(d, 1, n, f); c = trp_crc(c, d, n); }
+    u8 t[4]; trp_be32(t, c); fwrite(t, 1, 4, f);
+}
+/* rgba: w*h*4 tightly packed. Returns 1 on success. */
+static int trp_png_write(const char* path, const u8* rgba, u32 w, u32 h)
+{
+    trp_crc_init();
+    const size_t rb = (size_t)w * 4;
+    u8* raw = (u8*)malloc((rb + 1) * h);
+    if (!raw) return 0;
+    for (u32 y = 0; y < h; y++) {          /* per row: none / sub / up, smallest sum of |v| wins */
+        const u8* cur = rgba + y * rb; const u8* up = y ? cur - rb : NULL;
+        u8* o = raw + (size_t)y * (rb + 1) + 1;
+        u32 s0 = 0, s1 = 0, s2 = 0;
+        for (size_t x = 0; x < rb; x++) {
+            int a = x >= 4 ? cur[x - 4] : 0, b = up ? up[x] : 0;
+            int d1 = (u8)(cur[x] - a), d2 = (u8)(cur[x] - b);
+            s0 += cur[x] < 128 ? cur[x] : 256 - cur[x];
+            s1 += d1 < 128 ? d1 : 256 - d1; s2 += d2 < 128 ? d2 : 256 - d2;
+        }
+        int ft = 0; u32 bs = s0; if (s1 < bs) { ft = 1; bs = s1; } if (up && s2 < bs) { ft = 2; }
+        raw[(size_t)y * (rb + 1)] = (u8)ft;
+        for (size_t x = 0; x < rb; x++) {
+            int a = x >= 4 ? cur[x - 4] : 0, b = up ? up[x] : 0;
+            o[x] = ft == 0 ? cur[x] : ft == 1 ? (u8)(cur[x] - a) : (u8)(cur[x] - b);
+        }
+    }
+    TrpBW bw; memset(&bw, 0, sizeof bw);
+    int ok = trp_zlib(raw, (rb + 1) * h, &bw);
+    free(raw);
+    if (!ok) { free(bw.buf); return 0; }
+    FILE* f = fopen(path, "wb");
+    if (!f) { free(bw.buf); return 0; }
+    static const u8 sig[8] = {137, 80, 78, 71, 13, 10, 26, 10};
+    fwrite(sig, 1, 8, f);
+    u8 ih[13]; trp_be32(ih, w); trp_be32(ih + 4, h); ih[8] = 8; ih[9] = 6; ih[10] = ih[11] = ih[12] = 0;
+    trp_chunk(f, "IHDR", ih, 13); trp_chunk(f, "IDAT", bw.buf, bw.len); trp_chunk(f, "IEND", NULL, 0);
+    ok = (fclose(f) == 0);
+    free(bw.buf);
+    return ok;
+}
+
+/* ---- inflate (after zlib's puff) ---------------------------------------- */
+typedef struct { const u8* in; size_t inlen, incnt; u32 bitbuf; int bitcnt; u8* out; size_t outlen, outcnt; } TrpInf;
+typedef struct { short count[16]; short symbol[288]; } TrpHuff;
+static int trp_ibits(TrpInf* s, int need)
+{
+    u32 val = s->bitbuf;
+    while (s->bitcnt < need) {
+        if (s->incnt >= s->inlen) return -1;
+        val |= (u32)s->in[s->incnt++] << s->bitcnt; s->bitcnt += 8;
+    }
+    s->bitbuf = val >> need; s->bitcnt -= need;
+    return (int)(val & ((1u << need) - 1));
+}
+static int trp_idecode(TrpInf* s, const TrpHuff* h)
+{
+    int code = 0, first = 0, index = 0;
+    for (int len = 1; len <= 15; len++) {
+        int b = trp_ibits(s, 1); if (b < 0) return -1;
+        code |= b; int count = h->count[len];
+        if (code - count < first) return h->symbol[index + (code - first)];
+        index += count; first += count; first <<= 1; code <<= 1;
+    }
+    return -1;
+}
+static int trp_hconstruct(TrpHuff* h, const short* length, int n)
+{
+    short offs[16]; int left = 1;
+    for (int l = 0; l <= 15; l++) h->count[l] = 0;
+    for (int i = 0; i < n; i++) h->count[length[i]]++;
+    if (h->count[0] == n) return 0;
+    for (int l = 1; l <= 15; l++) { left <<= 1; left -= h->count[l]; if (left < 0) return left; }
+    offs[1] = 0; for (int l = 1; l < 15; l++) offs[l + 1] = offs[l] + h->count[l];
+    for (int i = 0; i < n; i++) if (length[i]) h->symbol[offs[length[i]]++] = (short)i;
+    return left;
+}
+static int trp_icodes(TrpInf* s, const TrpHuff* lc, const TrpHuff* dc)
+{
+    for (;;) {
+        int sym = trp_idecode(s, lc); if (sym < 0) return -1;
+        if (sym < 256) { if (s->outcnt >= s->outlen) return -1; s->out[s->outcnt++] = (u8)sym; }
+        else if (sym == 256) return 0;
+        else {
+            sym -= 257; if (sym >= 29) return -1;
+            int eb = trp_ibits(s, trp_lext[sym]); if (eb < 0) return -1;
+            u32 len = trp_lbase[sym] + (u32)eb;
+            int ds = trp_idecode(s, dc); if (ds < 0 || ds >= 30) return -1;
+            eb = trp_ibits(s, trp_dext[ds]); if (eb < 0) return -1;
+            u32 dist = trp_dbase[ds] + (u32)eb;
+            if (dist > s->outcnt || s->outcnt + len > s->outlen) return -1;
+            while (len--) { s->out[s->outcnt] = s->out[s->outcnt - dist]; s->outcnt++; }
+        }
+    }
+}
+/* Inflate a zlib stream into out[outlen]; returns bytes written or -1. */
+static long trp_inflate(const u8* in, size_t inlen, u8* out, size_t outlen)
+{
+    if (inlen < 2) return -1;
+    TrpInf s; memset(&s, 0, sizeof s); s.in = in + 2; s.inlen = inlen - 2; s.out = out; s.outlen = outlen;
+    static const short order[19] = {16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15};
+    int last;
+    do {
+        last = trp_ibits(&s, 1); int type = trp_ibits(&s, 2);
+        if (last < 0 || type < 0) return -1;
+        if (type == 0) {
+            s.bitbuf = 0; s.bitcnt = 0;
+            if (s.incnt + 4 > s.inlen) return -1;
+            u32 len = s.in[s.incnt] | (s.in[s.incnt + 1] << 8); s.incnt += 4;
+            if (s.incnt + len > s.inlen || s.outcnt + len > s.outlen) return -1;
+            memcpy(s.out + s.outcnt, s.in + s.incnt, len); s.incnt += len; s.outcnt += len;
+        } else if (type == 1) {
+            TrpHuff lc, dc; short l[288];
+            int i = 0; for (; i < 144; i++) l[i] = 8; for (; i < 256; i++) l[i] = 9;
+            for (; i < 280; i++) l[i] = 7; for (; i < 288; i++) l[i] = 8;
+            trp_hconstruct(&lc, l, 288);
+            for (i = 0; i < 30; i++) l[i] = 5;
+            trp_hconstruct(&dc, l, 30);
+            if (trp_icodes(&s, &lc, &dc)) return -1;
+        } else if (type == 2) {
+            TrpHuff lc, dc; short lens[320];
+            int nlen = trp_ibits(&s, 5) + 257, ndist = trp_ibits(&s, 5) + 1, ncode = trp_ibits(&s, 4) + 4;
+            if (nlen < 257 || ndist < 1 || ncode < 4 || nlen > 286 || ndist > 30) return -1;
+            int i = 0;
+            for (; i < ncode; i++) { int v = trp_ibits(&s, 3); if (v < 0) return -1; lens[order[i]] = (short)v; }
+            for (; i < 19; i++) lens[order[i]] = 0;
+            if (trp_hconstruct(&lc, lens, 19) != 0) return -1;
+            i = 0;
+            while (i < nlen + ndist) {
+                int sym = trp_idecode(&s, &lc); if (sym < 0) return -1;
+                if (sym < 16) lens[i++] = (short)sym;
+                else {
+                    int pl = 0, rep, eb;
+                    if (sym == 16) { if (i == 0) return -1; pl = lens[i - 1]; eb = trp_ibits(&s, 2); rep = 3 + eb; }
+                    else if (sym == 17) { eb = trp_ibits(&s, 3); rep = 3 + eb; }
+                    else { eb = trp_ibits(&s, 7); rep = 11 + eb; }
+                    if (eb < 0 || i + rep > nlen + ndist) return -1;
+                    while (rep--) lens[i++] = (short)pl;
+                }
+            }
+            if (lens[256] == 0) return -1;
+            if (trp_hconstruct(&lc, lens, nlen) < 0) return -1;
+            if (trp_hconstruct(&dc, lens + nlen, ndist) < 0) return -1;
+            if (trp_icodes(&s, &lc, &dc)) return -1;
+        } else return -1;
+    } while (!last);
+    return (long)s.outcnt;
+}
