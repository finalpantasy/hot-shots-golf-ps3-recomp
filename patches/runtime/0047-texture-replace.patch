+/* ---- images -------------------------------------------------------------- */
+#define TRP_MAXLV 15
+typedef struct {
+    u32 w, h, nlv, dxgi, blk;          /* blk: 0 = RGBA8 texels, else bytes per 4x4 block */
+    u8* lv[TRP_MAXLV]; u32 lw[TRP_MAXLV], lh[TRP_MAXLV], lrow[TRP_MAXLV], lrows[TRP_MAXLV];
+    u64 bytes;
+} TrpImage;
+static void trp_img_free(TrpImage* im) { for (u32 i = 0; i < TRP_MAXLV; i++) { free(im->lv[i]); im->lv[i] = NULL; } }
+static u32 trp_u32le(const u8* p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24); }
+static u32 trp_u32be(const u8* p) { return ((u32)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+
+/* Box-filter mips for an RGBA8 base level already in lv[0]. */
+static int trp_mips_rgba(TrpImage* im)
+{
+    u32 n = 1, w = im->w, h = im->h;
+    while ((w > 1 || h > 1) && n < TRP_MAXLV) {
+        u32 nw = w > 1 ? w >> 1 : 1, nh = h > 1 ? h >> 1 : 1;
+        u8* d = (u8*)malloc((size_t)nw * nh * 4); if (!d) return 0;
+        const u8* s = im->lv[n - 1];
+        for (u32 y = 0; y < nh; y++) for (u32 x = 0; x < nw; x++) {
+            u32 x0 = x * 2, x1 = x * 2 + 1 < w ? x * 2 + 1 : w - 1, y0 = y * 2, y1 = y * 2 + 1 < h ? y * 2 + 1 : h - 1;
+            const u8* a = s + ((size_t)y0 * w + x0) * 4; const u8* b = s + ((size_t)y0 * w + x1) * 4;
+            const u8* c = s + ((size_t)y1 * w + x0) * 4; const u8* e = s + ((size_t)y1 * w + x1) * 4;
+            for (int k = 0; k < 4; k++) d[((size_t)y * nw + x) * 4 + k] = (u8)((a[k] + b[k] + c[k] + e[k] + 2) >> 2);
+        }
+        im->lv[n] = d; im->lw[n] = nw; im->lh[n] = nh; im->lrow[n] = nw * 4; im->lrows[n] = nh;
+        im->bytes += (u64)nw * nh * 4; w = nw; h = nh; n++;
+    }
+    im->nlv = n; return 1;
+}
+
+static u8* trp_readfile(const char* path, size_t* n)
+{
+    FILE* f = fopen(path, "rb"); if (!f) return NULL;
+    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
+    if (sz <= 0 || sz > (512l << 20)) { fclose(f); return NULL; }
+    u8* b = (u8*)malloc((size_t)sz); if (!b) { fclose(f); return NULL; }
+    if (fread(b, 1, (size_t)sz, f) != (size_t)sz) { free(b); fclose(f); return NULL; }
+    fclose(f); *n = (size_t)sz; return b;
+}
+
+static int trp_png_load(const char* path, TrpImage* im)
+{
+    size_t fn; u8* f = trp_readfile(path, &fn); if (!f) return 0;
+    static const u8 sig[8] = {137, 80, 78, 71, 13, 10, 26, 10};
+    int ok = 0; u8* z = NULL; size_t zn = 0, zc = 0; u8* raw = NULL; u8* rgba = NULL;
+    u32 w = 0, h = 0, depth = 0, ct = 0, il = 0; u8 pal[256][4];
+    for (int i = 0; i < 256; i++) { pal[i][0] = pal[i][1] = pal[i][2] = 0; pal[i][3] = 255; }
