+/* ---- deflate (fixed Huffman, greedy LZ77) ------------------------------ */
+typedef struct { u8* buf; size_t len, cap; u32 acc; int nacc; int oom; } TrpBW;
+static void trp_bw_byte(TrpBW* b, u8 v)
+{
