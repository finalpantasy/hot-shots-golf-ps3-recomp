+/* ---- crc32 / adler32 -------------------------------------------------- */
+static u32 trp_crc_tab[256];
+static void trp_crc_init(void)
+{
+    if (trp_crc_tab[1]) return;
+    for (u32 n = 0; n < 256; n++) { u32 c = n; for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1; trp_crc_tab[n] = c; }
+}
+static u32 trp_crc(u32 c, const u8* p, size_t n)
+{
+    c = ~c; while (n--) c = trp_crc_tab[(c ^ *p++) & 255] ^ (c >> 8); return ~c;
+}
+static u32 trp_adler(const u8* p, size_t n)
+{
+    u32 a = 1, b = 0;
+    while (n) { size_t k = n > 5552 ? 5552 : n; n -= k; while (k--) { a += *p++; b += a; } a %= 65521u; b %= 65521u; }
+    return (b << 16) | a;
+}
