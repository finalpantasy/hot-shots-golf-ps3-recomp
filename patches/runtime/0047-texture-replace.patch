+        u32 len = trp_u32be(f + p); const u8* ty = f + p + 4; const u8* d = f + p + 8;
+        if ((size_t)len + 12 > fn - p) goto done;
+        if (!memcmp(ty, "IHDR", 4) && len >= 13) { w = trp_u32be(d); h = trp_u32be(d + 4); depth = d[8]; ct = d[9]; il = d[12]; }
+        else if (!memcmp(ty, "PLTE", 4)) { int np = (int)(len / 3 > 256 ? 256 : len / 3); for (int i = 0; i < np; i++) { pal[i][0] = d[i*3]; pal[i][1] = d[i*3+1]; pal[i][2] = d[i*3+2]; } }
+        else if (!memcmp(ty, "tRNS", 4) && ct == 3) { for (u32 i = 0; i < len && i < 256; i++) pal[i][3] = d[i]; }
+        else if (!memcmp(ty, "IDAT", 4)) {
+            if (zn + len > zc) { zc = (zn + len) * 2; u8* nz = (u8*)realloc(z, zc); if (!nz) goto done; z = nz; }
+            memcpy(z + zn, d, len); zn += len;
+        } else if (!memcmp(ty, "IEND", 4)) break;
+        p += 12 + (size_t)len;
+    }
+    if (!w || !h || w > 16384 || h > 16384 || il || !z) goto done;
+    { u32 ch = ct == 0 ? 1 : ct == 2 ? 3 : ct == 3 ? 1 : ct == 4 ? 2 : ct == 6 ? 4 : 0;
+      if (!ch || (depth != 8 && !(depth == 16 && ct != 3))) goto done;
+      u32 bpp = ch * (depth / 8); size_t rb = (size_t)w * bpp;
+      raw = (u8*)malloc((rb + 1) * h); if (!raw) goto done;
+      long got = trp_inflate(z, zn, raw, (rb + 1) * h); if (got < (long)((rb + 1) * h)) goto done;
+      for (u32 y = 0; y < h; y++) {                       /* unfilter in place */
+          u8* row = raw + (size_t)y * (rb + 1); int ft = row[0]; u8* cur = row + 1; const u8* up = y ? row - rb : NULL;
+          for (size_t x = 0; x < rb; x++) {
+              int a = x >= bpp ? cur[x - bpp] : 0, b = up ? up[x] : 0, c = (up && x >= bpp) ? up[x - bpp] : 0, v = cur[x];
+              switch (ft) { case 1: v += a; break; case 2: v += b; break; case 3: v += (a + b) >> 1; break;
+                  case 4: { int pp = a + b - c, pa = abs(pp - a), pb = abs(pp - b), pc = abs(pp - c);
+                            v += (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c); break; }
+                  default: break; }
+              cur[x] = (u8)v;
+          }
+      }
+      rgba = (u8*)malloc((size_t)w * h * 4); if (!rgba) goto done;
+      for (u32 y = 0; y < h; y++) for (u32 x = 0; x < w; x++) {
+          const u8* s = raw + (size_t)y * (rb + 1) + 1 + (size_t)x * bpp; u8* o = rgba + ((size_t)y * w + x) * 4; u32 st = depth / 8;
+          switch (ct) {
+              case 0: o[0] = o[1] = o[2] = s[0]; o[3] = 255; break;
+              case 2: o[0] = s[0]; o[1] = s[st]; o[2] = s[2*st]; o[3] = 255; break;
+              case 3: { int i = s[0]; o[0] = pal[i][0]; o[1] = pal[i][1]; o[2] = pal[i][2]; o[3] = pal[i][3]; break; }
+              case 4: o[0] = o[1] = o[2] = s[0]; o[3] = s[st]; break;
+              default: o[0] = s[0]; o[1] = s[st]; o[2] = s[2*st]; o[3] = s[3*st]; break;
+          }
+      }
+    }
+    memset(im, 0, sizeof *im);
+    im->w = w; im->h = h; im->dxgi = DXGI_FORMAT_R8G8B8A8_UNORM; im->blk = 0;
+    im->lv[0] = rgba; rgba = NULL; im->lw[0] = w; im->lh[0] = h; im->lrow[0] = w * 4; im->lrows[0] = h; im->nlv = 1; im->bytes = (u64)w * h * 4;
+    if (!trp_mips_rgba(im)) { trp_img_free(im); goto done; }
+    ok = 1;
+done:
+    free(f); free(z); free(raw); free(rgba);
+    return ok;
+}
+
+static int trp_dds_load(const char* path, TrpImage* im)
+{
+    size_t fn; u8* f = trp_readfile(path, &fn); if (!f) return 0;
+    int ok = 0;
+    u32 h, w, mc, pff, bits, rm, bm, am; size_t dp = 128; u32 dx = 0, blk = 0, swap = 0, noalpha = 0;
+    if (fn < 128 || memcmp(f, "DDS ", 4) || trp_u32le(f + 4) != 124) goto done;
+    h = trp_u32le(f + 12); w = trp_u32le(f + 16); mc = trp_u32le(f + 28);
+    pff = trp_u32le(f + 80); bits = trp_u32le(f + 88);
+    rm = trp_u32le(f + 92); bm = trp_u32le(f + 100); am = trp_u32le(f + 104);
+    if (!w || !h || w > 16384 || h > 16384) goto done;
+    if (!memcmp(f + 84, "DX10", 4)) {
+        if (fn < 148) goto done;
+        { u32 df = trp_u32le(f + 128); dp = 148;
+          if (df == 71) { dx = DXGI_FORMAT_BC1_UNORM; blk = 8; }
+          else if (df == 77) { dx = DXGI_FORMAT_BC3_UNORM; blk = 16; }
+          else if (df == 98) { dx = DXGI_FORMAT_BC7_UNORM; blk = 16; }
+          else if (df == 28) { dx = DXGI_FORMAT_R8G8B8A8_UNORM; }
+          else if (df == 87) { dx = DXGI_FORMAT_R8G8B8A8_UNORM; swap = 1; }
+          else goto done; }
+    } else if (pff & 4) {
+        if (!memcmp(f + 84, "DXT1", 4)) { dx = DXGI_FORMAT_BC1_UNORM; blk = 8; }
+        else if (!memcmp(f + 84, "DXT5", 4)) { dx = DXGI_FORMAT_BC3_UNORM; blk = 16; }
+        else goto done;
+    } else if ((pff & 0x40) && bits == 32) {
+        dx = DXGI_FORMAT_R8G8B8A8_UNORM; noalpha = !(pff & 1) || !am;
+        if (rm == 0x000000FFu && bm == 0x00FF0000u) swap = 0;
+        else if (rm == 0x00FF0000u && bm == 0x000000FFu) swap = 1;
+        else goto done;
+    } else goto done;
+    if (blk && ((w & 3) || (h & 3))) goto done;
+    memset(im, 0, sizeof *im); im->w = w; im->h = h; im->dxgi = dx; im->blk = blk;
+    { u32 maxlv = 1; u32 a = w > h ? w : h; while (a > 1) { a >>= 1; maxlv++; }
+      if (!mc) mc = 1; if (mc > maxlv) mc = maxlv; if (mc > TRP_MAXLV) mc = TRP_MAXLV; }
+    { u32 lw = w, lh = h; size_t pos = dp; u32 n = 0;
+      for (; n < mc; n++) {
+          u32 bw2 = (lw + 3) / 4, bh2 = (lh + 3) / 4;
+          size_t row = blk ? (size_t)bw2 * blk : (size_t)lw * 4, rows = blk ? bh2 : lh, sz = row * rows;
+          if (pos + sz > fn) break;
+          u8* d = (u8*)malloc(sz); if (!d) break;
+          memcpy(d, f + pos, sz); pos += sz;
+          if (!blk && (swap || noalpha)) for (size_t i = 0; i < sz; i += 4) {
+              if (swap) { u8 t = d[i]; d[i] = d[i + 2]; d[i + 2] = t; }
+              if (noalpha) d[i + 3] = 255;
+          }
+          im->lv[n] = d; im->lw[n] = lw; im->lh[n] = lh; im->lrow[n] = (u32)row; im->lrows[n] = (u32)rows; im->bytes += sz;
+          if (lw > 1) lw >>= 1;
+          if (lh > 1) lh >>= 1;
+      }
+      im->nlv = n;
+      if (!n) { trp_img_free(im); goto done; }
+      if (!blk && n == 1 && !trp_mips_rgba(im)) { trp_img_free(im); goto done; } }
+    ok = 1;
+done:
+    free(f);
+    return ok;
+}
+
+/* ---- BC1/2/3 to RGBA8 (for dumping) ---------------------------------------- */
+static void trp_bc_color(const u8* b, u8 out[16][4], int force4)
+{
+    u32 c0 = b[0] | (b[1] << 8), c1 = b[2] | (b[3] << 8); u8 p[4][4];
+    for (int k = 0; k < 2; k++) {
+        u32 c = k ? c1 : c0;
+        p[k][0] = (u8)(((c >> 11) & 31) * 255 / 31); p[k][1] = (u8)(((c >> 5) & 63) * 255 / 63); p[k][2] = (u8)((c & 31) * 255 / 31); p[k][3] = 255;
+    }
+    if (c0 > c1 || force4) {
+        for (int k = 0; k < 3; k++) { p[2][k] = (u8)((2 * p[0][k] + p[1][k]) / 3); p[3][k] = (u8)((p[0][k] + 2 * p[1][k]) / 3); }
+        p[2][3] = p[3][3] = 255;
+    } else {
+        for (int k = 0; k < 3; k++) p[2][k] = (u8)((p[0][k] + p[1][k]) / 2);
+        p[2][3] = 255; p[3][0] = p[3][1] = p[3][2] = 0; p[3][3] = 0;
+    }
+    u32 idx = trp_u32le(b + 4);
+    for (int i = 0; i < 16; i++) memcpy(out[i], p[(idx >> (2 * i)) & 3], 4);
+}
+static void trp_bc_decode(u8* rgba, const u8* src, u32 w, u32 h, int kind /* 1,2,3 */)
+{
+    const u32 bw = (w + 3) / 4, bh = (h + 3) / 4, bsz = kind == 1 ? 8 : 16;
+    for (u32 by = 0; by < bh; by++) for (u32 bx = 0; bx < bw; bx++) {
+        const u8* b = src + ((size_t)by * bw + bx) * bsz; u8 px[16][4]; u8 al[16];
+        trp_bc_color(kind == 1 ? b : b + 8, px, kind != 1);
+        if (kind == 2) for (int i = 0; i < 16; i++) { u8 v = (b[i >> 1] >> ((i & 1) * 4)) & 15; al[i] = (u8)(v * 17); }
+        else if (kind == 3) {
+            u8 a[8]; a[0] = b[0]; a[1] = b[1];
+            if (a[0] > a[1]) for (int k = 1; k < 7; k++) a[k + 1] = (u8)(((7 - k) * a[0] + k * a[1]) / 7);
+            else { for (int k = 1; k < 5; k++) a[k + 1] = (u8)(((5 - k) * a[0] + k * a[1]) / 5); a[6] = 0; a[7] = 255; }
+            u64 bits = 0; for (int i = 0; i < 6; i++) bits |= (u64)b[2 + i] << (8 * i);
+            for (int i = 0; i < 16; i++) al[i] = a[(bits >> (3 * i)) & 7];
+        }
+        for (u32 y = 0; y < 4 && by * 4 + y < h; y++) for (u32 x = 0; x < 4 && bx * 4 + x < w; x++) {
+            u8* o = rgba + ((size_t)(by * 4 + y) * w + bx * 4 + x) * 4; memcpy(o, px[y * 4 + x], 4);
+            if (kind != 1) o[3] = al[y * 4 + x];
+        }
+    }
+}
+
+/* ---- state ---------------------------------------------------------------------- */
+typedef struct { u64 hash; char* path; int dds; int failed; } TrpEntry;
+typedef struct TrpJob { struct TrpJob* next; u8* data; int kind; u32 w, h, fmt; u64 hash; } TrpJob;
+typedef struct { u32 off, w, h, fmt; u64 hash; u64 frame; int streak, pend, used; } TrpKey;
+typedef struct { u64 hash; u32 w, h, fmt; int kind; u8* data; u64 frame; int key, used; } TrpPend;
+#define TRP_KEYS 16384
+#define TRP_PENDS 2048
+#define TRP_SET 65536
+static int trp_state = -1;                   /* -1 not initialised, 0 off, 1 on */
+static int trp_dump_on, trp_repl_on, trp_delay = 30;
+static char trp_dump_dir[MAX_PATH], trp_repl_dir[MAX_PATH];
+static TrpEntry* trp_idx; static u32 trp_nidx;
+static u64 trp_cap_bytes = 768ull << 20;
+static u64* trp_set;                         /* hashes already queued for dumping */
+static TrpKey* trp_keys; static TrpPend* trp_pends; static u32 trp_npend; static u64 trp_pend_bytes;
+static CRITICAL_SECTION trp_cs; static HANDLE trp_ev; static TrpJob *trp_qh, *trp_qt; static u64 trp_qbytes;
+static volatile LONG trp_written, trp_exists, trp_failed;
+static u32 trp_dropped, trp_dyn_keys, trp_skip_fmt, trp_replaced, trp_repl_fail, trp_over_cap, trp_seen;
+static u32 trp_last_w, trp_last_r; static u64 trp_last_stat, trp_frame; static int trp_verbose; static double trp_ms;   /* total time spent hashing/observing/replacing on the render thread */
+
+static u64 trp_job_bytes(int kind, u32 w, u32 h) { return kind == 0 ? (u64)w * h * 4 : (u64)((w + 3) / 4) * ((h + 3) / 4) * (kind == 1 ? 8 : 16); }
+static int trp_set_has(u64 h) { if (!h) h = 1; for (u32 i = (u32)h & (TRP_SET - 1);; i = (i + 1) & (TRP_SET - 1)) { if (!trp_set[i]) return 0; if (trp_set[i] == h) return 1; } }
+static int trp_set_add(u64 h)
+{
+    static u32 n; if (!h) h = 1; if (n > TRP_SET * 3 / 4) return 0;
+    for (u32 i = (u32)h & (TRP_SET - 1);; i = (i + 1) & (TRP_SET - 1)) { if (!trp_set[i]) { trp_set[i] = h; n++; return 1; } if (trp_set[i] == h) return 1; }
+}
+static void trp_mkdirs(const char* path)
+{
+    char t[MAX_PATH]; strncpy(t, path, MAX_PATH - 1); t[MAX_PATH - 1] = 0;
+    for (char* p = t + 1; *p; p++) if (*p == '\\' || *p == '/') { char c = *p; *p = 0; CreateDirectoryA(t, NULL); *p = c; }
+    CreateDirectoryA(t, NULL);
+}
+
+/* worker: convert to RGBA, encode PNG, write <dir>\<name>.png via a temp name */
+static DWORD WINAPI trp_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(trp_ev, INFINITE);
+        for (;;) {
+            EnterCriticalSection(&trp_cs);
+            TrpJob* j = trp_qh; if (j) { trp_qh = j->next; if (!trp_qh) trp_qt = NULL; }
+            LeaveCriticalSection(&trp_cs);
+            if (!j) break;
+            char name[MAX_PATH], tmp[MAX_PATH];
+            snprintf(name, sizeof name, "%s\\%016llx_%ux%u_f%02x.png", trp_dump_dir, (unsigned long long)j->hash, j->w, j->h, j->fmt & 0xFF);
+            snprintf(tmp, sizeof tmp, "%s.tmp", name);
+            if (GetFileAttributesA(name) != INVALID_FILE_ATTRIBUTES) InterlockedIncrement(&trp_exists);
+            else {
+                u8* rgba = NULL; int ok = 0;
+                if (j->kind == 0) { rgba = j->data; j->data = NULL; }
+                else { rgba = (u8*)malloc((size_t)j->w * j->h * 4); if (rgba) trp_bc_decode(rgba, j->data, j->w, j->h, j->kind); }
+                if (rgba) ok = trp_png_write(tmp, rgba, j->w, j->h) && MoveFileExA(tmp, name, MOVEFILE_REPLACE_EXISTING);
+                free(rgba);
+                if (ok) InterlockedIncrement(&trp_written); else { DeleteFileA(tmp); InterlockedIncrement(&trp_failed); }
+            }
+            free(j->data);
+            { const u64 jb = trp_job_bytes(j->kind, j->w, j->h);
+              EnterCriticalSection(&trp_cs); trp_qbytes = trp_qbytes > jb ? trp_qbytes - jb : 0; LeaveCriticalSection(&trp_cs); }
+            free(j);
+        }
+    }
+    return 0;
+}
+
+static int trp_idx_cmp(const void* a, const void* b)
+{
+    const TrpEntry* x = (const TrpEntry*)a; const TrpEntry* y = (const TrpEntry*)b;
+    if (x->hash != y->hash) return x->hash < y->hash ? -1 : 1;
+    return y->dds - x->dds;                  /* DDS first when both exist */
+}
+static void trp_scan(const char* dir, int depth)
+{
+    char pat[MAX_PATH]; snprintf(pat, sizeof pat, "%s\\*", dir);
+    WIN32_FIND_DATAA fd; HANDLE h = FindFirstFileA(pat, &fd); if (h == INVALID_HANDLE_VALUE) return;
+    do {
+        if (fd.cFileName[0] == '.') continue;
+        char full[MAX_PATH]; snprintf(full, sizeof full, "%s\\%s", dir, fd.cFileName);
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) { if (depth < 4) trp_scan(full, depth + 1); continue; }
+        size_t n = strlen(fd.cFileName); if (n < 20) continue;
+        const char* ext = fd.cFileName + n - 4; int dds = !_stricmp(ext, ".dds");
+        if (!dds && _stricmp(ext, ".png")) continue;
+        u64 hv = 0; int okh = 1;
+        for (int i = 0; i < 16; i++) { char c = fd.cFileName[i]; int d = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1; if (d < 0) { okh = 0; break; } hv = (hv << 4) | (u64)d; }
+        if (!okh || trp_nidx >= 65536) continue;
+        if (!(trp_nidx & 255)) { TrpEntry* ni = (TrpEntry*)realloc(trp_idx, sizeof(TrpEntry) * (trp_nidx + 256)); if (!ni) continue; trp_idx = ni; }
+        trp_idx[trp_nidx].hash = hv; trp_idx[trp_nidx].path = _strdup(full); trp_idx[trp_nidx].dds = dds; trp_idx[trp_nidx].failed = 0; trp_nidx++;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+}
+static TrpEntry* trp_find(u64 hash)
+{
+    u32 lo = 0, hi = trp_nidx;
+    while (lo < hi) { u32 m = (lo + hi) / 2; if (trp_idx[m].hash < hash) lo = m + 1; else hi = m; }
+    return (lo < trp_nidx && trp_idx[lo].hash == hash) ? &trp_idx[lo] : NULL;
+}
+static void trp_report(const char* why)
+{
+    if (trp_dump_on) fprintf(stderr, "[texdump] %s (frame %llu): seen %u, written %ld, existed %ld, failed %ld, dropped %u, dynamic-skipped %u, unsupported-fmt %u, pending %u, render-thread cost %.1f ms\n",
+        why, (unsigned long long)trp_frame, trp_seen, (long)trp_written, (long)trp_exists, (long)trp_failed, trp_dropped, trp_dyn_keys, trp_skip_fmt, trp_npend, trp_ms);
+    if (trp_repl_on) fprintf(stderr, "[texrep] %s: indexed %u, replaced %u (load failures %u, over cap %u, render-thread cost %.1f ms)\n", why, trp_nidx, trp_replaced, trp_repl_fail, trp_over_cap, trp_ms);
+    fflush(stderr);
+}
+static void trp_atexit(void) { trp_report("exit"); }
+
+static int trp_active(void)
+{
+    if (trp_state >= 0) return trp_state;
+    trp_state = 0;
+    const char* d = getenv("TEX_DUMP"); const char* r = getenv("TEX_REPLACE");
+    if (d && d[0]) { strncpy(trp_dump_dir, d, MAX_PATH - 2); trp_dump_on = 1; }
+    if (r && r[0]) { strncpy(trp_repl_dir, r, MAX_PATH - 2); trp_repl_on = 1; }
+    if (!trp_dump_on && !trp_repl_on) return 0;
+    for (char* p = trp_dump_dir; *p; p++) if (*p == '/') *p = '\\';
+    for (char* p = trp_repl_dir; *p; p++) if (*p == '/') *p = '\\';
+    for (size_t n = strlen(trp_dump_dir); n > 3 && trp_dump_dir[n - 1] == '\\'; n--) trp_dump_dir[n - 1] = 0;
+    for (size_t n = strlen(trp_repl_dir); n > 3 && trp_repl_dir[n - 1] == '\\'; n--) trp_repl_dir[n - 1] = 0;
+    const char* e = getenv("TEX_REPLACE_MB"); if (e && atoi(e) > 0) trp_cap_bytes = (u64)atoi(e) << 20;
+    e = getenv("TEX_DUMP_LOG"); trp_verbose = e && atoi(e) > 0;
+    e = getenv("TEX_DUMP_DELAY"); if (e && atoi(e) >= 0) trp_delay = atoi(e);
+    trp_crc_init();
+    if (trp_dump_on) {
+        trp_mkdirs(trp_dump_dir);
+        trp_set = (u64*)calloc(TRP_SET, sizeof(u64));
+        trp_keys = (TrpKey*)calloc(TRP_KEYS, sizeof(TrpKey));
+        trp_pends = (TrpPend*)calloc(TRP_PENDS, sizeof(TrpPend));
+        InitializeCriticalSection(&trp_cs); trp_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+        HANDLE th = CreateThread(NULL, 0, trp_worker, NULL, 0, NULL);
+        if (!trp_set || !trp_keys || !trp_pends || !th) { trp_dump_on = 0; fprintf(stderr, "[texdump] init failed, dumping off\n"); }
+        else { SetThreadPriority(th, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(th); fprintf(stderr, "[texdump] dumping to %s (delay %d frames)\n", trp_dump_dir, trp_delay); }
+    }
+    if (trp_repl_on) {
+        trp_scan(trp_repl_dir, 0);
+        qsort(trp_idx, trp_nidx, sizeof(TrpEntry), trp_idx_cmp);
+        u32 o = 0; for (u32 i = 0; i < trp_nidx; i++) { if (o && trp_idx[o - 1].hash == trp_idx[i].hash) { free(trp_idx[i].path); continue; } trp_idx[o++] = trp_idx[i]; }
+        trp_nidx = o;
+        fprintf(stderr, "[texrep] indexed %u, replaced 0 (dir %s, cap %llu MB)\n", trp_nidx, trp_repl_dir, (unsigned long long)(trp_cap_bytes >> 20));
+    }
+    trp_state = trp_dump_on || trp_repl_on;
+    if (trp_state) atexit(trp_atexit);
+    return trp_state;
+}
+
+static void trp_pend_free(int i)
+{
+    TrpPend* p = &trp_pends[i]; if (!p->used) return;
+    trp_pend_bytes -= trp_job_bytes(p->kind, p->w, p->h); free(p->data); p->data = NULL; p->used = 0; trp_npend--;
+}
+
+/* A texture was (re)uploaded: `hash` is its identity. Tracks whether it keeps
+ * changing, and queues a dump of it once it has stayed unchanged for the delay.
+ * tl->fmt must be RGBA8 or BC1/2/3 (the caller filters). */
+static void trp_observe(u32 off, u32 w, u32 h, u32 fmt, u64 hash, const rsx_tex_layout* tl, const u8* src, u64 frame)
+{
+    trp_seen++;
+    if (!trp_dump_on) return;
+    const u32 ki = ((off * 0x9E3779B1u) ^ (w * 0x85EBCA77u) ^ (h * 0xC2B2AE3Du) ^ (fmt * 0x27D4EB2Fu)) >> 18;
+    TrpKey* k = &trp_keys[ki];
+    if (k->used && (k->off != off || k->w != w || k->h != h || k->fmt != fmt)) {
+        if (k->pend >= 0) trp_pend_free(k->pend);
+        k->used = 0;
+    }
+    if (!k->used) { memset(k, 0, sizeof *k); k->used = 1; k->off = off; k->w = w; k->h = h; k->fmt = fmt; k->hash = hash; k->frame = frame; k->pend = -1; }
+    else if (k->hash != hash) {
+        k->streak = (frame - k->frame < 120) ? k->streak + 1 : 1;
+        k->frame = frame; k->hash = hash;
+        if (k->pend >= 0) { trp_pend_free(k->pend); k->pend = -1; }
+    } else return;
+    if (k->streak >= 4) { if (k->streak == 4) trp_dyn_keys++; return; }
+    if (trp_set_has(hash)) return;
+    const int kind = tl->fmt == RSX_TEXFMT_BC1 ? 1 : tl->fmt == RSX_TEXFMT_BC2 ? 2 : tl->fmt == RSX_TEXFMT_BC3 ? 3 : 0;
+    const u64 nb = trp_job_bytes(kind, w, h);
+    if (trp_pend_bytes + nb > (256ull << 20)) { trp_dropped++; return; }
+    int slot = -1; for (int i = 0; i < TRP_PENDS; i++) if (!trp_pends[i].used) { slot = i; break; }
+    if (slot < 0) { trp_dropped++; return; }
+    u8* d = (u8*)malloc((size_t)nb); if (!d) { trp_dropped++; return; }
+    rsx_texture_decode(d, kind ? tl->row_bytes : w * 4, src, w, h, tl, rsx_texture_argb_is_rgba());
+    TrpPend* p = &trp_pends[slot];
+    p->hash = hash; p->w = w; p->h = h; p->fmt = fmt; p->kind = kind; p->data = d; p->frame = frame; p->key = (int)ki; p->used = 1;
+    k->pend = slot; trp_npend++; trp_pend_bytes += nb;
+}
+
+/* Once per frame: hand finished pendings to the worker, and print stats. */
+static void trp_tick(u64 frame)
+{
+    if (!trp_state) return;
+    trp_frame = frame;
+    if (trp_dump_on && trp_npend) {
+        for (int i = 0; i < TRP_PENDS; i++) {
+            TrpPend* p = &trp_pends[i];
+            if (!p->used || frame < p->frame + (u64)trp_delay) continue;
+            if (trp_keys[p->key].pend == i) trp_keys[p->key].pend = -1;
+            const u64 jb = trp_job_bytes(p->kind, p->w, p->h);
+            int queue = !trp_set_has(p->hash);
+            if (queue) { EnterCriticalSection(&trp_cs); if (trp_qbytes + jb > (384ull << 20)) queue = 0; LeaveCriticalSection(&trp_cs); if (!queue) trp_dropped++; }
+            if (queue && trp_set_add(p->hash)) {
+                TrpJob* j = (TrpJob*)calloc(1, sizeof *j);
+                if (j) {
+                    j->data = p->data; p->data = NULL; j->kind = p->kind; j->w = p->w; j->h = p->h; j->fmt = p->fmt; j->hash = p->hash;
+                    if (trp_verbose) fprintf(stderr, "[texdump] f%llu %016llx_%ux%u_f%02x\n", (unsigned long long)frame, (unsigned long long)p->hash, j->w, j->h, j->fmt & 0xFF);
+                    EnterCriticalSection(&trp_cs); trp_qbytes += jb; if (trp_qt) trp_qt->next = j; else trp_qh = j; trp_qt = j; LeaveCriticalSection(&trp_cs);
+                    SetEvent(trp_ev);
+                }
+            }
+            trp_pend_free(i);
+        }
+    }
+    if (frame >= trp_last_stat + 900) {
+        trp_last_stat = frame;
+        if ((u32)trp_written != trp_last_w || trp_replaced != trp_last_r) { trp_last_w = (u32)trp_written; trp_last_r = trp_replaced; trp_report("progress"); }
+    }
+}
