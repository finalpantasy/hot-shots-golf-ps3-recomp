+/* Depth-format textures (0x90..0x93) are recorded and sampled from the depth
+ * surface they name, with the RSX depth comparison when the unit sets one.
+ * RSX_DEPTH_TEX=0 drops them as before. */
+static int rsx_depth_tex_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_DEPTH_TEX"); on = (e && e[0] == '0') ? 0 : 1; }
+    return on;
+}
+
+/* Depth comparison per unit, 4 bits each: the RSX ADDRESS zfunc (1..6) and
+ * whether the unit filters linearly (bit 3). 0 = the unit returns what it
+ * reads. A depth-format unit with a zfunc returns the comparison of the
+ * stored depth with the coordinate's z (0 or 1, filtered), not the depth.
+ * Layouts the decompiler cannot translate (float depth, cubes, mips,
+ * unnormalized coordinates) stay uncompared. */
+static u64 dr_shadow_key(const D3D12DrawRecord* dr)
+{
+    u64 key = 0;
+    if (!rsx_depth_tex_on()) return 0;
+    for (int u = 0; u < 16; u++) {
+        const u32 bf = dr->tex[u].fmt & 0x9Fu;
+        if (!dr->tex[u].set || bf < 0x90 || bf > 0x93) continue;
+        rsx_fp_shadow_desc d;
+        /* tex[].mips holds the format word's level count. */
+        rsx_fp_shadow_desc_from_texture(&d, dr->tex[u].fmt, 2, dr->tex[u].cube,
+                                        dr->tex[u].mips, dr->tex[u].filter,
+                                        dr->tex[u].addr, dr->tex[u].ctrl0);
+        if (d.enabled != 1 || d.unnormalized) {
+            if (d.enabled) { static int _n = 0; if (PS3_LOG_FIRST(_n, 4))
+                fprintf(stderr, "[RSX depthtex] unit %d fmt=0x%02X compare not translated%c",
+                        u, dr->tex[u].fmt, 10); }
+            continue;
+        }
+        key |= (u64)((d.func & 7u) | (d.linear ? 8u : 0u)) << (u * 4);
+    }
+    return key;
+}
+
+static void shadow_key_descs(u64 key, rsx_fp_shadow_desc out[16])
+{
+    for (int u = 0; u < 16; u++) {
+        const u32 v = (u32)(key >> (u * 4)) & 15u;
+        out[u].enabled = (v & 7u) ? 1 : 0;
+        out[u].func = (u8)(v & 7u);
+        out[u].linear = (u8)((v >> 3) & 1u);
+        out[u].unnormalized = 0;
+    }
+}
