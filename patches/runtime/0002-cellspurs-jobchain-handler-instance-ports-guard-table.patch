+/* cellSpursJobChainSetExceptionEventHandler(CellSpursJobChain* jobChain,
+ *     CellSpursJobChainExceptionEventHandler handler, void* arg)
+ *
+ * The CellSpursJobChain struct is opaque to the title and this module does not
+ * model its internal layout, so the handler (a guest OPD EA) and its arg are
+ * kept in a host-side table keyed by the chain EA, next to s_jobchains. The
+ * chain walker raises no SPU exceptions, so the handler is recorded but never
+ * invoked; a NULL handler clears the registration. */
+#define MAX_JC_EXC 32
+static struct {
+    u32 jc_ea;       /* CellSpursJobChain EA (0 = free) */
+    u32 handler_ea;  /* guest function descriptor EA */
+    u32 arg_ea;      /* guest void* passed back to the handler */
+} s_jc_exc[MAX_JC_EXC];
+
+s32 cellSpursJobChainSetExceptionEventHandler(u64 jc_ea, u64 handler_ea, u64 arg_ea)
+{
+    static int _n = 0;
+    if (PS3_LOG_FIRST(_n, 4))
+        printf("[cellSpurs] JobChainSetExceptionEventHandler(jc=0x%08X handler=0x%08X arg=0x%08X)\n",
+               (u32)jc_ea, (u32)handler_ea, (u32)arg_ea);
+    if (!jc_ea) return CELL_SPURS_JOB_ERROR_NULL_POINTER;
+    if (jc_ea & 0x7Fu) return CELL_SPURS_JOB_ERROR_ALIGN;   /* CellSpursJobChain is 128-byte aligned */
+
+    int free_slot = -1;
+    for (int i = 0; i < MAX_JC_EXC; i++) {
+        if (s_jc_exc[i].jc_ea == (u32)jc_ea) {
+            if (!handler_ea) { s_jc_exc[i].jc_ea = 0; s_jc_exc[i].handler_ea = 0; s_jc_exc[i].arg_ea = 0; }
+            else { s_jc_exc[i].handler_ea = (u32)handler_ea; s_jc_exc[i].arg_ea = (u32)arg_ea; }
+            return CELL_OK;
+        }
+        if (!s_jc_exc[i].jc_ea && free_slot < 0) free_slot = i;
+    }
+    if (!handler_ea) return CELL_OK;           /* nothing registered, nothing to clear */
+    if (free_slot < 0) return CELL_SPURS_JOB_ERROR_NOMEM;
+    s_jc_exc[free_slot].jc_ea      = (u32)jc_ea;
+    s_jc_exc[free_slot].handler_ea = (u32)handler_ea;
+    s_jc_exc[free_slot].arg_ea     = (u32)arg_ea;
+    return CELL_OK;
+}
