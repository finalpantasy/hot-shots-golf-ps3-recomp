+/* RSX_VS_PAR: is this text already compiled, in memory or on disk? Same
+ * key and path as rsx_compile_cached_ex. */
+static int rsx_sbc_has(const char* src, size_t len, const char* target)
+{
+    u64 h1 = 14695981039346656037ull, h2 = 0x9E3779B97F4A7C15ull;
+    for (size_t i = 0; i < len; i++) {
+        h1 = (h1 ^ (u8)src[i]) * 1099511628211ull;
+        h2 = (h2 + (u8)src[i]) * 0xFF51AFD7ED558CCDull; h2 ^= h2 >> 29;
+    }
+    for (const char* t = target; *t; t++) { h1 = (h1 ^ (u8)*t) * 1099511628211ull; h2 ^= (u8)*t; h2 *= 0xC4CEB9FE1A85EC53ull; }
+    int hit = 0;
+    sbc_lock();
+    for (int i = 0; i < s_sbc_n && !hit; i++)
+        hit = s_sbc[i].h1 == h1 && s_sbc[i].h2 == h2 && s_sbc[i].len == (u32)len;
+    sbc_unlock();
+    const char* dir = hit ? NULL : rsx_sbc_dir();
+    if (dir) {
+        char path[MAX_PATH + 64];
+        snprintf(path, sizeof path, "%s\\%016llx%016llx_%u_%s.dxbc", dir,
+                 (unsigned long long)h1, (unsigned long long)h2, (unsigned)len, target);
+        hit = GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+    }
+    return hit;
+}
