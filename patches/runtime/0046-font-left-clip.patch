+/* Every byte of a texture, 8 at a time. tex_csum above samples about 1024 words
+ * of a large texture; that is fine for a surface that changes everywhere (an
+ * animated one) but blind to a small edit. A glyph cache is the small-edit
+ * case: the game rasterizes one new glyph into a 40x44 cell of an 8-bit atlas
+ * that is otherwise unchanged, and with a 1024-byte stride over 1024-byte rows
+ * the sampled words never land inside that cell. The atlas then keeps its old
+ * upload, the new glyph samples as empty, and the string that asked for it
+ * (and nothing else) draws with a hole where the glyph belongs, for as long as
+ * the screen stays up. */
+static u32 tex_csum_dense(const u8* base, u32 nbytes)
+{
+    u64 h = 14695981039346656037ull;
+    u32 i = 0;
+    for (; i + 8 <= nbytes; i += 8) {
+        u64 w64; memcpy(&w64, base + i, sizeof w64);
+        h ^= w64; h *= 1099511628211ull; h ^= h >> 29;
+    }
+    for (; i < nbytes; i++) { h ^= base[i]; h *= 1099511628211ull; }
+    return (u32)(h ^ (h >> 32));
+}
