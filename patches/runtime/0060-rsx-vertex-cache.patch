 }
 
+/* RSX_PROF: the cached-texture checks (tex_csum / tex_csum_dense of a slot
+ * held from an earlier frame), TSC ticks and bytes, by kind. */
+static unsigned long long s_texck[9];   /* sparse n, sparse tsc, dense n, dense tsc, dense bytes, changed,
+                                         * uploads, evictions, upload tsc */
+static void texperf_csum(int dense, u32 nbytes, unsigned long long tsc, int same)
+{
+    if (dense) { s_texck[2]++; s_texck[3] += tsc; s_texck[4] += nbytes; }
+    else { s_texck[0]++; s_texck[1] += tsc; }
+    if (!same) s_texck[5]++;
+}
+
 /* The DXGI format a guest texture is uploaded as -- the DECODED image's, which
  * is not always the guest's: the packed 16-bit colour formats arrive unpacked
  * to RGBA8, and DEPTH24_D8 as a float. rsx_texture_layout.h says which class
@@ -4782,8 +4797,15 @@
              * changed. Most of this scene's textures are static, and converting
              * every one of them every frame was ~70% of the frame's CPU time. */
             u32 nb = dxt ? (blkrow * blkrows) : (w * h * bpp);
+            const unsigned long long _tc0 = __rdtsc();
             u32 cs = TEX_CSUM(vm_base + c->off, nb);
