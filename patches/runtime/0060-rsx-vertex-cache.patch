--- a/libs/video/rsx_vertex_fetch.h
+++ b/libs/video/rsx_vertex_fetch.h
@@ -82,9 +82,57 @@
     int n;
     rsx_fetch_plan_attr a[16];
     float tmpl[16][4];
+    signed char at[16];    /* attribute index -> entry in a[], -1 = constant register */
 } rsx_fetch_plan;
 void rsx_fetch_plan_build(const rsx_state* st, rsx_fetch_plan* pl);
 void rsx_fetch_vertex16(const rsx_fetch_plan* pl, u32 vi, float out[16][4]);
+/* RSX_VTX_DIRECT: vertex vi converted straight into a packed vertex whose
+ * slot j holds attribute idx[j] -- the values rsx_fetch_vertex16 gives,
+ * without assembling all sixteen slots first. */
+void rsx_fetch_vertex_pk(const rsx_fetch_plan* pl, u32 vi, const u8* idx, u32 nslots, u8* dst);
+
+
+/* RSX_VTX_CACHE (default off: on this title validating a reuse costs about
+ * what converting costs, measured 11-21; =1 on, =2 on and also re-convert every hit and
+ * count mismatches): converted vertices kept across frames. A block holds the
+ * packed output of one draw's vertex range [lo, lo+n) and is keyed on a
+ * 64-bit signature of the fetch plan (formats, offsets, strides, constant
+ * registers), the packed layout, the range and a content hash of the guest
+ * bytes the range reads. There is no guest write tracking, so the content
+ * hash is what proves the bytes unchanged; it reads each source byte once,
+ * far cheaper than decoding every attribute of every vertex. */
+typedef struct rsx_vcache_blk {
+    u64 sig;
+    u32 lo, n, stride, mask;
+    u32 last;                  /* frame it was last used */
+    u8* data;                  /* n * stride packed bytes */
+    u8* valid;                 /* n flags: vertex converted */
+    size_t bytes;
+    struct rsx_vcache_blk* next;
+} rsx_vcache_blk;
+int rsx_vcache_mode(void);
+/* The content hash the cache uses: four 64-bit lanes, every byte. */
+u64 rsx_hash64(const void* p, size_t n, u64 seed);
+/* The draw's block (found or new), or NULL when the draw is not cacheable. */
+rsx_vcache_blk* rsx_vcache_begin(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride,
+                                 u32 lo, u32 hi, u32 frame);
+/* The two halves of rsx_vcache_begin: the content signature (0 = not
+ * cacheable) and the block for it. */
+u64 rsx_vcache_sig(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride, u32 lo, u32 hi);
+rsx_vcache_blk* rsx_vcache_block(u64 sig, u32 n, u32 pk_mask, u32 pk_stride, u32 lo, u32 frame);
+/* Decode parameters only (0 = not cacheable), and the content hash of
+ * exactly the elements vertices idx[0..n) read. */
+u64 rsx_vcache_plan_sig(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride);
+u64 rsx_vcache_gather(const rsx_fetch_plan* pl, const u32* idx, u32 n);
+/* Opaque byte strings under a 64-bit key, same table and budget. */
+u8* rsx_vcache_blob_find(u64 key, u32 frame, u32* len);
+u8* rsx_vcache_blob_put(u64 key, u32 len, u32 frame);
+/* Stats since the last take: hits, stores, uncached conversions, blocks found,
+ * blocks made, draws skipped, hash bytes, hash TSC ticks, checked, mismatched,
+ * resident bytes. */
+enum { VCS_HIT, VCS_STORE, VCS_UNC, VCS_BFOUND, VCS_BNEW, VCS_SKIP, VCS_HBYTES,
+       VCS_HTSC, VCS_CHK, VCS_BAD, VCS_RES, VCS_RHIT, VCS_RSTORE, VCS_RMISS, VCS_RCHK, VCS_RBAD, VCS_RSTALE, VCS_N };
+extern unsigned long long rsx_vcache_stat[VCS_N];
 
 #ifdef __cplusplus
 }
diff --git a/libs/video/rsx_vertex_fetch.c b/libs/video/rsx_vertex_fetch.c
--- a/libs/video/rsx_vertex_fetch.c
+++ b/libs/video/rsx_vertex_fetch.c
@@ -181,6 +181,7 @@
 void rsx_fetch_plan_build(const rsx_state* st, rsx_fetch_plan* pl)
 {
     pl->n = 0;
+    memset(pl->at, -1, sizeof pl->at);
     for (int i = 0; i < 16; i++) {
         pl->tmpl[i][0] = st->vertex_data4f[i][0];
         pl->tmpl[i][1] = st->vertex_data4f[i][1];
@@ -198,6 +199,7 @@
         e->main = (a->offset & 0x80000000u) ? 1 : 0;
         e->base = a->offset & 0x7FFFFFFFu;
         e->local0 = e->main ? 0u : cellGcmResolveLocated(1, 0);
+        pl->at[i] = (signed char)(pl->n - 1);
     }
 }
 void rsx_fetch_vertex16(const rsx_fetch_plan* pl, u32 vi, float out[16][4])
@@ -214,3 +216,251 @@
         fetch_decode(&e->attr, e->idx, p, out[e->idx]);
     }
 }
+
+void rsx_fetch_vertex_pk(const rsx_fetch_plan* pl, u32 vi, const u8* idx, u32 nslots, u8* dst)
+{
+    for (u32 j = 0; j < nslots; j++) {
+        const int i = idx[j] & 15;
+        float o[4];
+        memcpy(o, pl->tmpl[i], sizeof o);
+        const int a = pl->at[i];
+        if (a >= 0) {
+            const rsx_fetch_plan_attr* e = &pl->a[a];
+            const u32 ei = e->mode == 0 ? vi
+                         : e->mode == 1 ? (vi % e->attr.frequency) : (vi / e->attr.frequency);
+            const u32 off = e->base + ei * e->attr.stride;
+            const u8* p = vm_base + (e->main ? cellGcmResolveLocated(0, off) : (u32)(e->local0 + off));
+            fetch_decode(&e->attr, e->idx, p, o);
+        }
+        memcpy(dst + 16u * j, o, sizeof o);
+    }
+}
+
+/* ---- RSX_VTX_CACHE: converted vertices kept across frames (rsx_vertex_fetch.h) ---- */
+#include <intrin.h>
+unsigned long long rsx_vcache_stat[VCS_N];
+int rsx_vcache_mode(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_VTX_CACHE"); v = e ? atoi(e) : 0; }
+    return v;
+}
+static size_t vc_budget(void)
+{
+    static size_t b = 0;
+    if (!b) { const char* e = getenv("RSX_VTX_CACHE_MB"); int mb = e ? atoi(e) : 192;
+              if (mb < 8) mb = 8; b = (size_t)mb << 20; }
+    return b;
+}
+/* Four independent 64-bit lanes (xxHash64 rounds): bound by load bandwidth,
+ * not by one multiply chain. */
+static inline u64 vc_rotl(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+static u64 vc_hash(const u8* p, size_t n, u64 seed)
+{
+    const u64 P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    u64 a = seed + P1 + P2, b = seed + P2, c = seed, d = seed - P1;
+    const size_t n0 = n;
+    while (n >= 32) {
+        u64 w0, w1, w2, w3;
+        memcpy(&w0, p, 8); memcpy(&w1, p + 8, 8); memcpy(&w2, p + 16, 8); memcpy(&w3, p + 24, 8);
+        a = vc_rotl(a + w0 * P2, 31) * P1; b = vc_rotl(b + w1 * P2, 31) * P1;
+        c = vc_rotl(c + w2 * P2, 31) * P1; d = vc_rotl(d + w3 * P2, 31) * P1;
+        p += 32; n -= 32;
+    }
+    u64 h = vc_rotl(a, 1) + vc_rotl(b, 7) + vc_rotl(c, 12) + vc_rotl(d, 18) + (u64)n0;
+    while (n >= 8) { u64 w; memcpy(&w, p, 8); h = vc_rotl(h ^ (vc_rotl(w * P2, 31) * P1), 27) * P1; p += 8; n -= 8; }
+    while (n) { h = vc_rotl(h ^ (*p * P1), 11) * P2; p++; n--; }
+    h ^= h >> 33; h *= P2; h ^= h >> 29; h *= P1; h ^= h >> 32;
+    return h;
+}
+u64 rsx_hash64(const void* p, size_t n, u64 seed) { return vc_hash((const u8*)p, n, seed); }
+#define VC_NB 4096
+static rsx_vcache_blk* s_vcb[VC_NB];
+static size_t s_vc_bytes;
+static void vc_free_where(u32 older_than)
+{
+    for (int i = 0; i < VC_NB; i++) {
+        rsx_vcache_blk** pp = &s_vcb[i];
+        while (*pp) {
+            rsx_vcache_blk* b = *pp;
+            if ((int)(older_than - b->last) > 0) {
+                *pp = b->next; s_vc_bytes -= b->bytes; free(b);
+            } else pp = &b->next;
+        }
+    }
+}
+typedef struct { u32 s, e; int main, j; } vc_range;
+/* Element bytes fetch_decode reads for one vertex of the attribute. */
+static u32 vc_elem_bytes(const rsx_vertex_attrib* a)
+{
+    if (a->type == 6) return 4;
+    u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+    const u32 t = rsx_vertex_type_size(a->type);
+    return n * (t ? t : 4);
+}
+u64 rsx_vcache_sig(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride, u32 lo, u32 hi)
+{
+    if (!vm_base || hi < lo || pk_stride == 0) return 0;
+    const u32 n = hi - lo + 1;
+    if ((u64)n * pk_stride > vc_budget() / 4) { rsx_vcache_stat[VCS_SKIP]++; return 0; }
+    const unsigned long long t0 = __rdtsc();
+    /* Signature: layout, range, constant registers, then per attribute its
+     * decode parameters and the bytes its elements lo..hi occupy. */
+    /* The signature is content-addressed: a converted vertex depends on the
+     * bytes it decodes, the decode parameters and the constant registers, not
+     * on where the bytes sit. This title streams its meshes into ring buffers,
+     * so the same vertices arrive at a new address every frame. Addresses
+     * enter only as each attribute's offset inside its (merged) byte range. */
+    u64 sig = vc_hash((const u8*)pl->tmpl, sizeof pl->tmpl, ((u64)pk_mask << 32) ^ pk_stride);
+    sig ^= (u64)n * 0x9E3779B97F4A7C15ull;
+    /* Byte ranges (offset space, per DMA) the elements occupy; attributes of
+     * one interleaved array overlap and are merged so each byte is hashed once. */
+    vc_range r[16]; int nr = 0;
+    for (int j = 0; j < pl->n; j++) {
+        const rsx_fetch_plan_attr* e = &pl->a[j];
+        if (e->mode != 0) { rsx_vcache_stat[VCS_SKIP]++; return 0; }   /* instanced: not cached */
+        const u32 eb = vc_elem_bytes(&e->attr);
+        const u64 s = (u64)e->base + (u64)lo * e->attr.stride;
+        const u64 en = (u64)e->base + (u64)hi * e->attr.stride + eb;
+        if (en > 0xFFFFFFFFull) { rsx_vcache_stat[VCS_SKIP]++; return 0; }
+        r[nr].s = (u32)s; r[nr].e = (u32)en; r[nr].main = e->main; r[nr].j = j; nr++;
+    }
+    for (int i = 1; i < nr; i++)   /* sort by (main, start): at most 16 */
+        for (int k = i; k > 0 && (r[k-1].main > r[k].main ||
+                                  (r[k-1].main == r[k].main && r[k-1].s > r[k].s)); k--) {
+            const vc_range t = r[k]; r[k] = r[k-1]; r[k-1] = t; }
+    u64 hb = 0;
+    for (int i = 0, g = 0; i < nr; g++) {
+        u32 s = r[i].s, en = r[i].e; const int m = r[i].main; int k = i + 1;
+        while (k < nr && r[k].main == m && r[k].s <= en) { if (r[k].e > en) en = r[k].e; k++; }
+        if (en - s > (256u << 20)) { rsx_vcache_stat[VCS_SKIP]++; return 0; }
+        for (int q = i; q < k; q++) {   /* the attributes read from this range */
+            const rsx_fetch_plan_attr* e = &pl->a[r[q].j];
+            const u64 key[3] = { ((u64)e->idx << 56) ^ ((u64)m << 48) ^ ((u64)g << 32) ^ (r[q].s - s),
+                                 ((u64)e->attr.type << 32) ^ e->attr.size ^ ((u64)e->attr.frequency << 40),
+                                 (u64)e->attr.stride };
+            sig = vc_hash((const u8*)key, sizeof key, sig);
+        }
+        i = k;
+        if (!m) {   /* LOCAL: one contiguous run of VRAM */
+            sig = vc_hash(vm_base + cellGcmResolveLocated(1, s), en - s, sig);
+        } else {    /* MAIN: the IO table maps 1 MB pages; hash page by page */
+            for (u32 c = s; c < en; ) {
+                const u32 ce = ((c >> 20) + 1) << 20;
+                const u32 ln = (ce < en ? ce : en) - c;
+                sig = vc_hash(vm_base + cellGcmResolveLocated(0, c), ln, sig ^ ln);
+                c += ln;
+            }
+        }
+        hb += en - s;
+    }
+    rsx_vcache_stat[VCS_HBYTES] += hb;
+    rsx_vcache_stat[VCS_HTSC] += __rdtsc() - t0;
+    return sig ? sig : 1;
+}
+static void* vc_alloc(rsx_vcache_blk*** headp, u64 sig, size_t bytes, u32 frame)
+{
+    if (s_vc_bytes + bytes > vc_budget()) {
+        vc_free_where(frame - 1);                        /* not used this frame or the last */
+        if (s_vc_bytes + bytes > vc_budget()) vc_free_where(frame);   /* then everything older */
+        if (s_vc_bytes + bytes > vc_budget()) { rsx_vcache_stat[VCS_SKIP]++; return NULL; }
+    }
+    rsx_vcache_blk* b = (rsx_vcache_blk*)malloc(bytes);
+    if (!b) return NULL;
+    rsx_vcache_blk** head = &s_vcb[(sig ^ (sig >> 29)) & (VC_NB - 1)];
+    b->next = *head; *head = b;
+    b->bytes = bytes; b->last = frame; b->sig = sig;
+    s_vc_bytes += bytes;
+    rsx_vcache_stat[VCS_RES] = s_vc_bytes;
+    (void)headp;
+    return b;
+}
+rsx_vcache_blk* rsx_vcache_block(u64 sig, u32 n, u32 pk_mask, u32 pk_stride, u32 lo, u32 frame)
+{
+    rsx_vcache_blk** head = &s_vcb[(sig ^ (sig >> 29)) & (VC_NB - 1)];
+    for (rsx_vcache_blk* b = *head; b; b = b->next)
+        if (b->sig == sig && b->n == n && b->stride == pk_stride && b->mask == pk_mask) {
+            b->lo = lo;   /* this draw's first vertex; entries are relative to it */
+            b->last = frame; rsx_vcache_stat[VCS_BFOUND]++; return b; }
+    const size_t bytes = sizeof(rsx_vcache_blk) + (size_t)n * pk_stride + n;
+    rsx_vcache_blk* b = (rsx_vcache_blk*)vc_alloc(NULL, sig, bytes, frame);
+    if (!b) return NULL;
+    b->lo = lo; b->n = n; b->stride = pk_stride; b->mask = pk_mask;
+    b->data = (u8*)(b + 1); b->valid = b->data + (size_t)n * pk_stride;
+    memset(b->valid, 0, n);
+    rsx_vcache_stat[VCS_BNEW]++;
+    return b;
+}
+/* Decode parameters of a plan, without addresses or contents: what a
+ * converted vertex depends on besides the bytes it reads. 0 = not cacheable
+ * (an instanced attribute). */
+u64 rsx_vcache_plan_sig(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride)
+{
+    u64 sig = vc_hash((const u8*)pl->tmpl, sizeof pl->tmpl, ((u64)pk_mask << 32) ^ pk_stride);
+    for (int j = 0; j < pl->n; j++) {
+        const rsx_fetch_plan_attr* e = &pl->a[j];
+        if (e->mode != 0) return 0;
+        const u64 key[2] = { ((u64)e->idx << 56) ^ ((u64)e->attr.type << 32) ^ e->attr.size,
+                             ((u64)e->attr.frequency << 32) ^ e->attr.stride };
+        sig = vc_hash((const u8*)key, sizeof key, sig);
+    }
+    return sig ? sig : 1;
+}
+/* Content hash of exactly the elements vertices idx[0..n) decode: each
+ * attribute's vc_elem_bytes at the address rsx_fetch_vertex16 reads. */
+u64 rsx_vcache_gather(const rsx_fetch_plan* pl, const u32* idx, u32 n)
+{
+    const unsigned long long t0 = __rdtsc();
+    const u64 P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    u64 h = 0x6A7Eull ^ n;
+    u64 bytes = 0;
+    for (int j = 0; j < pl->n; j++) {
+        const rsx_fetch_plan_attr* e = &pl->a[j];
+        const u32 eb = vc_elem_bytes(&e->attr);
+        u64 a = h + P1, b = h ^ P2;
+        for (u32 v = 0; v < n; v++) {
+            const u32 off = e->base + idx[v] * e->attr.stride;
+            const u8* p = vm_base + (e->main ? cellGcmResolveLocated(0, off) : (u32)(e->local0 + off));
+            u32 w0 = 0, w1 = 0, w2 = 0, w3 = 0;
+            switch (eb) {   /* exactly the element's bytes, never past it */
+            case 16: memcpy(&w3, p + 12, 4); /* fallthrough */
+            case 12: memcpy(&w2, p + 8, 4);  /* fallthrough */
+            case 8:  memcpy(&w1, p + 4, 4);  /* fallthrough */
+            case 4:  memcpy(&w0, p, 4); break;
+            default: { u8 t[16] = {0}; memcpy(t, p, eb < 16 ? eb : 16);
+                       memcpy(&w0, t, 4); memcpy(&w1, t + 4, 4); memcpy(&w2, t + 8, 4); memcpy(&w3, t + 12, 4); }
+            }
+            a = vc_rotl(a + (((u64)w1 << 32) | w0) * P2, 31) * P1;
+            b = vc_rotl(b + (((u64)w3 << 32) | w2) * P2, 31) * P1;
+        }
+        h = vc_rotl(a, 7) ^ vc_rotl(b, 19) ^ ((u64)eb << 40) ^ (u64)j;
+        h *= P1;
+        bytes += (u64)eb * n;
+    }
+    h ^= h >> 29; h *= P2; h ^= h >> 32;
+    rsx_vcache_stat[VCS_HBYTES] += bytes;
+    rsx_vcache_stat[VCS_HTSC] += __rdtsc() - t0;
+    return h ? h : 1;
+}
+rsx_vcache_blk* rsx_vcache_begin(const rsx_fetch_plan* pl, u32 pk_mask, u32 pk_stride,
+                                 u32 lo, u32 hi, u32 frame)
+{
+    const u64 sig = rsx_vcache_sig(pl, pk_mask, pk_stride, lo, hi);
+    return sig ? rsx_vcache_block(sig, hi - lo + 1, pk_mask, pk_stride, lo, frame) : NULL;
+}
+/* Blobs: opaque byte strings under a 64-bit key, in the same table and
+ * budget as the vertex blocks (mask ~0 marks one; n is its length). */
+u8* rsx_vcache_blob_find(u64 key, u32 frame, u32* len)
+{
+    for (rsx_vcache_blk* b = s_vcb[(key ^ (key >> 29)) & (VC_NB - 1)]; b; b = b->next)
+        if (b->sig == key && b->mask == 0xFFFFFFFFu) { b->last = frame; *len = b->n; return b->data; }
+    return NULL;
+}
+u8* rsx_vcache_blob_put(u64 key, u32 len, u32 frame)
+{
+    rsx_vcache_blk* b = (rsx_vcache_blk*)vc_alloc(NULL, key, sizeof(rsx_vcache_blk) + len, frame);
+    if (!b) return NULL;
+    b->lo = 0; b->n = len; b->stride = 0; b->mask = 0xFFFFFFFFu;
+    b->data = (u8*)(b + 1); b->valid = NULL;
+    return b->data;
+}
diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
