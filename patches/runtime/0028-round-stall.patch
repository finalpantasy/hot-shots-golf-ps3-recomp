+/* JC_PROF=1: every ~2 s per walked chain: jobs run and their host time, how
+ * jobs are grouped between non-JOB commands (a "run" is a stretch of
+ * consecutive JOB commands; on hardware those run in parallel across SPUs),
+ * and time spent parked or behind a guard. */
+typedef struct {
+    u64 t0, job_ns, park_ns, guard_ns;
+    u32 jobs, runs, cur_run, max_run, syncs;
+    u32 bin[8], bin_n[8]; u64 bin_ns[8]; int nbin;   /* per job binary EA (inline runs) */
+    u32 pool_jobs; u64 pool_busy_ns, barrier_ns;    /* parallel lanes */
+    u32 brk[128];             /* command (low 7 bits) that ended a lone job's batch */
+} JcProf;
+static int jc_prof_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("JC_PROF") ? 1 : 0;
+    return v;
+}
+static u64 jc_now_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (u64)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+static void jc_prof_end_run(JcProf* p)
+{
+    if (!p->cur_run) return;
+    p->runs++;
+    if (p->cur_run > p->max_run) p->max_run = p->cur_run;
+    p->cur_run = 0;
+}
+static void jc_prof_maybe_print(JcProf* p, u32 jc_ea)
+{
+    u64 now = jc_now_ns();
+    if (!p->t0) { p->t0 = now; return; }
+    if (now - p->t0 < 2000000000ull) return;
+    fprintf(stderr, "[jcprof] chain 0x%08X %.1fs: %u job(s) %.0f ms busy, %u run(s) "
+            "(avg %.1f max %u jobs/run), %u sync(s), parked %.0f ms, guard %.0f ms\n",
+            jc_ea, (now - p->t0) * 1e-9, p->jobs, p->job_ns * 1e-6, p->runs,
+            p->runs ? (double)p->jobs / p->runs : 0.0, p->max_run, p->syncs,
+            p->park_ns * 1e-6, p->guard_ns * 1e-6);
+    if (p->pool_jobs)
+        fprintf(stderr, "[jcprof]   lanes: %u job(s) %.0f ms busy, %.0f ms at barriers\n",
+                p->pool_jobs, p->pool_busy_ns * 1e-6, p->barrier_ns * 1e-6);
+    for (int k = 0; k < 128; k++)
+        if (p->brk[k])
+            fprintf(stderr, "[jcprof]   barrier cmd 0x%02X (op %d): %u held job(s) run inline\n",
+                    k, k & 7, p->brk[k]);
+    for (int k = 0; k < p->nbin; k++)
+        fprintf(stderr, "[jcprof]   bin 0x%08X: %u job(s) %.0f ms\n",
+                p->bin[k], p->bin_n[k], p->bin_ns[k] * 1e-6);
+    memset(p, 0, sizeof *p);
+    p->t0 = now;
+}
