+/* ---------------------------------------------------------------------------
+ * Parallel job lanes
+ *
+ * On hardware a job chain is executed by up to maxContention SPUs at once: each
+ * SPU's job manager grabs the next JOB command(s) and runs them, so the jobs
+ * between two SYNCs run concurrently and in no defined order. NEXT, RESET_PC
+ * and CALL only move the read pointer; SYNC/LWSYNC (and a GUARD, END or ABORT)
+ * are what make a later job wait for the earlier ones.
+ *
+ * The walker used to run every job inline, one after another. Hot Shots Golf's
+ * course load feeds its chlib Spu chain (0x11041700, maxContention 5) one job
+ * per NEXT and its main thread waits (func_00871E30: done counter at +0x300 vs
+ * issued at +0x304, 1 s timeout) for a counter job queued behind a SYNC; with a
+ * ~9 ms lifted job run serially the main thread sat in that wait ~90 ms at a
+ * time, about 2.7 s of every 2.9 s frame, and the round showed "Now Loading"
+ * at ~1 FPS. Jobs now go to a small per-walker pool of lanes; the walker waits
+ * for them only at a barrier command.
+ *
+ * A job that is followed straight by a barrier still runs inline on the walker
+ * thread (held as `pending` until the next command shows whether a second job
+ * joins it), so chains of the form JOB SYNC JOB SYNC (the sgx "soc-job" sound
+ * chains) keep their exact old timing and thread.
+ *
+ * Each lane has its own SPU number (cellSpursGetCurrentSpuId): titles key
+ * per-SPU buffers on it. Lane 0 = 0 (what the walker uses inline), the others
+ * 2, 3, ... -- 1 is the job queue worker's (cellSpursJq.c).
+ *
+ * JC_PARALLEL=<lanes> (default 4, max 8); JC_PARALLEL=0 or 1 runs every job
+ * inline as before.
+ * -----------------------------------------------------------------------*/
+#define JC_LANES_MAX 8
+#define JC_POOL_Q    256
+extern void spurs_job_set_spu_num(uint32_t n);
+
+typedef struct JcPool {
+    SRWLOCK lock;
+    CONDITION_VARIABLE cv_work, cv_done;
+    struct { u32 job_ea; int idx; } q[JC_POOL_Q];
+    unsigned qh, qt;
+    int outstanding;          /* submitted and not yet finished */
+    int quit;
+    int nlanes;
+    HANDLE th[JC_LANES_MAX];
+    u32 jc_ea, size_desc;
+    u64 busy_ns;              /* lane time spent in jobs (JC_PROF) */
+} JcPool;
+
+typedef struct { JcPool* pool; int lane; } JcLaneArg;
+static JcLaneArg s_jc_lane_args[MAX_JOBCHAINS * JC_LANES_MAX];
+static volatile long s_jc_lane_arg_next;
+
+static int jc_parallel_lanes(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("JC_PARALLEL");
+        v = e ? atoi(e) : 4;
+        if (v < 1) v = 1;
+        if (v > JC_LANES_MAX) v = JC_LANES_MAX;
+        fprintf(stderr, "[cellSpurs] job chain lanes: %d (JC_PARALLEL=%s)\n", v, e ? e : "unset");
+    }
+    return v;
+}
+
+static DWORD WINAPI jc_lane_main(LPVOID p)
+{
+    JcLaneArg* a = (JcLaneArg*)p;
+    JcPool* pl = a->pool;
+    const int lane = a->lane;
+    ps3_thread_name("spurs jc lane %d", lane);
+    spurs_job_set_spu_num(lane == 0 ? 0u : (u32)lane + 1u);
+    for (;;) {
+        AcquireSRWLockExclusive(&pl->lock);
+        while (pl->qh == pl->qt && !pl->quit)
+            SleepConditionVariableSRW(&pl->cv_work, &pl->lock, INFINITE, 0);
+        if (pl->qh == pl->qt) { ReleaseSRWLockExclusive(&pl->lock); break; }
+        u32 job = pl->q[pl->qh % JC_POOL_Q].job_ea;
+        int idx = pl->q[pl->qh % JC_POOL_Q].idx;
+        pl->qh++;
+        WakeAllConditionVariable(&pl->cv_done);          /* queue space */
+        ReleaseSRWLockExclusive(&pl->lock);
+
+        u64 t0 = jc_prof_on() ? jc_now_ns() : 0;
+        { extern u32 g_spurs_job_ls_handle; g_spurs_job_ls_handle = pl->jc_ea; }
+        jc_run_one_job(job, idx, pl->size_desc);
+        /* Signal here, on the lane: the job's mailbox answer is in this
+         * thread's TLS (g_spurs_job_mbox*), as it is on the walker inline. */
+        jc_signal_done(pl->jc_ea, idx);
+        u64 d = t0 ? jc_now_ns() - t0 : 0;
+
+        AcquireSRWLockExclusive(&pl->lock);
+        pl->busy_ns += d;
+        pl->outstanding--;
+        WakeAllConditionVariable(&pl->cv_done);
+        ReleaseSRWLockExclusive(&pl->lock);
+    }
+    return 0;
+}
+
+static JcPool* jc_pool_create(u32 jc_ea, u32 size_desc, int nlanes)
+{
+    JcPool* pl = (JcPool*)calloc(1, sizeof *pl);
+    if (!pl) return NULL;
+    InitializeSRWLock(&pl->lock);
+    InitializeConditionVariable(&pl->cv_work);
+    InitializeConditionVariable(&pl->cv_done);
+    pl->jc_ea = jc_ea; pl->size_desc = size_desc;
+    for (int i = 0; i < nlanes; i++) {
+        long k = InterlockedIncrement(&s_jc_lane_arg_next) - 1;
+        JcLaneArg* a = &s_jc_lane_args[(unsigned long)k % (MAX_JOBCHAINS * JC_LANES_MAX)];
+        a->pool = pl; a->lane = i;
+        /* Lifted SPU code recurses on the host stack, as on the walker. */
+        pl->th[i] = CreateThread(NULL, 64u << 20, jc_lane_main, a,
+                                 STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+        if (!pl->th[i]) break;
+        pl->nlanes++;
+    }
+    if (!pl->nlanes) { free(pl); return NULL; }
+    return pl;
+}
+
+/* Submit one job to the lanes, blocking while the queue is full. */
+static void jc_pool_submit(JcPool* pl, u32 job, int idx)
+{
+    AcquireSRWLockExclusive(&pl->lock);
+    while (pl->qt - pl->qh >= JC_POOL_Q)
+        SleepConditionVariableSRW(&pl->cv_done, &pl->lock, INFINITE, 0);
+    pl->q[pl->qt % JC_POOL_Q].job_ea = job;
+    pl->q[pl->qt % JC_POOL_Q].idx = idx;
+    pl->qt++;
+    pl->outstanding++;
+    WakeAllConditionVariable(&pl->cv_work);
+    ReleaseSRWLockExclusive(&pl->lock);
+}
+
+static void jc_pool_wait_idle(JcPool* pl)
+{
+    AcquireSRWLockExclusive(&pl->lock);
+    while (pl->outstanding > 0)
+        SleepConditionVariableSRW(&pl->cv_done, &pl->lock, INFINITE, 0);
+    ReleaseSRWLockExclusive(&pl->lock);
+}
+
+static void jc_pool_destroy(JcPool* pl)
+{
+    if (!pl) return;
+    jc_pool_wait_idle(pl);
+    AcquireSRWLockExclusive(&pl->lock);
+    pl->quit = 1;
+    WakeAllConditionVariable(&pl->cv_work);
+    ReleaseSRWLockExclusive(&pl->lock);
+    for (int i = 0; i < pl->nlanes; i++)
+        if (pl->th[i]) { WaitForSingleObject(pl->th[i], INFINITE); CloseHandle(pl->th[i]); }
+    free(pl);
+}
+
+/* Walker-side state for one jc_execute. */
+typedef struct {
+    int lanes;            /* 1 = serial */
+    JcPool* pool;
+    u32 jc_ea, size_desc;
+    u32 pending_job;      /* a job not started yet (0 = none) */
+    int pending_idx;
+    int batch_open;       /* jobs submitted to the lanes since the last barrier */
+    JcProf* prof;         /* JC_PROF counters of the walker (NULL = off) */
+    u64 busy_seen;        /* pool->busy_ns already added to prof */
+} JcPar;
+
+/* Fold the lanes' busy time into the walker's JC_PROF window. */
