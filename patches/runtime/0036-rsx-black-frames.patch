+/* The drain passed a guest flip without stopping (FIFO backlogged, see
+ * g_gcm_flip_passed_hook): present what is accumulated now, so the frame ends at
+ * its flip and not at whatever the drain reached next. Recorded as a clear-style
+ * boundary, so the ticker's present for this flip and a display clear later in
+ * the next frame do not present again. Only the first flip passed in one drain
+ * presents (each present waits a vblank, and a title megabytes behind is
+ * catching up); later ones run their draws unpresented, like before.
+ * RSX_FLIP_MARK=0 turns it off. */
+static void d3d12_flip_passed(int nth)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_FLIP_MARK"); on = (e && e[0] == '0') ? 0 : 1; }
+    if (!on || !s_d3d.initialized) return;
+    int have_display = 0;
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; i++)
+        if (dr_is_display_draw(&s_d3d.draws[i])) { have_display = 1; break; }
+    if (!have_display) return;
+    extern unsigned cellGcm_flip_request_count(void);
+    const unsigned fc = cellGcm_flip_request_count();
+    if (nth > 0) {
+        s_rf_why = "flipmark-skip";
+        s_present_this_frame = 0;
+        render_frame();
+        s_present_this_frame = 1;
+    } else {
+        s_rf_why = "flipmark";
+        s_present_this_frame = 1;
+        render_frame();
+        s_clear_presents++;
+        s_last_clear_boundary_flip = fc;
+        s_last_clear_presented_flip = fc;
+    }
+    /* Same batch reset as the clear boundary. */
+    for (u32 _i = 0; _i < s_d3d.draw_count && _i < MAX_DRAWS; _i++) s_d3d.draws[_i].indexed = 0;
+    s_ix_run_valid = 0;
+    s_d3d.draw_count   = 0;
+    s_d3d.vb_offset    = 0;
+    s_d3d.vp_vb_offset = 0;
+}
