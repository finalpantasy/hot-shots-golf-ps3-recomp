+/* RSX_STALL_DBG=<s>: watchdog on the frame-clock thread (the one that owns the
+ * window, drains the FIFO and presents). When it has not passed a stage mark
+ * for <s> seconds, print the stage it is in and its raw call stack (module +
+ * offset; resolve with llvm-symbolizer), once per stall. A picture that stops
+ * while the process lives is either this thread blocked or the guest no longer
+ * flipping; this says which, and where. */
+static volatile const char* s_stall_stage = "init";
+static volatile LONG64 s_stall_hb = 0;
+static HANDLE s_stall_thread = NULL;
+static int stall_dbg_secs(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_STALL_DBG"); v = e ? atoi(e) : 0; if (v < 0) v = 0; }
+    return v;
+}
+static void stall_mark(const char* st)
+{
+    if (!stall_dbg_secs()) return;
+    s_stall_stage = st;
+    s_stall_hb = (LONG64)GetTickCount64();
+}
+/* Raw x64 unwind of a suspended thread: return addresses, innermost first. */
+static int stall_unwind(HANDLE th, DWORD64* rips, int max)
+{
+    int n = 0;
+    if (SuspendThread(th) == (DWORD)-1) return 0;
+    CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_FULL;
+    if (GetThreadContext(th, &c)) {
+        while (n < max && c.Rip) {
+            rips[n++] = c.Rip;
+            DWORD64 base = 0;
+            PRUNTIME_FUNCTION f = RtlLookupFunctionEntry(c.Rip, &base, NULL);
+            if (!f) { c.Rip = *(DWORD64*)c.Rsp; c.Rsp += 8; }
+            else { PVOID hd = NULL; DWORD64 ef = 0;
+                   RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c.Rip, f, &c, &hd, &ef, NULL); }
+        }
+    }
+    ResumeThread(th);
+    return n;
+}
+static void stall_print_stack(const DWORD64* rips, int n)
+{
+    for (int i = 0; i < n; i++) {
+        HMODULE m = NULL; char nm[MAX_PATH] = "?";
+        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                               (LPCSTR)(uintptr_t)rips[i], &m) && m) {
+            GetModuleFileNameA(m, nm, sizeof nm);
+            const char* b = strrchr(nm, 92); /* backslash */
+            fprintf(stderr, "[STALL]   #%02d %s+0x%llX%c", i, b ? b + 1 : nm,
+                    (unsigned long long)(rips[i] - (DWORD64)(uintptr_t)m), 10);
+        } else fprintf(stderr, "[STALL]   #%02d 0x%llX%c", i, (unsigned long long)rips[i], 10);
+    }
+}
+/* Every thread of the process: name + stack. For a guest that has stopped
+ * flipping, this names what its render thread is blocked on. */
+static void stall_dump_all_threads(void)
+{
+    typedef HRESULT (WINAPI *GTD)(HANDLE, PWSTR*);
+    static GTD gtd = NULL; static int gtd_init = 0;
+    if (!gtd_init) { gtd_init = 1;
+        gtd = (GTD)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription"); }
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap == INVALID_HANDLE_VALUE) return;
+    THREADENTRY32 te; te.dwSize = sizeof te;
+    const DWORD me = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    if (Thread32First(snap, &te)) do {
+        if (te.th32OwnerProcessID != pid || te.th32ThreadID == me) continue;
+        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION,
+                              FALSE, te.th32ThreadID);
+        if (!h) continue;
+        char name[96] = "";
+        if (gtd) { PWSTR w = NULL;
+            if (SUCCEEDED(gtd(h, &w)) && w) {
+                WideCharToMultiByte(CP_UTF8, 0, w, -1, name, sizeof name, NULL, NULL); LocalFree(w); } }
+        DWORD64 rips[24]; const int n = stall_unwind(h, rips, 24);
+        fprintf(stderr, "[STALL] thread %lu '%s':%c", (unsigned long)te.th32ThreadID, name, 10);
+        stall_print_stack(rips, n);
+        CloseHandle(h);
+    } while (Thread32Next(snap, &te));
+    CloseHandle(snap);
+    fflush(stderr);
+}
+static DWORD WINAPI stall_watch(LPVOID arg)
+{
+    const ULONGLONG lim = (ULONGLONG)stall_dbg_secs() * 1000ull;
+    LONG64 reported = -1;
+    ULONGLONG last_status = 0, flip_t = 0;
+    unsigned last_flips = 0, dumped_flips = 0;
+    (void)arg;
+    for (;;) {
+        Sleep(500);
+        const LONG64 hb = s_stall_hb;
+        const ULONGLONG now = GetTickCount64();
+        /* Guest stopped flipping for 10 s (after it had started): dump every
+         * thread once per stopped flip count. */
+        { extern unsigned cellGcm_flip_request_count(void);
+          const unsigned f = cellGcm_flip_request_count();
+          if (f != last_flips) { last_flips = f; flip_t = now; }
+          else if (f && f != dumped_flips && now - flip_t >= 10000) {
+              dumped_flips = f;
+              fprintf(stderr, "[STALL] no guest flip for %llu ms at flips=%u: all threads%c",
+                      (unsigned long long)(now - flip_t), f, 10);
+              stall_dump_all_threads();
+          } }
+        /* Every 5 s: is the guest still flipping, and is the FIFO drained? */
+        if (now - last_status >= 5000) {
+            extern unsigned cellGcm_flip_request_count(void);
+            extern u32 cellGcm_control_guest_addr(void);
+            extern u32 vm_read32(unsigned int);
+            last_status = now;
+            extern void cellGcm_flip_debug(char*, unsigned);
+            const u32 ctl = cellGcm_control_guest_addr();
+            char fd[400]; cellGcm_flip_debug(fd, sizeof fd);
+            fprintf(stderr, "[STALL] status stage=%s hb_age=%llu flips=%u frames=%llu pending=%u"
+                            " put=0x%08X get=0x%08X %s%c", (const char*)s_stall_stage,
+                    (unsigned long long)(hb ? now - (ULONGLONG)hb : 0),
+                    cellGcm_flip_request_count(), (unsigned long long)s_d3d.frame_count,
+                    s_d3d.draw_count, vm_read32(ctl), vm_read32(ctl + 4), fd, 10);
+            fflush(stderr);
+        }
+        if (!hb || hb == reported || now - (ULONGLONG)hb < lim) continue;
+        reported = hb;
+        DWORD64 rips[40];
+        const int n = s_stall_thread ? stall_unwind(s_stall_thread, rips, 40) : 0;
+        fprintf(stderr, "[STALL] frame-clock thread at '%s' for %llu ms, stack:%c",
+                (const char*)s_stall_stage, (unsigned long long)(now - (ULONGLONG)hb), 10);
+        stall_print_stack(rips, n);
+        fflush(stderr);
+    }
+    return 0;
+}
+static void stall_watch_start(void)
+{
+    if (!stall_dbg_secs() || s_stall_thread) return;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(),
+                    &s_stall_thread, THREAD_ALL_ACCESS, FALSE, 0);
+    stall_mark("init");
+    HANDLE t = CreateThread(NULL, 0, stall_watch, NULL, 0, NULL);
+    if (t) CloseHandle(t);
+}
