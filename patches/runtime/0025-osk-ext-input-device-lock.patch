index 17e7c67..0a3cdc0 100644
--- a/libs/misc/cellOskDialog.c
+++ b/libs/misc/cellOskDialog.c
@@ -275,3 +275,20 @@ s32 cellOskDialogGetInputText(CellOskDialogCallbackReturnParam* result)
 
     return CELL_OK;
 }
+
+/* cellOskExtUtility: input device lock. No arguments on either call. The
+ * state is kept so a host keyboard overlay can honour it once one exists;
+ * there is no live dialog to update today. */
+static int s_osk_input_device_locked = 0;
+
+s32 cellOskDialogExtInputDeviceLock(void)
+{
+    s_osk_input_device_locked = 1;
+    return CELL_OK;
+}
+
+s32 cellOskDialogExtInputDeviceUnlock(void)
+{
+    s_osk_input_device_locked = 0;
+    return CELL_OK;
+}
