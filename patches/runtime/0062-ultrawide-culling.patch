     if (blink_dbg())
         printf("[PRESENT] draws=%u clears_since_last=%u clear_presents=%u\n",
                s_d3d.draw_count, s_dbg_clears_since_present, s_clear_presents);
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -3686,6 +3686,7 @@
 static int32_t g_ppu_primary_priority = 1001;
 
 extern "C" void hsg_tweaks_boot(void);   /* libs/system/hsg_tweaks.c */
+extern "C" void hsg_widecull_boot(void);  /* libs/system/hsg_widecull.c */
 extern "C" uint32_t ppu_load_elf(const char* path)
 {
     g_ppu_primary_priority = 1001;
@@ -3875,6 +3876,8 @@
       } }
     /* HSG_TWEAKS "when": "boot" writes and insn guards (libs/system/hsg_tweaks.c). */
     hsg_tweaks_boot();
+    /* RSX_ASPECT=expand: widen the guest culling aspect (patch 0062). */
+    hsg_widecull_boot();
     return entry;
 }
 
