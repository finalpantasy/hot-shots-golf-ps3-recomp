+static const GUID SM_MF_MT_MAJOR_TYPE  = {0x48eba18e, 0xf8c9, 0x4687, {0xbf, 0x11, 0x0a, 0x74, 0xc9, 0xf9, 0x6a, 0x8f}};
+static const GUID SM_MF_MT_SUBTYPE     = {0xf7e34c9a, 0x42e8, 0x4714, {0xb7, 0x4b, 0xcb, 0x29, 0xd7, 0x2c, 0x35, 0xe5}};
+static const GUID SM_MF_MT_FRAME_SIZE  = {0x1652c33d, 0xd6b2, 0x4012, {0xb8, 0x34, 0x72, 0x03, 0x08, 0x49, 0xa3, 0x7d}};
+static const GUID SM_MF_MT_FRAME_RATE  = {0xc459a2e8, 0x3d2c, 0x4e44, {0xb1, 0x32, 0xfe, 0xe5, 0x15, 0x6c, 0x7b, 0xb0}};
+static const GUID SM_MF_MT_DEFAULT_STRIDE = {0x644b4e48, 0x1e02, 0x4516, {0xb0, 0xeb, 0xc0, 0x1c, 0xa9, 0xd4, 0x9a, 0xc6}};
+static const GUID SM_MFMediaType_Video = {0x73646976, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID SM_MFVideoFormat_H264 = {0x34363248, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID SM_MFVideoFormat_NV12 = {0x3231564E, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID SM_CLSID_MSH264Dec   = {0x62ce7e72, 0x4c71, 0x4d20, {0xb1, 0x5d, 0x45, 0x28, 0x31, 0xa8, 0x7d, 0x9d}};
+static const GUID SM_IID_IMFTransform  = {0xbf94c121, 0x5b05, 0x4e6f, {0x80, 0x00, 0xba, 0x59, 0x89, 0x61, 0x41, 0x4d}};
+static const GUID SM_IID_IMF2DBuffer   = {0x7dc9d5f9, 0x9ed9, 0x44ec, {0x9b, 0xbf, 0x06, 0x00, 0xbb, 0x58, 0x9f, 0xbb}};
+
+/* mfplat.dll, opened once. */
+typedef HRESULT (WINAPI *pfnMFStartup)(ULONG, DWORD);
+typedef HRESULT (WINAPI *pfnMFCreateMediaType)(IMFMediaType**);
+typedef HRESULT (WINAPI *pfnMFCreateSample)(IMFSample**);
+typedef HRESULT (WINAPI *pfnMFCreateMemoryBuffer)(DWORD, IMFMediaBuffer**);
+static struct {
+    int state;    /* 0 not tried, 1 ok, -1 unavailable */
+    pfnMFStartup Startup;
+    pfnMFCreateMediaType CreateMediaType;
+    pfnMFCreateSample CreateSample;
+    pfnMFCreateMemoryBuffer CreateMemoryBuffer;
+} s_mf;
+static INIT_ONCE s_mf_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK sm_mf_load(PINIT_ONCE o, PVOID p, PVOID* c)
+{
+    (void)o; (void)p; (void)c;
+    HMODULE h = LoadLibraryExW(L"mfplat.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (h) {
+        s_mf.Startup = (pfnMFStartup)(void*)GetProcAddress(h, "MFStartup");
+        s_mf.CreateMediaType = (pfnMFCreateMediaType)(void*)GetProcAddress(h, "MFCreateMediaType");
+        s_mf.CreateSample = (pfnMFCreateSample)(void*)GetProcAddress(h, "MFCreateSample");
+        s_mf.CreateMemoryBuffer = (pfnMFCreateMemoryBuffer)(void*)GetProcAddress(h, "MFCreateMemoryBuffer");
+    }
+    s_mf.state = (h && s_mf.Startup && s_mf.CreateMediaType && s_mf.CreateSample &&
+                  s_mf.CreateMemoryBuffer && SUCCEEDED(s_mf.Startup(MF_VERSION, MFSTARTUP_LITE)))
+                 ? 1 : -1;
+    return TRUE;
+}
+
+static int sm_mf_ready(void)
+{
+    InitOnceExecuteOnce(&s_mf_once, sm_mf_load, NULL, NULL);
+    return s_mf.state > 0;
+}
+
+typedef struct {
+    uint8_t* px;
+    int64_t pts;
+} SmFrame;
+
+struct SailMovie {
+    char path[1024];
+    FILE* f;
+    uint64_t data_off, data_end;
+    SailMovieInfo info;
+
+    int layout;
+    uint8_t alpha;
+    int out_ch;
+
+    HANDLE thread;
+    SRWLOCK lock;
+    CONDITION_VARIABLE cv;     /* signalled when a frame slot frees, or on stop */
+    volatile LONG stop;
+    int failed;
+    int done;                  /* decoder finished, everything it made is queued */
+
+    /* video frame queue (ring) */
+    SmFrame vq[SM_VQ];
+    int vq_head, vq_n;
+    int64_t last_taken;        /* pts of the last frame handed out, -1 = none */
+    int64_t frames_out;        /* frames decoded so far, in display order */
+    int64_t frame_dur;         /* 90 kHz ticks per frame */
+
+    /* audio ring of out_ch-interleaved floats */
+    float* ar;
+    int ar_cap, ar_head, ar_n; /* in frames */
+
+    /* decoder state (decode thread only) */
+    IMFTransform* mft;
+    int provides_samples;
+    DWORD out_cb;
+    UINT32 nv_w, nv_h;         /* decoder output buffer size (may be 1088 high) */
+    LONG nv_stride;
+    void* at3;
+    int at3_ch, at3_fs;
+    uint8_t* ves; size_t ves_n, ves_cap;   /* video elementary stream */
+    size_t ves_scan;                       /* where the AUD search resumes */
+    uint8_t* aes; size_t aes_n, aes_cap;   /* audio AU stream */
+    int64_t in_count;
+};
+
+static uint32_t rd32(const uint8_t* p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+
+static int sm_fail(SailMovie* m, const char* what, HRESULT hr)
+{
+    fprintf(stderr, "[sail_movie] %s failed (0x%08lX): %s\n", what, (unsigned long)hr, m->path);
+    m->failed = 1;
+    return -1;
+}
+
+/* ---------------------------------------------------------------- probing */
+
+SailMovie* sail_movie_open(const char* host_path, SailMovieInfo* info, char* why, size_t why_n)
+{
+    FILE* f = fopen(host_path, "rb");
+    if (!f) { sm_why(why, why_n, "cannot open the file"); return NULL; }
+    uint8_t h[SM_PACK];
+    if (fread(h, 1, sizeof h, f) != sizeof h || memcmp(h, "PAMF", 4) != 0) {
+        fclose(f); sm_why(why, why_n, "not a PAMF file"); return NULL;
+    }
+    SailMovieInfo in;
+    memset(&in, 0, sizeof in);
+    in.fps_num = 30000; in.fps_den = 1001;
+    int have_video = 0;
+    /* Stream entries are 48 bytes: coding type, 3 reserved, stream id,
+     * private id, ... then 32 bytes of codec info (RPCS3 cellPamf.h,
+     * PamfStreamHeader). Scan for them rather than walk the sequence info. */
+    for (int o = 0x50; o + 48 <= (int)sizeof h; o += 4) {
+        const uint8_t* e = h + o;
+        if (e[0] == 0x1B && e[4] == 0xE0 && !have_video) {          /* AVC */
+            const uint8_t* a = e + 16;
+            static const int fr[][2] = {{0, 0}, {24000, 1001}, {24, 1}, {25, 1}, {30000, 1001},
+                                        {30, 1}, {50, 1}, {60000, 1001}, {60, 1}};
+            const int fri = a[2] & 0x0F;
+            if (fri >= 1 && fri <= 8) { in.fps_num = fr[fri][0]; in.fps_den = fr[fri][1]; }
+            const int crop_b = (a[18] << 8) | a[19], crop_r = (a[14] << 8) | a[15];
+            in.width = a[9] * 16 - crop_r * 2;
+            in.height = a[11] * 16 - crop_b * 2;
+            have_video = 1;
+        } else if (e[0] == 0xDC && e[4] == 0xBD && !in.audio_channels) {   /* ATRAC3plus */
+            const uint8_t* a = e + 16;
+            in.audio_channels = a[2];
+            in.audio_rate = 48000;
+        }
+    }
+    if (!have_video || in.width <= 0 || in.height <= 0 || in.width > 4096 || in.height > 4096) {
+        fclose(f); sm_why(why, why_n, "no H.264 stream in the PAMF header"); return NULL;
+    }
+    if (!sm_mf_ready()) {
+        fclose(f); sm_why(why, why_n, "Media Foundation (mfplat.dll) is not available"); return NULL;
+    }
+
+    SailMovie* m = (SailMovie*)calloc(1, sizeof *m);
+    if (!m) { fclose(f); sm_why(why, why_n, "out of memory"); return NULL; }
+    snprintf(m->path, sizeof m->path, "%s", host_path);
+    m->f = f;
+    m->data_off = (uint64_t)rd32(h + 8) * SM_PACK;
+    m->data_end = m->data_off + (uint64_t)rd32(h + 12) * SM_PACK;
+    m->info = in;
+    m->frame_dur = (int64_t)90000 * in.fps_den / in.fps_num;
+    m->last_taken = -1;
+    InitializeSRWLock(&m->lock);
+    InitializeConditionVariable(&m->cv);
+    if (info) *info = in;
+    return m;
+}
+
+/* ----------------------------------------------------------- H.264 decode */
+
+static int sm_set_output_type(SailMovie* m)
+{
+    for (DWORD i = 0;; i++) {
+        IMFMediaType* t = NULL;
+        HRESULT hr = IMFTransform_GetOutputAvailableType(m->mft, 0, i, &t);
+        if (FAILED(hr)) return sm_fail(m, "H.264 decoder: no NV12 output", hr);
+        GUID sub;
+        if (SUCCEEDED(IMFMediaType_GetGUID(t, &SM_MF_MT_SUBTYPE, &sub)) &&
+            IsEqualGUID(&sub, &SM_MFVideoFormat_NV12)) {
+            hr = IMFTransform_SetOutputType(m->mft, 0, t, 0);
+            UINT64 fs = 0;
+            IMFMediaType_GetUINT64(t, &SM_MF_MT_FRAME_SIZE, &fs);
+            m->nv_w = (UINT32)(fs >> 32); m->nv_h = (UINT32)fs;
+            UINT32 st = 0;
+            m->nv_stride = SUCCEEDED(IMFMediaType_GetUINT32(t, &SM_MF_MT_DEFAULT_STRIDE, &st))
+                           ? (LONG)st : (LONG)m->nv_w;
+            IMFMediaType_Release(t);
+            if (FAILED(hr)) return sm_fail(m, "H.264 decoder SetOutputType", hr);
+            MFT_OUTPUT_STREAM_INFO si;
+            memset(&si, 0, sizeof si);
+            IMFTransform_GetOutputStreamInfo(m->mft, 0, &si);
+            m->provides_samples = (si.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES |
+                                                 MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)) != 0;
+            m->out_cb = si.cbSize;
+            return 0;
+        }
+        IMFMediaType_Release(t);
+    }
+}
+
+static int sm_mft_open(SailMovie* m)
+{
+    HRESULT hr = CoCreateInstance(&SM_CLSID_MSH264Dec, NULL, CLSCTX_INPROC_SERVER,
+                                  &SM_IID_IMFTransform, (void**)&m->mft);
+    if (FAILED(hr)) return sm_fail(m, "creating the Windows H.264 decoder", hr);
+    IMFMediaType* t = NULL;
+    hr = s_mf.CreateMediaType(&t);
+    if (FAILED(hr)) return sm_fail(m, "MFCreateMediaType", hr);
+    IMFMediaType_SetGUID(t, &SM_MF_MT_MAJOR_TYPE, &SM_MFMediaType_Video);
+    IMFMediaType_SetGUID(t, &SM_MF_MT_SUBTYPE, &SM_MFVideoFormat_H264);
+    IMFMediaType_SetUINT64(t, &SM_MF_MT_FRAME_SIZE, ((UINT64)m->info.width << 32) | (UINT32)m->info.height);
+    IMFMediaType_SetUINT64(t, &SM_MF_MT_FRAME_RATE, ((UINT64)m->info.fps_num << 32) | (UINT32)m->info.fps_den);
+    hr = IMFTransform_SetInputType(m->mft, 0, t, 0);
+    IMFMediaType_Release(t);
+    if (FAILED(hr)) return sm_fail(m, "H.264 decoder SetInputType", hr);
+    if (sm_set_output_type(m) < 0) return -1;
+    IMFTransform_ProcessMessage(m->mft, MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+    IMFTransform_ProcessMessage(m->mft, MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+    return 0;
+}
+
+static inline uint8_t sm_clamp(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+/* NV12 (BT.709, limited range, as the PAMF headers here declare) to 4-byte
+ * pixels. Chroma is shared by 2x2 pixels. */
+static void sm_nv12_to_rgb(const SailMovie* m, const uint8_t* y, const uint8_t* uv, int pitch,
+                           uint8_t* dst)
+{
+    const int w = m->info.width, h = m->info.height;
+    const int ri = m->layout == SAIL_MOVIE_RGBA ? 0 : 1;
+    const int ai = m->layout == SAIL_MOVIE_RGBA ? 3 : 0;
+    for (int r = 0; r < h; r++) {
+        const uint8_t* yr = y + (size_t)r * pitch;
+        const uint8_t* cr = uv + (size_t)(r >> 1) * pitch;
+        uint8_t* o = dst + (size_t)r * w * 4;
+        for (int c = 0; c < w; c++) {
+            const int Y = 298 * (yr[c] - 16) + 128;
+            const int U = cr[c & ~1] - 128, V = cr[(c & ~1) + 1] - 128;
+            o[ai] = m->alpha;
+            o[ri]     = sm_clamp((Y + 459 * V) >> 8);
+            o[ri + 1] = sm_clamp((Y - 55 * U - 136 * V) >> 8);
+            o[ri + 2] = sm_clamp((Y + 541 * U) >> 8);
+            o += 4;
+        }
+    }
+}
+
+/* NV12 to planar Y, U, V with tightly packed rows (pitch = width). */
+static void sm_nv12_to_i420(const SailMovie* m, const uint8_t* y, const uint8_t* uv, int pitch,
+                            uint8_t* dst)
+{
+    const int w = m->info.width, h = m->info.height, cw = w / 2, ch = h / 2;
+    for (int r = 0; r < h; r++) memcpy(dst + (size_t)r * w, y + (size_t)r * pitch, (size_t)w);
+    uint8_t* u = dst + (size_t)w * h;
+    uint8_t* v = u + (size_t)cw * ch;
+    for (int r = 0; r < ch; r++) {
+        const uint8_t* s = uv + (size_t)r * pitch;
+        uint8_t* uo = u + (size_t)r * cw;
+        uint8_t* vo = v + (size_t)r * cw;
+        for (int c = 0; c < cw; c++) { uo[c] = s[2 * c]; vo[c] = s[2 * c + 1]; }
+    }
+}
+
+/* Waits for a free slot and converts one decoded picture into it. */
+static int sm_emit_frame(SailMovie* m, IMFSample* s)
+{
+    IMFMediaBuffer* b = NULL;
+    if (FAILED(IMFSample_ConvertToContiguousBuffer(s, &b))) return sm_fail(m, "decoded sample", E_FAIL);
+    IMF2DBuffer* b2 = NULL;
+    BYTE* base = NULL; LONG pitch = 0; DWORD len = 0;
+    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(b, &SM_IID_IMF2DBuffer, (void**)&b2)) &&
+        SUCCEEDED(IMF2DBuffer_Lock2D(b2, &base, &pitch))) {
+    } else {
+        if (b2) { IMF2DBuffer_Release(b2); b2 = NULL; }
+        if (FAILED(IMFMediaBuffer_Lock(b, &base, NULL, &len))) {
+            IMFMediaBuffer_Release(b);
+            return sm_fail(m, "locking a decoded picture", E_FAIL);
+        }
+        pitch = m->nv_stride;
+    }
+    const UINT32 plane_h = m->nv_h ? m->nv_h : (UINT32)m->info.height;
+
+    AcquireSRWLockExclusive(&m->lock);
+    while (m->vq_n == SM_VQ && !m->stop)
+        SleepConditionVariableSRW(&m->cv, &m->lock, INFINITE, 0);
+    const int slot = (m->vq_head + m->vq_n) % SM_VQ;
+    ReleaseSRWLockExclusive(&m->lock);
+
+    int rc = 0;
+    if (!m->stop && pitch > 0) {
+        if (m->layout == SAIL_MOVIE_YUV420)
+            sm_nv12_to_i420(m, base, base + (size_t)pitch * plane_h, (int)pitch, m->vq[slot].px);
+        else
+            sm_nv12_to_rgb(m, base, base + (size_t)pitch * plane_h, (int)pitch, m->vq[slot].px);
+        AcquireSRWLockExclusive(&m->lock);
+        m->vq[slot].pts = m->frames_out * m->frame_dur;
+        m->frames_out++;
+        m->vq_n++;
+        ReleaseSRWLockExclusive(&m->lock);
+    } else if (pitch <= 0) {
+        rc = sm_fail(m, "decoded picture has no pitch", E_FAIL);
+    }
+    if (b2) { IMF2DBuffer_Unlock2D(b2); IMF2DBuffer_Release(b2); }
+    else IMFMediaBuffer_Unlock(b);
+    IMFMediaBuffer_Release(b);
+    return rc;
+}
+
+/* Pulls every picture the decoder has ready. */
+static int sm_drain_output(SailMovie* m)
+{
+    for (;;) {
+        if (m->stop) return 0;
+        MFT_OUTPUT_DATA_BUFFER odb;
+        memset(&odb, 0, sizeof odb);
+        IMFSample* own = NULL;
+        if (!m->provides_samples) {
+            IMFMediaBuffer* b = NULL;
+            if (FAILED(s_mf.CreateSample(&own)) ||
+                FAILED(s_mf.CreateMemoryBuffer(m->out_cb ? m->out_cb : m->nv_w * m->nv_h * 3 / 2, &b)))
+                return sm_fail(m, "allocating an output sample", E_OUTOFMEMORY);
+            IMFSample_AddBuffer(own, b);
+            IMFMediaBuffer_Release(b);
+            odb.pSample = own;
+        }
+        DWORD status = 0;
+        HRESULT hr = IMFTransform_ProcessOutput(m->mft, 0, 1, &odb, &status);
+        if (odb.pEvents) IMFCollection_Release(odb.pEvents);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
+            if (own) IMFSample_Release(own);
+            return 0;
+        }
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+            if (own) IMFSample_Release(own);
+            if (sm_set_output_type(m) < 0) return -1;
+            fprintf(stderr, "[sail_movie] decoder output %ux%u NV12, stride %ld\n",
+                    m->nv_w, m->nv_h, (long)m->nv_stride);
+            continue;
+        }
+        if (FAILED(hr)) {
+            if (own) IMFSample_Release(own);
+            return sm_fail(m, "H.264 decoder ProcessOutput", hr);
+        }
+        int rc = odb.pSample ? sm_emit_frame(m, odb.pSample) : 0;
+        if (odb.pSample && odb.pSample != own) IMFSample_Release(odb.pSample);
+        if (own) IMFSample_Release(own);
+        if (rc < 0) return rc;
+    }
+}
+
+static int sm_feed_au(SailMovie* m, const uint8_t* p, size_t n)
+{
+    IMFSample* s = NULL; IMFMediaBuffer* b = NULL; BYTE* d = NULL;
+    if (FAILED(s_mf.CreateSample(&s)) || FAILED(s_mf.CreateMemoryBuffer((DWORD)n, &b)) ||
+        FAILED(IMFMediaBuffer_Lock(b, &d, NULL, NULL))) {
+        if (b) IMFMediaBuffer_Release(b);
+        if (s) IMFSample_Release(s);
+        return sm_fail(m, "allocating an input sample", E_OUTOFMEMORY);
+    }
+    memcpy(d, p, n);
+    IMFMediaBuffer_Unlock(b);
+    IMFMediaBuffer_SetCurrentLength(b, (DWORD)n);
+    IMFSample_AddBuffer(s, b);
+    IMFMediaBuffer_Release(b);
+    /* Decode order; the presentation time is counted at the output. */
+    IMFSample_SetSampleTime(s, m->in_count * 333667);
+    m->in_count++;
+    int rc = 0;
+    for (;;) {
+        HRESULT hr = IMFTransform_ProcessInput(m->mft, 0, s, 0);
+        if (hr == MF_E_NOTACCEPTING) {
+            if (sm_drain_output(m) < 0 || m->stop) { rc = -1; break; }
+            continue;
+        }
+        if (FAILED(hr)) rc = sm_fail(m, "H.264 decoder ProcessInput", hr);
+        break;
+    }
+    IMFSample_Release(s);
+    if (rc == 0) rc = sm_drain_output(m);
+    return rc;
+}
+
+/* Hands every complete access unit to the decoder. AUs start at an access
+ * unit delimiter (NAL type 9), which every picture in these streams has. */
+static int sm_video_push(SailMovie* m, int flush)
+{
+    size_t start = 0, scan = m->ves_scan < 4 ? 4 : m->ves_scan;
+    const uint8_t* v = m->ves;
+    for (;;) {
+        size_t q = scan, hit = 0; int found = 0;
+        for (; q + 4 <= m->ves_n; q++) {
+            if (v[q] == 0 && v[q + 1] == 0 && v[q + 2] == 1 && (v[q + 3] & 0x1F) == 9) {
+                hit = (q > start && v[q - 1] == 0) ? q - 1 : q;
+                found = 1; break;
+            }
+        }
+        if (!found) { scan = q; break; }
+        if (hit > start && sm_feed_au(m, v + start, hit - start) < 0) return -1;
+        start = hit; scan = q + 4;
+    }
+    if (flush && m->ves_n > start) {
+        if (sm_feed_au(m, v + start, m->ves_n - start) < 0) return -1;
+        start = m->ves_n;
+    }
+    memmove(m->ves, m->ves + start, m->ves_n - start);
+    m->ves_n -= start;
+    m->ves_scan = scan > start ? scan - start : 0;
+    return 0;
+}
+
+/* ----------------------------------------------------------- ATRAC3plus */
+
+static void sm_audio_put(SailMovie* m, float* const* pl, int n)
+{
+    const int oc = m->out_ch;
+    AcquireSRWLockExclusive(&m->lock);
+    for (int i = 0; i < n; i++) {
+        if (m->ar_n == m->ar_cap) {   /* nobody is reading: drop the oldest */
+            m->ar_head = (m->ar_head + 1) % m->ar_cap;
+            m->ar_n--;
+        }
+        float* o = m->ar + (size_t)((m->ar_head + m->ar_n) % m->ar_cap) * oc;
+        /* Decoder planes come in channel-unit order; for 5.1 that is
+         * L R | C | Ls Rs | LFE. */
+        const float L = pl[0][i], R = m->at3_ch > 1 ? pl[1][i] : L;
+        if (oc == 6 && m->at3_ch == 6) {
+            o[0] = L; o[1] = pl[2][i]; o[2] = R; o[3] = pl[3][i]; o[4] = pl[4][i]; o[5] = pl[5][i];
+        } else if (oc == 2) {
+            if (m->at3_ch >= 6) {
+                const float c = pl[2][i] * 0.7071f;
+                o[0] = (L + c + pl[3][i] * 0.7071f) * 0.5f;
+                o[1] = (R + c + pl[4][i] * 0.7071f) * 0.5f;
+            } else { o[0] = L; o[1] = R; }
+        } else {
+            for (int c = 0; c < oc; c++) o[c] = c < m->at3_ch ? pl[c][i] : 0.0f;
+        }
+        m->ar_n++;
+    }
+    ReleaseSRWLockExclusive(&m->lock);
+}
+
+static void sm_audio_push(SailMovie* m)
+{
+    static const int chmap[8] = {0, 1, 2, 3, 4, 6, 7, 8};
+    size_t q = 0;
+    float planes[8][SM_AT3_SAMPLES];
+    float* pl[8];
+    for (int c = 0; c < 8; c++) pl[c] = planes[c];
+    while (q + 8 <= m->aes_n) {
+        const uint8_t* h = m->aes + q;
+        if (h[0] != 0x0F || h[1] != 0xD0) {   /* resync on the next AU header */
+            q++;
+            continue;
+        }
+        const int fs = ((((h[2] & 3) << 8) | h[3]) * 8) + 8;
+        const int ch = chmap[(h[2] >> 2) & 7];
+        if (q + 8 + (size_t)fs > m->aes_n) break;
+        if (!m->at3 && ch > 0 && m->out_ch > 0) {
+            int ba = fs;
+            m->at3 = at3p_open(ch, &ba);
+            m->at3_ch = ch; m->at3_fs = fs;
+            if (!m->at3) {
+                fprintf(stderr, "[sail_movie] ATRAC3plus %d ch decoder unavailable; movie plays silent\n", ch);
+                m->out_ch = 0;
+            } else {
+                fprintf(stderr, "[sail_movie] ATRAC3plus %d ch, %d-byte frames\n", ch, fs);
+            }
+        }
+        if (m->at3 && fs == m->at3_fs) {
+            int n = 0;
+            if (at3p_decode_multi(m->at3, pl, &n, h + 8, fs) < 0 || n != SM_AT3_SAMPLES) {
+                for (int c = 0; c < 8; c++) memset(planes[c], 0, sizeof planes[c]);
+                n = SM_AT3_SAMPLES;   /* a bad frame plays as silence */
+            }
+            sm_audio_put(m, pl, n);
+        }
+        q += 8 + (size_t)fs;
+    }
+    memmove(m->aes, m->aes + q, m->aes_n - q);
+    m->aes_n -= q;
+}
+
+/* ------------------------------------------------------------- demuxing */
+
+static int sm_append(uint8_t** buf, size_t* n, size_t* cap, const uint8_t* p, size_t k)
+{
+    if (*n + k > *cap) {
+        size_t c = *cap ? *cap : (1u << 20);
+        while (c < *n + k) c *= 2;
+        uint8_t* nb = (uint8_t*)realloc(*buf, c);
+        if (!nb) return -1;
+        *buf = nb; *cap = c;
+    }
+    memcpy(*buf + *n, p, k);
+    *n += k;
+    return 0;
+}
+
+static int sm_pack(SailMovie* m, const uint8_t* s)
+{
+    size_t p = 0;
+    while (p + 6 <= SM_PACK) {
+        const uint32_t sc = rd32(s + p);
+        if (sc == 0x000001BA) { p += 14 + (s[p + 13] & 7); continue; }
+        if ((sc >> 8) != 1) break;                         /* rest of the pack is stuffing */
+        const uint8_t sid = (uint8_t)sc;
+        const size_t len = ((size_t)s[p + 4] << 8) | s[p + 5];
+        if (p + 6 + len > SM_PACK) break;
+        const uint8_t* body = s + p + 6;
+        if ((sid == 0xE0 || sid == 0xBD) && len >= 3) {
+            const size_t hl = 3 + (size_t)body[2];
+            if (hl <= len) {
+                const uint8_t* pay = body + hl;
+                size_t pn = len - hl;
+                if (sid == 0xE0) {
+                    if (sm_append(&m->ves, &m->ves_n, &m->ves_cap, pay, pn) < 0) return sm_fail(m, "video buffer", E_OUTOFMEMORY);
+                    if (sm_video_push(m, 0) < 0) return -1;
+                } else if (pn >= 4 && pay[0] < 0x10 && m->out_ch > 0) {
+                    /* ATRAC3plus on private stream 1: a 4-byte header (sub
+                     * stream id, 0, offset of the first AU), then AU bytes. */
+                    if (sm_append(&m->aes, &m->aes_n, &m->aes_cap, pay + 4, pn - 4) < 0) return sm_fail(m, "audio buffer", E_OUTOFMEMORY);
+                    sm_audio_push(m);
+                }
+            }
+        }
+        p += 6 + len;
+    }
+    return 0;
+}
+
+static DWORD WINAPI sm_thread(LPVOID arg)
+{
+    SailMovie* m = (SailMovie*)arg;
+    const HRESULT co = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    uint8_t* pack = (uint8_t*)malloc(SM_PACK);
+    int rc = pack ? sm_mft_open(m) : sm_fail(m, "pack buffer", E_OUTOFMEMORY);
+    if (rc == 0) {
+        _fseeki64(m->f, (long long)m->data_off, SEEK_SET);
+        for (uint64_t at = m->data_off; at + SM_PACK <= m->data_end && !m->stop; at += SM_PACK) {
+            if (fread(pack, 1, SM_PACK, m->f) != SM_PACK) break;
+            if (sm_pack(m, pack) < 0) { rc = -1; break; }
+        }
+    }
+    if (rc == 0 && !m->stop) {
+        if (sm_video_push(m, 1) == 0) {
+            IMFTransform_ProcessMessage(m->mft, MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+            IMFTransform_ProcessMessage(m->mft, MFT_MESSAGE_COMMAND_DRAIN, 0);
+            sm_drain_output(m);
+        }
+    }
+    if (m->mft) { IMFTransform_Release(m->mft); m->mft = NULL; }
+    if (m->at3) { at3p_close(m->at3); m->at3 = NULL; }
+    free(pack);
+    if (SUCCEEDED(co)) CoUninitialize();
+    AcquireSRWLockExclusive(&m->lock);
+    m->done = 1;
+    ReleaseSRWLockExclusive(&m->lock);
+    fprintf(stderr, "[sail_movie] decoder %s: %lld frames, %s\n", m->failed ? "failed" : "finished",
+            (long long)m->frames_out, m->path);
+    return 0;
+}
+
+/* ------------------------------------------------------------ public API */
+
+int sail_movie_start(SailMovie* m, int layout, uint8_t alpha, int audio_channels)
+{
+    if (!m || m->thread) return -1;
+    m->layout = layout;
+    m->alpha = alpha;
+    m->out_ch = m->info.audio_channels ? audio_channels : 0;
+    const size_t px = (size_t)m->info.width * m->info.height;
+    const size_t fb = layout == SAIL_MOVIE_YUV420 ? px + px / 2 : px * 4;
+    for (int i = 0; i < SM_VQ; i++)
+        if (!(m->vq[i].px = (uint8_t*)malloc(fb))) return sm_fail(m, "frame queue", E_OUTOFMEMORY);
+    if (m->out_ch > 0) {
+        m->ar_cap = (m->info.audio_rate ? m->info.audio_rate : 48000) * SM_ARING_SECONDS;
+        if (!(m->ar = (float*)malloc((size_t)m->ar_cap * m->out_ch * sizeof(float))))
+            return sm_fail(m, "audio ring", E_OUTOFMEMORY);
+    }
+    m->thread = CreateThread(NULL, 0, sm_thread, m, 0, NULL);
+    if (!m->thread) return sm_fail(m, "starting the decode thread", HRESULT_FROM_WIN32(GetLastError()));
+    return 0;
+}
+
+int sail_movie_take_frame(SailMovie* m, int64_t t, uint8_t* dst, int dst_pitch, int64_t* pts)
+{
+    if (!m) return -1;
+    int rc = 0;
+    AcquireSRWLockExclusive(&m->lock);
+    /* Drop frames that are already late behind a newer due one. */
+    while (m->vq_n > 1 && m->vq[(m->vq_head + 1) % SM_VQ].pts <= t) {
+        m->vq_head = (m->vq_head + 1) % SM_VQ;
+        m->vq_n--;
+        WakeAllConditionVariable(&m->cv);
+    }
+    if (m->vq_n > 0 && m->vq[m->vq_head].pts <= t) {
+        const SmFrame* fr = &m->vq[m->vq_head];
+        const int w = m->info.width, h = m->info.height;
+        if (m->layout == SAIL_MOVIE_YUV420) {
+            for (int r = 0; r < h; r++)
+                memcpy(dst + (size_t)r * dst_pitch, fr->px + (size_t)r * w, (size_t)w);
+            const int cw = w / 2, ch = h / 2, cp = dst_pitch / 2;
+            const uint8_t* su = fr->px + (size_t)w * h;
+            const uint8_t* sv = su + (size_t)cw * ch;
+            uint8_t* du = dst + (size_t)h * dst_pitch;
+            uint8_t* dv = du + (size_t)h * dst_pitch / 4;
+            for (int r = 0; r < ch; r++) {
+                memcpy(du + (size_t)r * cp, su + (size_t)r * cw, (size_t)cw);
+                memcpy(dv + (size_t)r * cp, sv + (size_t)r * cw, (size_t)cw);
+            }
+        } else {
+            const int row = w * 4;
+            for (int r = 0; r < h; r++)
+                memcpy(dst + (size_t)r * dst_pitch, fr->px + (size_t)r * row, (size_t)row);
+        }
+        if (pts) *pts = fr->pts;
+        m->last_taken = fr->pts;
+        m->vq_head = (m->vq_head + 1) % SM_VQ;
+        m->vq_n--;
+        WakeAllConditionVariable(&m->cv);
+        rc = 1;
+    } else if (m->vq_n == 0 && m->done &&
+               (m->last_taken < 0 || t >= m->last_taken + m->frame_dur)) {
+        rc = -1;
+    }
+    ReleaseSRWLockExclusive(&m->lock);
+    return rc;
+}
+
+int sail_movie_read_audio(SailMovie* m, float* out, int frames)
+{
+    if (!m || m->out_ch <= 0 || !m->ar) return 0;
+    AcquireSRWLockExclusive(&m->lock);
+    int n = frames < m->ar_n ? frames : m->ar_n;
+    for (int i = 0; i < n; i++) {
+        memcpy(out + (size_t)i * m->out_ch, m->ar + (size_t)m->ar_head * m->out_ch,
+               (size_t)m->out_ch * sizeof(float));
+        m->ar_head = (m->ar_head + 1) % m->ar_cap;
+    }
+    m->ar_n -= n;
+    ReleaseSRWLockExclusive(&m->lock);
+    return n;
+}
+
+int sail_movie_failed(SailMovie* m) { return m ? m->failed : 1; }
+
+void sail_movie_close(SailMovie* m)
+{
+    if (!m) return;
+    if (m->thread) {
+        AcquireSRWLockExclusive(&m->lock);
+        InterlockedExchange(&m->stop, 1);
+        WakeAllConditionVariable(&m->cv);
+        ReleaseSRWLockExclusive(&m->lock);
+        WaitForSingleObject(m->thread, INFINITE);
+        CloseHandle(m->thread);
+    }
+    if (m->f) fclose(m->f);
+    for (int i = 0; i < SM_VQ; i++) free(m->vq[i].px);
+    free(m->ar); free(m->ves); free(m->aes);
+    free(m);
+}
+
+#endif /* _WIN32 */
diff --git a/libs/codec/sail_movie.h b/libs/codec/sail_movie.h
new file mode 100644
--- /dev/null
+++ b/libs/codec/sail_movie.h
@@ -0,0 +1,83 @@
+/*
+ * ps3recomp - host-side movie decoder behind cellSail
+ *
+ * Plays a PAMF movie (MPEG program stream: H.264 video on stream 0xE0,
+ * ATRAC3plus audio on private stream 1) for libs/codec/cellSail.c. Nothing in
+ * here touches guest memory or guest calls; cellSail owns that side.
+ *
+ *   video  Windows Media Foundation's H.264 decoder (msmpeg2vdec, part of
+ *          Windows), loaded at run time, so nothing extra is linked or shipped.
+ *   audio  the ATRAC3plus decoder cellAtrac already links
+ *          (third_party/at3_standalone, LGPL-2.1). A build with
+ *          PS3RECOMP_ATRAC_LGPL=OFF plays the picture without sound.
+ *
+ * Other hosts have no video decoder here yet: sail_movie_open says so and the
+ * caller keeps its old skip.
+ *
+ * A decode thread runs ahead of playback and fills a short queue of converted
+ * frames and a ring of PCM. The caller owns the clock: it asks for the frame
+ * due at a media time and pulls PCM as its audio output needs it.
+ */
+
+#ifndef PS3RECOMP_SAIL_MOVIE_H
+#define PS3RECOMP_SAIL_MOVIE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct SailMovie SailMovie;
+
+typedef struct SailMovieInfo {
+    int width, height;          /* displayed picture size */
+    int fps_num, fps_den;       /* frame rate; 30000/1001 when the header has none */
+    int audio_channels;         /* 0 = no ATRAC3plus stream */
+    int audio_rate;             /* Hz */
+} SailMovieInfo;
+
+/* Pixel layouts sail_movie_start can produce. ARGB and RGBA are 4 bytes per
+ * pixel in memory order. YUV420 is planar 8-bit Y, then U, then V, each
+ * chroma plane half the width and height with half the Y pitch, U starting
+ * height * pitch bytes in and V a quarter of that after U. */
+enum { SAIL_MOVIE_ARGB = 0, SAIL_MOVIE_RGBA = 1, SAIL_MOVIE_YUV420 = 2 };
+
+/* Opens and probes a PAMF file. NULL on failure, with the reason in why. */
+SailMovie* sail_movie_open(const char* host_path, SailMovieInfo* info,
+                           char* why, size_t why_n);
+
+/* Starts decoding. layout is a SAIL_MOVIE_* value, alpha the byte written as
+ * every pixel's alpha, audio_channels the interleaved channel count the
+ * caller will read (6: L C R Ls Rs LFE, 2: stereo downmix, 0: no audio).
+ * Returns 0, or -1 with the reason logged. */
+int sail_movie_start(SailMovie* m, int layout, uint8_t alpha, int audio_channels);
+
+/* The frame due at media time t (in 90 kHz ticks from the first frame).
+ * Copies it to dst (rows of dst_pitch bytes) when it is newer than the last
+ * one taken, and returns
+ *    1  a new frame was copied; *pts gets its time (same units as t)
+ *    0  nothing new is due yet (the last frame stays on screen)
+ *   -1  the movie has ended: every frame was taken and the decoder is done
+ * Frames whose time has passed are dropped, so a slow caller skips frames
+ * rather than falling behind. */
+int sail_movie_take_frame(SailMovie* m, int64_t t, uint8_t* dst, int dst_pitch,
+                          int64_t* pts);
+
+/* Up to `frames` frames of interleaved float PCM, in the channel layout given
+ * to sail_movie_start. Returns the count read; fewer means the decoder has not
+ * caught up (or the audio has ended). */
+int sail_movie_read_audio(SailMovie* m, float* out, int frames);
+
+/* True once the decoder failed; the reason was logged. */
+int sail_movie_failed(SailMovie* m);
+
+/* Stops the decode thread and frees everything. NULL is allowed. */
+void sail_movie_close(SailMovie* m);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SAIL_MOVIE_H */
