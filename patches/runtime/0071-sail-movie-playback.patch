+/* ---------------------------------------------------------------------------
+ * Movie playback.
+ *
+ * OpenStream opens the descriptor's file with sail_movie_open; Start hands
+ * the title's adapters their format and buffers and starts the decoder; the
+ * title then pulls pictures with GraphicsAdapterGetFrame2 (once per frame,
+ * main thread) and PCM with SoundAdapterGetFrame (its audio thread). The
+ * clock is the host's, started when the first picture is handed out; sound
+ * is held back until then so the two start together. When the last picture
+ * has been shown GetFrame2 reports the end of the stream the way the skip
+ * did (STOP_TRANSITION, then OPENED), and the title closes the stream.
+ *
+ * What Hot Shots Golf does with them (lifted code, official 1.03):
+ *   - graphics adapter at player+0x500, callbacks {NULL, NULL, FormatChanged
+ *     0x00D68AF0, Alloc 0x00D68AF8, Free 0x00D68B00}, all forwarding to the
+ *     owner's vtable; preferred format {coding from its config, alpha 0xFF,
+ *     everything else -1};
+ *   - per frame (0x00877E34): GetFrame2(adapter, &info, NULL, &flip, flags);
+ *     a result <= 0xFF is "no picture". On a new info.sessionId it calls
+ *     GraphicsAdapterGetFormat and binds info.pBuffer as a texture of that
+ *     coding / width / height / pitch, then PtsToTimePosition(info.pts);
+ *   - sound (0x008763F0): SoundAdapterGetFrame(adapter, n <= 256, &info);
+ *     on a new sessionId SoundAdapterGetFormat picks the channel layout, then
+ *     n frames of chNum big-endian floats are read from info.pBuffer.
+ *
+ * PS3_SAIL_MOVIES=0 turns all of this off and keeps the skip.
+ * -----------------------------------------------------------------------*/
+
+#define SAIL_SYNC_ON_TIME   (1u << 2)
+#define SAIL_SYNC_REPEATED  (1u << 8)
+#define SAIL_SYNC_NEXT      (2u << 8)
+#define SAIL_GFX_FRAMES     3          /* pictures in flight: shown, queued, being written */
+#define SAIL_PCM_MAX        2048       /* frames per SoundAdapterGetFrame we can serve */
+#define SAIL_ADAPTER_MAX    4
+
+/* Adapters, keyed by the guest struct EA the title initialised. The callback
+ * tables the title passes live on its stack, so they are copied. */
+static struct {
+    u32 self_ea, arg;
+    u32 cb[5];                 /* makeup, cleanup, formatChanged, alloc, free */
+    u8  pref[32];              /* CellSailVideoFormat, guest byte order */
+} s_gadapters[SAIL_ADAPTER_MAX];
+static struct {
+    u32 self_ea, arg;
+    u32 cb[3];                 /* makeup, cleanup, formatChanged */
+    u8  pref[24];              /* CellSailAudioFormat, guest byte order */
+} s_sadapters[SAIL_ADAPTER_MAX];
+
+typedef struct SailSession {
+    SailMovie* mv;
+    SailMovieInfo info;
+    int started;               /* decoder running and buffers handed out */
+    int ended;                 /* end of stream reported */
+    u32 session_id;
+    /* graphics */
+    int coding;                /* 0 ARGB, 1 RGBA interleaved, 3 YUV420 planar */
+    u8  alpha;
+    u32 fmt_ea;                /* CellSailVideoFormat handed to FormatChanged */
+    u32 frames_ea;             /* the u32[] Alloc filled */
+    u32 frame[SAIL_GFX_FRAMES];
+    int frame_num, frame_from_title;
+    u32 frame_size, pitch;
+    int cur;                   /* frame[] shown last, -1 = none yet */
+    u32 tag;
+    int64_t cur_pts;
+    u64 frames_shown;
+    /* clock (host ticks) */
+    int64_t t0, pause_at;
+    /* sound */
+    int ach;                   /* channels handed to the title, 0 = no sound */
+    u32 pcm[2];
+    int pcm_idx;
+    u32 sound_tag;
+    int64_t sound_frames;
+} SailSession;
+
+/* GetFrame2 runs on the title's main thread, SoundAdapterGetFrame on its
+ * audio thread, Stop/Close on whichever thread drives the player: one lock. */
+#ifdef _WIN32
+static SRWLOCK s_sess_lock = SRWLOCK_INIT;
+static void sess_lock(void)   { AcquireSRWLockExclusive(&s_sess_lock); }
+static void sess_unlock(void) { ReleaseSRWLockExclusive(&s_sess_lock); }
+static int64_t host_ticks(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+static int64_t host_freq(void)  { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return f.QuadPart; }
+#else
+static pthread_mutex_t s_sess_lock = PTHREAD_MUTEX_INITIALIZER;
+static void sess_lock(void)   { pthread_mutex_lock(&s_sess_lock); }
+static void sess_unlock(void) { pthread_mutex_unlock(&s_sess_lock); }
+static int64_t host_ticks(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (int64_t)t.tv_sec * 1000000000 + t.tv_nsec; }
+static int64_t host_freq(void)  { return 1000000000; }
+#endif
+
+static int sail_movies_enabled(void)
+{
+    const char* e = getenv("PS3_SAIL_MOVIES");
+    return !(e && e[0] == '0');
+}
+
+static int sail_gadapter(u32 ea)
+{
+    for (int i = 0; ea && i < SAIL_ADAPTER_MAX; i++)
+        if (s_gadapters[i].self_ea == ea) return i;
+    return -1;
+}
+
+static int sail_sadapter(u32 ea)
+{
+    for (int i = 0; ea && i < SAIL_ADAPTER_MAX; i++)
+        if (s_sadapters[i].self_ea == ea) return i;
+    return -1;
+}
+
+/* The player an adapter was set on. */
+static int sail_player_of_gadapter(u32 ea)
+{
+    for (int i = 0; i < CELL_SAIL_PLAYER_MAX; i++)
+        if (s_sail_players[i].in_use && s_sail_players[i].gadapter == ea) return i;
+    return -1;
+}
+
+static int sail_player_of_sadapter(u32 ea)
+{
+    for (int i = 0; i < CELL_SAIL_PLAYER_MAX; i++)
+        if (s_sail_players[i].in_use && s_sail_players[i].sadapter == ea) return i;
+    return -1;
+}
+
+/* Guest memory from the player's CellSailMemAllocator:
+ * alloc(pArg, boundary, size) -> pointer, free(pArg, boundary, pointer). */
+static u32 sail_guest_alloc(int sp, u32 boundary, u32 size)
+{
+    const u32 opd = s_sail_players[sp].alloc_opd;
+    if (!opd) return 0;
+    return (u32)ppu_guest_call(opd, s_sail_players[sp].alloc_arg, boundary, size, 0, 0, 0, 0, 0);
+}
+
+static void sail_guest_free(int sp, u32 boundary, u32 ea)
+{
+    const u32 opd = s_sail_players[sp].free_opd;
+    if (opd && ea) ppu_guest_call(opd, s_sail_players[sp].alloc_arg, boundary, ea, 0, 0, 0, 0, 0);
+}
+
+static u8 sail_frame_rate_code(const SailMovieInfo* in)
+{
+    static const int rates[8][2] = {{24000, 1001}, {24, 1}, {25, 1}, {30000, 1001},
+                                    {30, 1}, {50, 1}, {60000, 1001}, {60, 1}};
+    for (int i = 0; i < 8; i++)
+        if (rates[i][0] == in->fps_num && rates[i][1] == in->fps_den) return (u8)i;
+    return 0xFF;   /* UNSPECIFIED */
+}
+
+static void sail_write_video_format(const SailSession* m, u32 ea)
+{
+    vm_write8(ea + 0, (u8)m->coding);
+    vm_write8(ea + 1, 0);                         /* SCAN_PROGRESSIVE */
+    vm_write8(ea + 2, 8);                         /* bits per colour */
+    vm_write8(ea + 3, sail_frame_rate_code(&m->info));
+    vm_write16(ea + 4, (u16)m->info.width);
+    vm_write16(ea + 6, (u16)m->info.height);
+    vm_write32(ea + 8, m->pitch);
+    vm_write32(ea + 12, m->alpha);
+    vm_write8(ea + 16, 1);                        /* COLOR_MATRIX_BT709 (applied already for RGB) */
+    vm_write8(ea + 17, 1);                        /* ASPECT_RATIO_1_1 */
+    vm_write8(ea + 18, m->coding == 3 ? 1 : 0);   /* RGB out is full range; YUV kept limited
+                                                     (value 1 assumed; the title reads only the matrix) */
+    vm_write8(ea + 19, 0xFF);
+    vm_write32(ea + 20, 0xFFFFFFFFu);
+    vm_write64(ea + 24, ~0ull);
+}
+
+/* CellSailAudioFormat: float PCM, 48 kHz, 5.1 as L C R Ls Rs LFE or stereo. */
+static void sail_write_audio_format(const SailSession* m, u32 ea)
+{
+    vm_write8(ea + 0, 1);                         /* LPCM_FLOAT32 */
+    vm_write8(ea + 1, (u8)m->ach);
+    vm_write16(ea + 2, 0xFFFF);                   /* sampleNum unspecified */
+    vm_write32(ea + 4, (u32)(m->info.audio_rate ? m->info.audio_rate : 48000));
+    vm_write32(ea + 8, m->ach == 6 ? 8u : 2u);    /* CH_LAYOUT_6CH_LCRlrE / 2CH_LR */
+    vm_write32(ea + 12, 0xFFFFFFFFu);
+    vm_write64(ea + 16, ~0ull);
+}
+
+/* Takes the session off the player, so the adapters stop seeing it. */
+static SailSession* sail_session_detach(int sp)
+{
+    sess_lock();
+    SailSession* m = s_sail_players[sp].sess;
+    s_sail_players[sp].sess = NULL;
+    sess_unlock();
+    return m;
+}
+
+/* Stops the decoder and frees what Start allocated. Runs without the lock:
+ * it calls back into the title. */
+static void sail_session_free(int sp, SailSession* m)
+{
+    if (!m) return;
+    sail_movie_close(m->mv);
+    const int g = sail_gadapter(s_sail_players[sp].gadapter);
+    if (m->frame_from_title) {
+        if (g >= 0 && s_gadapters[g].cb[4])
+            ppu_guest_call(s_gadapters[g].cb[4], s_gadapters[g].arg, (u64)m->frame_num,
+                           m->frames_ea, 0, 0, 0, 0, 0);
+    } else {
+        for (int i = 0; i < SAIL_GFX_FRAMES; i++) sail_guest_free(sp, 128, m->frame[i]);
+    }
+    sail_guest_free(sp, 16, m->frames_ea);
+    sail_guest_free(sp, 16, m->fmt_ea);
+    sail_guest_free(sp, 128, m->pcm[0]);
+    sail_guest_free(sp, 128, m->pcm[1]);
+    if (m->started)
+        printf("[cellSail] movie closed after %llu pictures\n", (unsigned long long)m->frames_shown);
+    free(m);
+}
+
+/* OpenStream: probe the descriptor's file. Leaves sess NULL (skip) when the
+ * movie cannot be played, and says why. */
+static void sail_session_open(int sp, const char* uri)
+{
+    if (!sail_movies_enabled()) {
+        printf("[cellSail] movies off (PS3_SAIL_MOVIES=0)\n");
+        return;
+    }
+    const char* path = uri;
+    if (strncmp(path, "x-cell-fs://", 12) == 0) path += 12;
+    char host[1024];
+    char why[160] = "";
+    SailMovieInfo info;
+    SailMovie* mv = NULL;
+    host[0] = '\0';
+    ppu_fs_host_path(host, sizeof host, path);
+    if (!host[0])
+        snprintf(why, sizeof why, "no host path for %s", path);
+    else
+        mv = sail_movie_open(host, &info, why, sizeof why);
+    if (!mv) {
+        printf("[cellSail] cannot play %s: %s\n", uri, why);
+        return;
+    }
+    SailSession* m = (SailSession*)calloc(1, sizeof *m);
+    if (!m) { sail_movie_close(mv); return; }
+    m->mv = mv;
+    m->info = info;
+    m->cur = -1;
+    static u32 s_session;
+    m->session_id = ++s_session;
+    sail_session_free(sp, sail_session_detach(sp));
+    sess_lock();
+    s_sail_players[sp].sess = m;
+    sess_unlock();
+    printf("[cellSail] movie %s: %dx%d %d/%d fps, %d audio channels\n", uri, info.width,
+           info.height, info.fps_num, info.fps_den, info.audio_channels);
+}
+
+/* Start: give the adapters their format and buffers and start decoding.
+ * Returns 0, or -1 when the movie has to be skipped after all (logged). */
+static int sail_session_start(int sp)
+{
+    SailSession* m = s_sail_players[sp].sess;
+    if (!m) return -1;
+    const int g = sail_gadapter(s_sail_players[sp].gadapter);
+    if (g < 0) { printf("[cellSail] no graphics adapter set; movie skipped\n"); return -1; }
+    const s8 want = (s8)s_gadapters[g].pref[0];
+    if (want != 0 && want != 1 && want != 3 && want != -1) {
+        printf("[cellSail] graphics adapter wants coding %d, only ARGB, RGBA and YUV420 "
+               "planar are produced; movie skipped\n", want);
+        return -1;
+    }
+    m->coding = want == -1 ? 0 : want;
+    const u8* pa = &s_gadapters[g].pref[12];
+    const s32 pref_alpha = (s32)(((u32)pa[0] << 24) | ((u32)pa[1] << 16) | ((u32)pa[2] << 8) | pa[3]);
+    m->alpha = pref_alpha >= 0 && pref_alpha <= 255 ? (u8)pref_alpha : 0xFF;
+    if (m->coding == 3) {   /* Y, then U and V at half the pitch (func_00BCF514) */
+        m->pitch = (u32)m->info.width;
+        m->frame_size = m->pitch * (u32)m->info.height * 3u / 2u;
+    } else {
+        m->pitch = (u32)m->info.width * 4;
+        m->frame_size = m->pitch * (u32)m->info.height;
+    }
+
+    /* The format, then the picture buffers, from the title's own callbacks
+     * the way libsail asks for them; the player's allocator if it has none. */
+    m->fmt_ea = sail_guest_alloc(sp, 16, 32);
+    m->frames_ea = sail_guest_alloc(sp, 16, 4 * SAIL_GFX_FRAMES);
+    if (!m->fmt_ea || !m->frames_ea) {
+        printf("[cellSail] player allocator gave no memory; movie skipped\n");
+        return -1;
+    }
+    sail_write_video_format(m, m->fmt_ea);
+    if (s_gadapters[g].cb[2])
+        ppu_guest_call(s_gadapters[g].cb[2], s_gadapters[g].arg, m->fmt_ea, m->session_id,
+                       0, 0, 0, 0, 0);
+    m->frame_num = SAIL_GFX_FRAMES;
+    for (int i = 0; i < SAIL_GFX_FRAMES; i++) vm_write32(m->frames_ea + 4u * i, 0);
+    if (s_gadapters[g].cb[3]) {
+        const s32 rc = (s32)ppu_guest_call(s_gadapters[g].cb[3], s_gadapters[g].arg, m->frame_size,
+                                           (u64)SAIL_GFX_FRAMES, m->frames_ea, 0, 0, 0, 0);
+        /* The result is how many pictures the title could give. Hot Shots
+         * Golf's movie pool (0x600000 bytes at 0x17600000) holds two 1080p
+         * YUV420 pictures: it returns 2 and still writes a third pointer,
+         * past the pool's end and into the next block. Use only the first rc. */
+        int ok = rc >= 1;
+        if (ok && rc < SAIL_GFX_FRAMES) m->frame_num = rc;
+        for (int i = 0; i < m->frame_num; i++) {
+            m->frame[i] = vm_read32(m->frames_ea + 4u * i);
+            if (!m->frame[i]) ok = 0;
+        }
+        printf("[cellSail] graphics adapter Alloc(%u bytes x %d) -> %d [0x%08X 0x%08X 0x%08X]\n",
+               m->frame_size, SAIL_GFX_FRAMES, rc, m->frame[0], m->frame[1], m->frame[2]);
+        m->frame_from_title = ok;
+        if (!ok) {
+            if (rc >= 1 && s_gadapters[g].cb[4])
+                ppu_guest_call(s_gadapters[g].cb[4], s_gadapters[g].arg, (u64)m->frame_num,
+                               m->frames_ea, 0, 0, 0, 0, 0);
+            memset(m->frame, 0, sizeof m->frame);
+            m->frame_num = SAIL_GFX_FRAMES;
+        }
+    }
+    if (!m->frame_from_title) {
+        for (int i = 0; i < SAIL_GFX_FRAMES; i++)
+            if (!(m->frame[i] = sail_guest_alloc(sp, 128, m->frame_size))) {
+                printf("[cellSail] no memory for %u-byte pictures; movie skipped\n", m->frame_size);
+                return -1;
+            }
+        printf("[cellSail] pictures from the player allocator: 0x%08X 0x%08X 0x%08X\n",
+               m->frame[0], m->frame[1], m->frame[2]);
+    }
+
+    /* Sound: float PCM in the layout the title prefers (5.1 or stereo). */
+    const int sa = sail_sadapter(s_sail_players[sp].sadapter);
+    if (sa >= 0 && m->info.audio_channels > 0) {
+        const s8 pch = (s8)s_sadapters[sa].pref[1];
+        m->ach = (pch == 1 || pch == 2 || m->info.audio_channels < 6) ? 2 : 6;
+        const u32 bytes = SAIL_PCM_MAX * (u32)m->ach * 4u;
+        m->pcm[0] = sail_guest_alloc(sp, 128, bytes);
+        m->pcm[1] = sail_guest_alloc(sp, 128, bytes);
+        if (!m->pcm[0] || !m->pcm[1]) {
+            printf("[cellSail] no memory for movie sound; playing without it\n");
+            m->ach = 0;
+        }
+    }
+    const int layout = m->coding == 3 ? SAIL_MOVIE_YUV420
+                     : m->coding == 1 ? SAIL_MOVIE_RGBA : SAIL_MOVIE_ARGB;
+    if (sail_movie_start(m->mv, layout, m->alpha,
+                         m->ach) < 0) {
+        printf("[cellSail] decoder did not start; movie skipped\n");
+        return -1;
+    }
+    m->started = 1;
+    printf("[cellSail] playing: coding %d, %u-byte pictures, sound %d ch\n", m->coding,
+           m->frame_size, m->ach);
+    fflush(stdout);
+    return 0;
+}
+
+static int64_t sail_clock_90k(const SailSession* m)
+{
+    if (!m->t0) return 0;
+    const int64_t now = m->pause_at ? m->pause_at : host_ticks();
+    return (now - m->t0) * 90000 / host_freq();
+}
+
+static void sail_write_frame_info(u32 ea, u32 buffer, u32 session, u32 tag, int64_t pts)
+{
+    vm_write32(ea + 0, buffer);
+    vm_write32(ea + 4, session);
+    vm_write32(ea + 8, tag);
+    vm_write32(ea + 12, 0);
+    vm_write64(ea + 16, (u64)pts);
+}
