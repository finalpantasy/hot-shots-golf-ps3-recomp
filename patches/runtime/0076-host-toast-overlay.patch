+/*
+ * Host-side toast overlay: a few lines of text in a semi-transparent panel,
+ * drawn by the renderer over the presented frame (top right, scaled to the
+ * output size). Game code posts a toast; the D3D12 present path draws it for
+ * the given time with a fade, then pops the next one. Text is rasterized at
+ * runtime with GDI from a Windows system font (no font files, no game assets).
+ *
+ * rsx_overlay_post() is safe from any thread. With nothing posted, the
+ * per-frame cost is one load (rsx_overlay_active()).
+ */
+#ifndef RSX_OVERLAY_H
+#define RSX_OVERLAY_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Queue one toast of n lines (UTF-8, at most 8 are kept) shown for ms
+ * milliseconds from the first frame it is drawn. A line may start with
+ * "\x1b" plus a colour letter: w white (default), g gold, r red, p purple,
+ * b blue, d grey. The first line may start with "@" plus a digit for the
+ * place: 0 top right (default), 1 top left, 2 bottom right, 3 top centre
+ * (the last three keep clear of 12% top and bottom bars). */
+void rsx_overlay_post(const char* const* lines, int n, int ms);
+
+/* Nonzero while a toast is showing or queued. */
+int rsx_overlay_active(void);
+
+#if defined(_WIN32) && defined(__d3d12_h__)
+/* Present path: draw the current toast into the backbuffer (RENDER_TARGET
+ * state, R8G8B8A8_UNORM) through rtv. frame is a counter that advances once
+ * per submitted frame (old textures are released some frames later). */
+void rsx_overlay_d3d12_draw(ID3D12Device* dev, ID3D12GraphicsCommandList* cl,
+                            D3D12_CPU_DESCRIPTOR_HANDLE rtv, unsigned w, unsigned h,
+                            unsigned long long frame);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RSX_OVERLAY_H */
