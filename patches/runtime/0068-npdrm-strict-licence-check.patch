diff --git a/libs/network/sceNp.c b/libs/network/sceNp.c
--- a/libs/network/sceNp.c
+++ b/libs/network/sceNp.c
@@ -9,6 +9,7 @@
 #include <stdio.h>
 #include <string.h>
 #include <stdint.h>
+#include <stdlib.h>
 #include <time.h>
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
 #include "np_psnr.h"
@@ -502,12 +503,28 @@
  * that do not apply here.
  * -----------------------------------------------------------------------*/
 
+/* CELL_ENOENT. The game only tests the sign of the result. */
+#define NP_DRM_ERROR_NOT_INSTALLED 0x80010006u
+
 static s32 np_drm_is_available(const u8* k_licensee, const char* drm_path)
 {
     const u8* k = GUEST_PTR(k_licensee, const u8*);
     const char* path = GUEST_PTR(drm_path, const char*);
     /* A NULL klicensee is legal for content that needs none; nothing to record. */
     if (k) edat_add_klicensee(k);
+    /* This returned CELL_OK for every path, so a title that gates DLC on this
+     * call alone (Hot Shots Golf: Drm_IsContentAvailable 0x7E6BD4 tests only
+     * the sign of the result) saw every DLC item as owned even with no licence
+     * file installed. PS3_NPDRM_STRICT=1 reports a missing file as an error, as
+     * hardware does for content that is not installed. Default off: existing
+     * setups keep their current (all-owned) behaviour. */
+    static int strict = -1;
+    if (strict < 0) { const char* e = getenv("PS3_NPDRM_STRICT"); strict = (e && e[0] == '1') ? 1 : 0; }
+    if (strict && path && edat_guest_file_exists(path) == 0) {
+        fprintf(stderr, "[sceNp] DRM availability check: %s -> not installed (0x%08X)\n",
+                path, (unsigned)NP_DRM_ERROR_NOT_INSTALLED);
+        return (s32)NP_DRM_ERROR_NOT_INSTALLED;
+    }
     fprintf(stderr, "[sceNp] DRM availability check: %s\n", path ? path : "(null)");
     return CELL_OK;
 }
