diff --git a/libs/filesystem/edat.c b/libs/filesystem/edat.c
--- a/libs/filesystem/edat.c
+++ b/libs/filesystem/edat.c
@@ -323,6 +323,21 @@
 #define EDAT_GUEST_KLIC_MAX 16
 static uint8_t s_guest_klic[EDAT_GUEST_KLIC_MAX][16];
 static int     s_guest_klic_n = 0;
+
+static edat_host_path_fn s_host_path_fn = NULL;
+
+void edat_set_host_path_fn(edat_host_path_fn fn) { s_host_path_fn = fn; }
+
+int edat_guest_file_exists(const char* guest_path)
+{
+    if (!s_host_path_fn || !guest_path) return -1;
+    char host[1024];
+    s_host_path_fn(host, sizeof host, guest_path);
+    FILE* f = fopen(host, "rb");
+    if (!f) return 0;
+    fclose(f);
+    return 1;
+}
 
