+/* Before recording a draw of up to `verts` vertices: a batch about to run out
+ * of draw records or VP vertex space while it holds no display draw yet is
+ * executed now (not presented) instead of dropping what follows. On a heavy
+ * course the shadow pass alone is 1600-2050 depth-only draws and up to ~1.5M
+ * expanded vertices; it filled MAX_DRAWS (ops=2048, dz=2047) and the vertex
+ * buffer, so the main pass of that frame was never recorded -- the sky dome
+ * drawn first showed through as cyan, or the batch had no display draw and was
+ * not presented (RSX_PROF: "9 frames ... 60 rf"). Only offscreen and depth-only
+ * work is in such a batch, which persists in its own targets; once a display
+ * draw is recorded the batch is left alone, since executing it early would
+ * lose that draw's output to the next batch's backbuffer clear. */
+static void batch_room(u32 verts)
+{
+    if (!s_d3d.initialized || !s_d3d.draw_count) return;
+    if (s_d3d.draw_count + 4u < MAX_DRAWS &&
+        (u64)s_d3d.vp_vb_offset / VP_VERT_STRIDE + verts <= VP_MAX_VERTICES)
+        return;
+    for (u32 _i = 0; _i < s_d3d.draw_count && _i < MAX_DRAWS; _i++)
+        if (dr_is_display_draw(&s_d3d.draws[_i])) return;
+    { static int _n = 0; if (PS3_LOG_FIRST(_n, 3))
+        fprintf(stderr, "[BATCHFULL] %u records, %u verts before any display draw:"
+                        " executing the offscreen part now%c", s_d3d.draw_count,
+                (unsigned)(s_d3d.vp_vb_offset / VP_VERT_STRIDE), 10); }
+    s_present_this_frame = 0;
+    s_rf_why = "full";
+    render_frame();
+    s_present_this_frame = 1;
+}
