+static int aspect_fit_on(void) { return aspect_mode() != 0; }
+
+static float aspect_expand_k(void)
+{
+    if (aspect_mode() != 2 || !s_d3d.width || !s_d3d.height) return 1.0f;
+    const float k = ((float)s_d3d.width / (float)s_d3d.height) / (16.0f / 9.0f);
+    return k > 1.002f ? k : 1.0f;
+}
+
+/* Expand mode: a display draw whose guest viewport spans the whole surface
+ * width. It gets the full window width (render_frame) and x / k (b0). */
+static int expand_wide_draw(const D3D12DrawRecord* dr)
+{
+    if (!dr || dr->rt_off || dr->no_color || aspect_expand_k() <= 1.0f) return 0;
+    if (dr->surf_w < 16 || dr->surf_h < 16 || dr->surf_w > 4096 || dr->surf_h > 4096) return 0;
+    if (!dr->vp_w || !dr->vp_h) return 1;          /* no guest viewport: the whole target */
+    return dr->vp_x == 0 && dr->vp_w >= dr->surf_w;
+}
+
+/* RSX_ASPECT_HUD=edges: also move 2D elements that lie wholly in the left or
+ * right third of the 16:9 picture out to the window edge on their side.
+ * Default (center): the HUD stays in the centered 16:9 area, where the 2D
+ * markers the game places over 3D objects (gauge, yardage) still line up. */
+static int expand_hud_edges(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_ASPECT_HUD"); v = e && !strcmp(e, "edges"); }
+    return v;
+}
+
+/* Expand mode, per whole-surface display draw (b0 epilogue: pos.x = x * s +
+ * w * o). Default s = 1/k: Hor+ for 3D, centered 16:9 for 2D. A 2D draw --
+ * the program's clip w row is (0,0,0,1) -- gets its clip-space x extent from
+ * its vertices on the CPU: one that spans the whole 16:9 width (a fade, a
+ * menu backdrop, the saved course picture behind the shot close-up) keeps
+ * s = 1 and fills the window; with RSX_ASPECT_HUD=edges an element wholly in
+ * an outer third is offset to that window edge. */
+static void expand_wide_cb(D3D12DrawRecord* dr, int vs_idx, const float* c, float* vpx)
+{
+    const float k = aspect_expand_k();
+    vpx[0] = 1.0f / k;
+    dr->expand_clip = 0;
+    if (!dr->is_vp || vs_idx < 0 || vs_idx >= s_d3d.vp_vs_n || !s_d3d.vp_vb_mapped) return;
+    const int rx = s_d3d.vp_vs[vs_idx].pos_rx, rw = s_d3d.vp_vs[vs_idx].pos_rw;
+    if (rx < 0 || rw < 0) return;
+    const float* cw = c + rw * 4;
+    if (cw[0] != 0.0f || cw[1] != 0.0f || cw[2] != 0.0f || cw[3] != 1.0f) return;   /* not 2D */
+    if (!dr->vertex_count || dr->vertex_count > 256) return;
+    const u32 rm = (vb_pack_on() && dr->pk_mask) ? dr->pk_mask : 0xFFFFu;
+    const u64 end = (u64)dr->vb_byte_offset + (u64)dr->vertex_count * pk_stride_of(rm);
+    if (end > (u64)VP_HALF) return;
+    const u8* vb = (const u8*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity * VP_HALF + dr->vb_byte_offset;
+    const float* cx = c + rx * 4;
+    float lo = 1e30f, hi = -1e30f;
+    for (u32 v = 0; v < dr->vertex_count; v++) {
+        const float* a = pk_rec_attr(vb, rm, v, 0);
+        if (a[3] != 1.0f) return;
+        const float x = a[0] * cx[0] + a[1] * cx[1] + a[2] * cx[2] + cx[3];
+        if (x < lo) lo = x;
+        if (x > hi) hi = x;
+    }
+    if (lo <= -0.98f && hi >= 0.98f) { vpx[0] = 1.0f; return; }   /* full width */
+    if (expand_hud_edges() && hi <= -1.0f / 3.0f) vpx[4] = -(1.0f - 1.0f / k);
+    else if (expand_hud_edges() && lo >= 1.0f / 3.0f) vpx[4] = 1.0f - 1.0f / k;
+    else dr->expand_clip = 1;
+}
+
+/* Expand mode: a display sub-viewport (the hole-number flag, the wind and
+ * ball-lie insets) keeps its 16:9 size and place; with RSX_ASPECT_HUD=edges it
+ * moves to the window edge on its side: -x0 in the left third, +x0 in the
+ * right third, 0 in the middle (x0 = the pillar width fit would use). */
+static float expand_inset_shift(const D3D12DrawRecord* dr)
+{
+    if (!dr || dr->rt_off || dr->no_color || expand_wide_draw(dr) || !dr->vp_w) return 0.0f;
+    if (!expand_hud_edges()) return 0.0f;
+    const float k = aspect_expand_k();
+    if (k <= 1.0f || dr->surf_w < 16 || dr->surf_w > 4096) return 0.0f;
+    const float x0 = ((float)s_d3d.width - (float)s_d3d.width / k) * 0.5f;
+    const float cx = (float)dr->vp_x + (float)dr->vp_w * 0.5f, sw = (float)dr->surf_w;
+    return cx < sw / 3.0f ? -x0 : cx > sw * 2.0f / 3.0f ? x0 : 0.0f;
+}
