+/* RSX_ASPECT=expand: the constant rows a vertex program builds its clip x and
+ * w from, when it writes each lane of o[0] exactly once as
+ *     o[0].c = dot4(v[0], vp_c[N])
+ * (the game's 2D program does: rows 396..399). -1 when it does anything else.
+ * vp_record_cb uses them to find a 2D draw's clip-space extent on the CPU. */
+static void vs_pos_rows(const char* hlsl, int* rx, int* rw)
+{
+    *rx = *rw = -1;
+    int n = 0;
+    for (const char* q = hlsl; (q = strstr(q, "o[0].")) != NULL; q += 5) n++;
+    if (n != 4) return;
+    for (int lane = 0; lane < 2; lane++) {
+        char tail[48];
+        snprintf(tail, sizeof tail, "o[0].%c = _v.%c;", lane ? 'w' : 'x', lane ? 'w' : 'x');
+        const char* t = strstr(hlsl, tail);
+        if (!t) return;
+        const char* head = "vp_dot4(((v[0]).xyzw),((vp_c[";
+        const char* best = NULL;
+        for (const char* q = hlsl; (q = strstr(q, head)) != NULL && q < t; q++) best = q;
+        if (!best) return;
+        const char* e = best + strlen(head);
+        int row = atoi(e);
+        e = strstr(e, "]).xyzw)));");
+        if (!e || row < 0 || row >= 512) return;
+        e += strlen("]).xyzw)));");
+        while (e < t && (*e == ' ' || *e == '\r' || *e == '\n' || *e == '\t')) e++;
+        if (e != t) return;
+        if (lane) *rw = row; else *rx = row;
+    }
+}
