+/* RSX_SHADOW_SCALE=N (2..4; unset or 1 = off): depth-only passes render into
+ * a depth surface N times the guest's size on each axis, with their viewports
+ * scaled by N. Hot Shots Golf's shadow map is one such pass: a 3072x1024 atlas
+ * of three 1024 cascades side by side (ShadowMap_Create 0x8FAA78; the guest's
+ * 2048 cap overflows its atlas and VRAM pool). Its programs sample the map
+ * with normalized coordinates, and the compare helper takes its texel size
+ * from the bound texture (GetDimensions), so the lookups need no change: each
+ * cascade just has N*N times the texels. The guest's layout, memory and
+ * cascade math are untouched. RSX_SHADOW_LOG=1 logs the scaled surfaces and
+ * the first units that sample them. RSX_SHADOW_FROM_FLIP=F (a/b test) keeps
+ * the guest's size until guest flip F and scales from then on, so one run
+ * shows the same scene both ways. */
+static int shadow_scale_cfg(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("RSX_SHADOW_SCALE");
+        v = e ? atoi(e) : 1;
+        if (v < 1) v = 1;
+        if (v > 4) v = 4;
+        if (v > 1) fprintf(stderr, "[SHADOW] depth-only passes at %dx%c", v, 10);
+    }
+    return v;
+}
+static int s_shadow_k = 1;
+static unsigned long long s_shadow_k_frame = ~0ull;
+/* The scale in effect, fixed for each host frame (the RT pre-pass sizes the
+ * surface and the draws scale their viewports with the same value). */
+static int shadow_scale(void)
+{
+    const int k = shadow_scale_cfg();
+    if (k <= 1) return 1;
+    if (s_shadow_k_frame != (unsigned long long)s_d3d.frame_count) {
+        static long from = -2;
+        extern unsigned cellGcm_flip_request_count(void);
+        if (from == -2) { const char* e = getenv("RSX_SHADOW_FROM_FLIP"); from = e ? atol(e) : -1; }
+        s_shadow_k_frame = (unsigned long long)s_d3d.frame_count;
+        const int was = s_shadow_k;
+        s_shadow_k = (from < 0 || cellGcm_flip_request_count() >= (unsigned)from) ? k : 1;
+        if (s_shadow_k != was)
+            fprintf(stderr, "[SHADOW] scale %d from flip %u frame %llu%c", s_shadow_k,
+                    cellGcm_flip_request_count(), s_shadow_k_frame, 10);
+    }
+    return s_shadow_k;
+}
+static int shadow_log_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("RSX_SHADOW_LOG") ? 1 : 0;
+    return v;
+}
+static u32 s_shadow_zeta[8];
+static int s_shadow_nzeta;
+/* Was this depth offset sized by shadow_ds_dim (so it is N times the guest)? */
+static int shadow_zeta_scaled(u32 off)
+{
+    if (!off || shadow_scale() <= 1) return 0;
+    for (int i = 0; i < s_shadow_nzeta; i++) if (s_shadow_zeta[i] == off) return 1;
+    return 0;
+}
+/* The depth surface size the RT pre-pass asks for: the guest's, times N for
+ * a depth-only pass. */
+static u32 shadow_ds_dim(const D3D12DrawRecord* dr, u32 v)
+{
+    const int k = shadow_scale();
+    if (k <= 1 || !dr->no_color || !dr->zeta_off || !v) return v;
+    if (!shadow_zeta_scaled(dr->zeta_off) && s_shadow_nzeta < 8) {
+        s_shadow_zeta[s_shadow_nzeta++] = dr->zeta_off;
+        if (shadow_log_on())
+            fprintf(stderr, "[SHADOW] depth 0x%08X guest %ux%u -> %ux%u%c", dr->zeta_off,
+                    dr->rt_w, dr->rt_h, dr->rt_w * (u32)k, dr->rt_h * (u32)k, 10);
+    }
+    return shadow_zeta_scaled(dr->zeta_off) ? v * (u32)k : v;
+}
+/* A draw into a scaled depth surface: its guest viewport, in guest pixels,
+ * mapped to the surface's pixels. */
+static void shadow_scale_vp(int cur_nc, int cur_z, float* x, float* y, float* w, float* h)
+{
+    const int k = shadow_scale();
+    if (k <= 1 || !cur_nc || cur_z < 0 || cur_z >= MAX_OFF_DS ||
+        !shadow_zeta_scaled(s_d3d.off_ds[cur_z].off)) return;
+    *x *= (float)k; *y *= (float)k; *w *= (float)k; *h *= (float)k;
+}
+/* RSX_SHADOW_LOG=1: the first units that sample a scaled depth surface. */
+static void shadow_log_sample(const D3D12DrawRecord* dr, int u)
+{
+    static int n = 0;
+    if (!shadow_log_on() || n >= 8 || !shadow_zeta_scaled(dr->tex[u].raw)) return;
+    n++;
+    fprintf(stderr, "[SHADOW] fp=0x%08X unit %d samples 0x%08X %ux%u fmt=0x%02X filter=0x%08X"
+                    " addr=0x%08X ctrl0=0x%08X%c", dr->fp_addr, u, dr->tex[u].raw, dr->tex[u].w,
+            dr->tex[u].h, dr->tex[u].fmt, dr->tex[u].filter, dr->tex[u].addr, dr->tex[u].ctrl0, 10);
+}
