+/* RSX_SHADOW_PCF=1 (default off): compared lookups filter over a 3x3-texel
+ * box, bilinearly weighted (16 taps; weights 1-f, 1, 1, f per axis, sum 9),
+ * instead of the RSX's 2x2 bilinear compare. Softens the stair-stepped
+ * shadow edges a 2x2 compare leaves at 4K; pairs with RSX_SHADOW_SCALE,
+ * whose larger map keeps the 3-texel footprint near the guest's own. */
+static int fp_shadow_pcf_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_SHADOW_PCF"); v = (e && atoi(e) > 0) ? 1 : 0; }
+    return v;
+}
+static void fp_shadow_pcf_taps(Out* p, const char* tex, u32 unit, int need_size)
+{
+    char text[512];
+    if (!need_size) {
+        snprintf(text, sizeof text, "    uint width, height; %s.GetDimensions(width, height);\n"
+            "    float2 size = float2(width, height);\n", tex);
+        out_puts(p, text);
+    }
+    out_puts(p, "    float2 position = uv * size - 0.5;\n"
+        "    float2 base = floor(position); float2 fraction = position - base;\n"
+        "    float wx[4] = { 1.0 - fraction.x, 1.0, 1.0, fraction.x };\n"
+        "    float wy[4] = { 1.0 - fraction.y, 1.0, 1.0, fraction.y };\n"
+        "    float sum = 0.0;\n"
+        "    [unroll] for (int j = 0; j < 4; j++) {\n"
+        "        [unroll] for (int i = 0; i < 4; i++) {\n");
+    snprintf(text, sizeof text,
+        "            float depth = %s.SampleLevel(rsx_samp[%u], (base + float2(i - 0.5, j - 0.5)) / size, 0.0).r;\n"
+        "            sum += wx[i] * wy[j] * _rsx_shadow_cmp%u(reference, depth);\n"
+        "        }\n    }\n"
+        "    return (float4)(sum / 9.0);\n}\n", tex, unit, unit);
+    out_puts(p, text);
+}
